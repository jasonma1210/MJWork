new file mode 100644
index 0000000..ae80007
--- /dev/null
+++ b/desktop/main/router/rules.js
@@ -0,0 +1,196 @@
+'use strict';
+// 决策路由 L0/L1 规则层（P1-2，2026-10-23）
+//
+// 职责边界（与方案 §5.1 对齐）：
+//   L0 显式信号：用户手选模式 / 斜杠命令 / 选中模板 / 从团队工作室发起 → confidence=1，短路所有后续层；
+//   L1 规则词典：复用 intentMcpPrewarm 的能力词典与 teamDispatchPlan 的「对话型目标」判据，
+//               仅在高置信度的明显场景下给结论，判不出就返回 null 交给上层继续（远程 / 兜底）。
+//
+// 两条纪律：
+//   ① **纯函数、零网络、零副作用**——本模块不调模型、不读文件，便于单测与在子进程内复用；
+//   ② **宁可漏判，不可误判**——L1 返回 null 的代价只是多一次远程调用；误判的代价是执行模式被
+//      悄悄改掉（用户看到「自动拆解」把一句闲聊拆成 5 个任务）。因此所有 L1 规则的置信度都
+//      按「规则可信度」给定，且宽泛词（如「讨论」）一律不进词典。
+
+const { normalizeText, detectCapabilities } = require('../intentMcpPrewarm');
+const { isChatOnlyGoal } = require('../teamDispatchPlan');
+
+// ── L0：斜杠命令 → 模式（与方案 §5.1 的三个命令一致）──
+const SLASH_MODES = Object.freeze({
+  '/chat': 'chat',
+  '/flow': 'auto',
+  '/team': 'team',
+});
+
+// ── L1：团队类（多角色协商 / 评审 / 博弈）──
+// 只收「明确要多方意见」的词；「评审」单独出现也算（用户说「评审一下」通常就是要多视角），
+// 但「代码评审」（单助手 review diff）不该升团队——由反向排除词兜住。
+const TEAM_RULES = [
+  { id: 'team.review', re: /评审|论证|红队|多方意见|互相\s*(review|审|检查)|方案博弈|多角色/ },
+  { id: 'team.multiParty', re: /(产品|技术|设计|运营).{0,8}(和|与|、).{0,8}(产品|技术|设计|运营).{0,6}(意见|评审|讨论)/ },
+  { id: 'team.debate', re: /(辩论|博弈|各出(一份)?(意见|方案)|分歧意见)/ },
+];
+// 团队类反向排除：这些目标其实是单助手的一次代码动作，不该升团队
+const TEAM_DENY = /(diff|代码审查|单文件|跑一下|执行一下)/;
+
+// ── L1：自动拆解类（可拆成有依赖的步骤 / 明显并行）──
+const AUTO_RULES = [
+  { id: 'auto.parallel', re: /分别|并行|同时(进行|处理|调研)|多个模块|多个文件|批量处理/ },
+  { id: 'auto.sequence', re: /先.{0,24}再.{0,24}(最后|然后)/ },
+  { id: 'auto.research', re: /(调研|研究|分析|整理).{0,16}(并|再|然后).{0,8}(汇总|对比|合并|成(一|1)份)/ },
+  { id: 'auto.pipeline', re: /(拆成|分成).{0,6}(两|三|几|多|若干).{0,4}(步|部分|任务|阶段)/ },
+  { id: 'auto.multiFileScope', re: /(整个项目|全仓|全项目|多个页面|整套).{0,12}(重构|迁移|改造|升级)/ },
+];
+
+// （chat 类里用到的反向排除：出现这些动词就不算「简单问答」）
+const ACTION_VERBS = /(实现|开发|重构|部署|迁移|搭建|编写|创建|生成|修复|调试|安装|配置|上线)/;
+
+const CHAT_RULES = [
+  // 纯招呼 / 致谢：整句就是招呼语
+  {
+    id: 'chat.greeting',
+    test: (t) => /^(你好|您好|hi|hello|hey|嗨|在吗|谢谢|多谢|thanks|thank you|好的|ok|收到)[\s!！。.~～?？]*$/i.test(t),
+    confidence: 0.95,
+  },
+  // 单句短问：长度短、疑问语气、且不含动作动词
+  {
+    id: 'chat.shortQuestion',
+    test: (t) => t.length <= 30 && /[?？]|吗$|是什么|什么意思|怎么用|为什么|如何理解/.test(t) && !ACTION_VERBS.test(t),
+    confidence: 0.8,
+  },
+  // 翻译/解释一类的单步文本处理
+  {
+    id: 'chat.translate',
+    test: (t) => /(翻译|translate|改写|润色|总结一下|解释一下)/i.test(t) && t.length <= 200,
+    confidence: 0.82,
+  },
+  // 单个文件/函数的读写
+  {
+    id: 'chat.singleFile',
+    test: (t) => /(这个|该|一个|单个)\s*(文件|函数|方法|类|变量|脚本|接口)/.test(t) && t.length <= 120,
+    confidence: 0.72,
+  },
+];
+
+/** 文本是否命中任一「拆解类」规则（供 chat 规则做反向排除）。 */
+function hitsAuto(t) {
+  return AUTO_RULES.some((r) => r.re.test(t));
+}
+
+/** 文本是否命中任一「团队类」规则。 */
+function hitsTeam(t) {
+  return TEAM_RULES.some((r) => r.re.test(t));
+}
+
+/**
+ * L0 显式信号。
+ * @param {{text?: string, explicitMode?: string, templateId?: string, entry?: string}} input
+ * @returns {{mode: string, confidence: number, needClarify: boolean, reason: string, ruleId: string}|null}
+ */
+function decideL0({ text, explicitMode, templateId, entry } = {}) {
+  // ① 用户在页面上手选的模式：硬覆盖，不再路由
+  if (explicitMode === 'chat' || explicitMode === 'template' || explicitMode === 'auto' || explicitMode === 'team') {
+    return {
+      mode: explicitMode,
+      confidence: 1,
+      needClarify: false,
+      reason: '用户显式指定执行模式',
+      ruleId: 'l0.explicitMode',
+    };
+  }
+  // ② 斜杠命令（只认整段开头的命令，避免正文里的路径误命中）
+  const raw = String(text || '').trim();
+  for (const [cmd, mode] of Object.entries(SLASH_MODES)) {
+    if (raw.toLowerCase().startsWith(cmd)) {
+      return {
+        mode,
+        confidence: 1,
+        needClarify: false,
+        reason: `斜杠命令 ${cmd}`,
+        ruleId: 'l0.slash',
+      };
+    }
+  }
+  // ③ 选中了预设模板
+  if (typeof templateId === 'string' && templateId.trim() !== '') {
+    return {
+      mode: 'template',
+      confidence: 1,
+      needClarify: false,
+      reason: '用户选中了预设工作模板',
+      ruleId: 'l0.template',
+    };
+  }
+  // ④ 从团队工作室发起
+  if (entry === 'studio' || entry === 'team') {
+    return {
+      mode: 'team',
+      confidence: 0.95,
+      needClarify: false,
+      reason: '从团队工作室发起',
+      ruleId: 'l0.studio',
+    };
+  }
+  return null;
+}
+
+/**
+ * L1 规则词典。判不出返回 null（由远程 / 兜底层接手）。
+ * @param {{text?: string}} input
+ * @returns {{mode: string, confidence: number, needClarify: boolean, reason: string, ruleId: string}|null}
+ */
+function decideL1({ text } = {}) {
+  const t = normalizeText(text);
+  if (!t) return null;
+
+  // ① 对话型目标（「报数」「轮流说一句」）：确定性旁路，必须最先判
+  if (isChatOnlyGoal(t)) {
+    return { mode: 'chat', confidence: 0.9, needClarify: false, reason: '对话型目标，无需执行工具', ruleId: 'chatOnly' };
+  }
+
+  // ② 团队类
+  if (!TEAM_DENY.test(t)) {
+    const team = TEAM_RULES.find((r) => r.re.test(t));
+    if (team) {
+      return { mode: 'team', confidence: 0.82, needClarify: false, reason: `命中团队类规则 ${team.id}`, ruleId: team.id };
+    }
+  }
+
+  // ③ 自动拆解类
+  const auto = AUTO_RULES.find((r) => r.re.test(t));
+  if (auto) {
+    return { mode: 'auto', confidence: 0.78, needClarify: false, reason: `命中拆解类规则 ${auto.id}`, ruleId: auto.id };
+  }
+
+  // ④ 简单对话类（前面已排除拆解/团队，这里再反向排除一次以防规则顺序变动）
+  if (!hitsAuto(t) && !hitsTeam(t)) {
+    const chat = CHAT_RULES.find((r) => r.test(t));
+    if (chat) {
+      return { mode: 'chat', confidence: chat.confidence, needClarify: false, reason: `命中对话类规则 ${chat.id}`, ruleId: chat.id };
+    }
+  }
+
+  // ⑤ 能力词典兜底：命中 ≥3 个不同能力 → 多半是跨模块任务，值得拆
+  const caps = detectCapabilities(t);
+  if (caps.length >= 3) {
+    return {
+      mode: 'auto',
+      confidence: 0.62,
+      needClarify: false,
+      reason: `命中 ${caps.length} 个能力维度，疑似跨模块任务`,
+      ruleId: 'auto.multiCapability',
+    };
+  }
+
+  return null;
+}
+
+module.exports = {
+  decideL0,
+  decideL1,
+  // 供单测与上层解释性展示使用
+  SLASH_MODES,
+  TEAM_RULES,
+  AUTO_RULES,
+  CHAT_RULES,
+};
diff --git a/desktop/main/router/schema.js b/desktop/main/router/schema.js
new file mode 100644
index 0000000..2c22181
--- /dev/null
+++ b/desktop/main/router/schema.js
@@ -0,0 +1,218 @@
+'use strict';
+// 路由决策 Schema 校验与归一化（P1-1，2026-10-23）
+//
+// 输入可能来自三个完全不同的生产方：
+//   ① 规则层（L0/L1）：字段天然合法，但仍要过一遍归一化，保证下游只看到一套形状；
+//   ② 远程通用模型（§5.2-B）：可能带 markdown 围栏、多余字段、steps 超限、mode 拼错；
+//   ③ 兜底：连 JSON 都没有。
+// 因此本模块的职责是「**收敛形状，不判断业务对错**」：越界值一律纠正并记 errors，绝不抛错——
+// 路由失败不该把主任务打挂（方案 §5.7 的降级要求）。
+//
+// 与方案 §5.2 的差异：`task_brief / reason / steps` 是可选字段（最小必填集见 §5.2-A），
+// 因为本项目不走原生决策模型路径，规则层也不产出 steps；只有远程路径可能填。
+
+const MODES = ['chat', 'template', 'auto', 'team'];
+const BUDGET_CLASSES = ['low', 'medium', 'high'];
+const MAX_STEPS = 8; // 与 orchestrator/dag.js 的 MAX_TASKS 同源
+
+const LIMITS = {
+  taskBrief: 120,
+  reason: 160,
+  clarifyQuestion: 120,
+  templateId: 64,
+  stepTitle: 60,
+  stepAction: 300,
+  estTokens: 500000,
+};
+
+function clampConfidence(value) {
+  const n = Number(value);
+  if (!Number.isFinite(n)) return 0;
+  return Math.min(1, Math.max(0, n));
+}
+
+function text(value, max) {
+  if (typeof value !== 'string') return '';
+  return value.trim().slice(0, max);
+}
+
+/** 空决策（同时承担兜底返回体）。 */
+function emptyDecision(mode = 'chat') {
+  return {
+    mode,
+    confidence: 0,
+    task_brief: '',
+    reason: '',
+    need_clarify: false,
+    clarify_question: '',
+    template_id: '',
+    steps: [],
+    budget_hint: null,
+  };
+}
+
+/** 明确降级用的兜底决策：chat + 低置信度（下游据此走「直接执行」但不再升级）。 */
+function fallbackDecision(reason = '') {
+  const d = emptyDecision('chat');
+  d.confidence = 0.2;
+  d.reason = text(reason, LIMITS.reason);
+  return d;
+}
+
+/**
+ * 从模型原始输出里抠出 JSON 对象。
+ * 依次处理：对象直传 → markdown 围栏 → 首尾大括号切片。解析失败返回 null。
+ */
+function extractJsonObject(raw) {
+  if (raw && typeof raw === 'object' && !Array.isArray(raw)) return raw;
+  const s = String(raw == null ? '' : raw).trim();
+  if (!s) return null;
+  const fence = s.match(/```(?:json)?\s*([\s\S]*?)```/i);
+  const body = fence ? fence[1].trim() : s;
+  const start = body.indexOf('{');
+  const end = body.lastIndexOf('}');
+  if (start < 0 || end <= start) return null;
+  try {
+    const parsed = JSON.parse(body.slice(start, end + 1));
+    return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : null;
+  } catch {
+    return null;
+  }
+}
+
+/** steps 归一化：id 必须形如 s1..s8，依赖必须引用已存在的步骤。 */
+function normalizeSteps(rawSteps, errors) {
+  if (rawSteps == null) return [];
+  if (!Array.isArray(rawSteps)) {
+    errors.push('steps_not_array');
+    return [];
+  }
+  if (rawSteps.length > MAX_STEPS) {
+    errors.push('steps_too_many');
+    return [];
+  }
+  const accepted = [];
+  const ids = new Set();
+  rawSteps.forEach((raw, i) => {
+    if (!raw || typeof raw !== 'object' || Array.isArray(raw)) {
+      errors.push(`steps[${i}]_not_object`);
+      return;
+    }
+    const id = text(raw.id, 8) || `s${i + 1}`;
+    if (!/^s[1-8]$/.test(id)) {
+      errors.push(`steps[${i}]_bad_id`);
+      return;
+    }
+    if (ids.has(id)) {
+      errors.push(`steps[${i}]_duplicate_id`);
+      return;
+    }
+    ids.add(id);
+    accepted.push({
+      id,
+      title: text(raw.title, LIMITS.stepTitle),
+      action: text(raw.action, LIMITS.stepAction),
+      // 依赖先原样收下，等全部 id 收集完再过滤（否则前向引用会被误删）
+      depends_on: Array.isArray(raw.depends_on) ? raw.depends_on.map((v) => text(v, 8)).filter(Boolean).slice(0, MAX_STEPS) : [],
+    });
+  });
+  for (const step of accepted) {
+    const kept = step.depends_on.filter((d) => ids.has(d) && d !== step.id);
+    if (kept.length !== step.depends_on.length) errors.push(`steps_${step.id}_dep_unknown`);
+    step.depends_on = kept;
+  }
+  return accepted;
+}
+
+/** budget_hint 归一化：class 枚举 + est_tokens 整数范围。 */
+function normalizeBudget(raw, errors) {
+  if (raw == null) return null;
+  if (typeof raw !== 'object' || Array.isArray(raw)) {
+    errors.push('budget_not_object');
+    return null;
+  }
+  const cls = BUDGET_CLASSES.includes(raw.class) ? raw.class : null;
+  if (!cls) errors.push('budget_class_invalid');
+  const n = Number(raw.est_tokens);
+  if (!Number.isFinite(n)) errors.push('budget_est_tokens_invalid');
+  const est = Number.isFinite(n) ? Math.min(LIMITS.estTokens, Math.max(0, Math.round(n))) : 0;
+  return cls ? { class: cls, est_tokens: est } : null;
+}
+
+/**
+ * 归一化任意来源的决策对象。
+ * @param {object|string} raw
+ * @returns {{decision: object, errors: string[]}}
+ */
+function normalizeDecision(raw) {
+  const errors = [];
+  const obj = extractJsonObject(raw);
+  if (!obj) {
+    errors.push('json_invalid');
+    const d = emptyDecision('chat');
+    d.reason = '决策输出不是合法 JSON';
+    return { decision: d, errors };
+  }
+
+  const mode = MODES.includes(obj.mode) ? obj.mode : null;
+  if (!mode) errors.push('mode_invalid');
+
+  if (obj.confidence == null) errors.push('confidence_missing');
+  else if (!Number.isFinite(Number(obj.confidence))) errors.push('confidence_invalid');
+
+  if (obj.need_clarify != null && typeof obj.need_clarify !== 'boolean') errors.push('need_clarify_invalid');
+
+  const decision = {
+    // 非法 mode 一律按 chat 执行（方案 §5.7：不静默回落成别的模式），并保留 error 供审计区分
+    mode: mode || 'chat',
+    confidence: clampConfidence(obj.confidence),
+    task_brief: text(obj.task_brief, LIMITS.taskBrief),
+    reason: text(obj.reason, LIMITS.reason),
+    need_clarify: obj.need_clarify === true,
+    clarify_question: text(obj.clarify_question, LIMITS.clarifyQuestion),
+    template_id: text(obj.template_id, LIMITS.templateId),
+    steps: [],
+    budget_hint: normalizeBudget(obj.budget_hint, errors),
+  };
+
+  // steps 只对 auto 有意义；其它模式的步骤直接丢弃（不报错：这是模型的常见冗余，不是故障）
+  if (decision.mode === 'auto') {
+    decision.steps = normalizeSteps(obj.steps, errors);
+    // 超过 8 步不截断，改为 mode=auto 让 planGoal 重新拆（§5.2 的明确要求）。
+    // 注意：此处 mode 已经是 auto，清空 steps 即可，避免把执行不了的蓝图喂给 DAG。
+  }
+
+  if (decision.need_clarify && !decision.clarify_question) {
+    decision.clarify_question = '请补充这次任务的目标、范围或期望的输出格式。';
+  }
+
+  return { decision, errors };
+}
+
+/**
+ * 置信度策略（方案 §5.6）。
+ * @returns {{action: 'execute'|'suggest'|'clarify', reason: string}}
+ */
+function confidencePolicy(decision, params = {}) {
+  const threshold = Number.isFinite(Number(params.confidenceThreshold)) ? Number(params.confidenceThreshold) : 0.75;
+  const band = Array.isArray(params.clarifyBand) ? params.clarifyBand : [0.55, 0.75];
+  const low = Number.isFinite(Number(band[0])) ? Number(band[0]) : 0.55;
+  if (decision && decision.need_clarify) return { action: 'clarify', reason: 'need_clarify' };
+  const conf = clampConfidence(decision && decision.confidence);
+  if (conf >= threshold) return { action: 'execute', reason: 'high_confidence' };
+  if (conf >= low) return { action: 'suggest', reason: 'mid_confidence' };
+  return { action: 'clarify', reason: 'low_confidence' };
+}
+
+module.exports = {
+  MODES,
+  BUDGET_CLASSES,
+  MAX_STEPS,
+  LIMITS,
+  clampConfidence,
+  emptyDecision,
+  fallbackDecision,
+  extractJsonObject,
+  normalizeDecision,
+  confidencePolicy,
+};
diff --git a/desktop/main/workflowStore.js b/desktop/main/workflowStore.js
new file mode 100644
index 0000000..7f1a1ef
--- /dev/null
+++ b/desktop/main/workflowStore.js
@@ -0,0 +1,225 @@
+'use strict';
+// 模板实体（P2-1，2026-10-23）——「固定 DAG 骨架」的唯一写入入口。
+//
+// 为什么模板必须有实体而不是每次让模型拆解：执行模式分层把「按模板」定义为
+// **步骤可复现**：同一模板两次运行的任务清单、顺序、依赖完全一致。
+// 这个承诺只有一种实现方式——任务清单在保存时固化，运行时原样取出，不经过 LLM。
+//
+// 与 task_groups 的关系：运行一次只落 `task_groups.template_ref` 引用，不建外键。
+// 模板可删、历史 run 必须可读，两者都要（外键会让它们互斥）。
+//
+// 字段口径：
+//   tasks           与 presetTasks 同构（id/title/prompt/dependsOn/critical/maxRetry/timeoutMs），
+//                   校验复用 orchestrator/dag.js 的 validateDag（min=1：模板允许单步）。
+//   budget          三键成本信封（max_rounds / max_tokens / max_wall_ms），复用 teamStore 的
+//                   normalizeBudget，运行期写进 dag.runMeta.budget 由 groupBudget 执行。
+//   toolWhitelist   工具白名单；空数组 = 不限制（不是「全部禁用」——那会让模板半步都跑不动）。
+const crypto = require('crypto');
+const { validateDag, topoLevels, MAX_TASKS } = require('./orchestrator/dag');
+const { normalizeBudget } = require('./teamStore');
+
+const NAME_MAX = 80;
+const DESC_MAX = 500;
+const GOAL_MAX = 4000;
+const TOOL_NAME_MAX = 64;
+const TOOL_LIST_MAX = 64;
+
+function trimStr(v, max) {
+  return String(v == null ? '' : v).slice(0, max);
+}
+
+function safeParse(s, fallback) {
+  if (s == null || s === '') return fallback;
+  try {
+    const v = JSON.parse(s);
+    return v == null ? fallback : v;
+  } catch {
+    return fallback;
+  }
+}
+
+/** 工具白名单归一：去空、去重、长度收敛；空数组语义是「不限制」。 */
+function normalizeToolWhitelist(input) {
+  if (!Array.isArray(input)) return [];
+  const out = [];
+  const seen = new Set();
+  for (const raw of input.slice(0, TOOL_LIST_MAX)) {
+    const name = String(raw == null ? '' : raw).trim().slice(0, TOOL_NAME_MAX);
+    if (!name || seen.has(name)) continue;
+    seen.add(name);
+    out.push(name);
+  }
+  return out;
+}
+
+/**
+ * 任务清单归一（保存路径）。
+ * 复用 validateDag 的**全部**结构校验（字段必填、id 去重、依赖存在性、自依赖、环），
+ * 只把任务数下限放宽到 1——两条规则一份实现，避免模板校验与拆解校验漂移。
+ * @returns {{ok:true, tasks:object[]}|{ok:false, error:string}}
+ */
+function normalizeTasks(input) {
+  if (!Array.isArray(input) || input.length === 0) return { ok: false, error: '模板至少需要 1 个任务' };
+  const dag = validateDag({ tasks: input }, { min: 1 });
+  if (!dag.ok) return { ok: false, error: dag.error };
+  return { ok: true, tasks: dag.tasks };
+}
+
+function decorate(row) {
+  return {
+    templateId: row.template_id,
+    name: row.name,
+    description: row.description || '',
+    goal: row.goal || '',
+    tasks: safeParse(row.tasks_json, []),
+    budget: normalizeBudget(safeParse(row.budget_json, null)),
+    toolWhitelist: safeParse(row.tool_whitelist_json, []),
+    builtin: !!row.builtin,
+    createdAt: row.created_at,
+    updatedAt: row.updated_at,
+  };
+}
+
+class WorkflowStore {
+  constructor(db) {
+    this.db = db;
+  }
+
+  now() {
+    return Date.now();
+  }
+
+  /** 列表：内置模板在前（它们是开箱即用的推荐集），其余按创建时间倒序。 */
+  list() {
+    return this.db.prepare('SELECT * FROM workflow_templates ORDER BY builtin DESC, created_at DESC').all().map(decorate);
+  }
+
+  get(templateId) {
+    const id = String(templateId == null ? '' : templateId).trim();
+    if (!id) return null;
+    const row = this.db.prepare('SELECT * FROM workflow_templates WHERE template_id = ?').get(id);
+    return row ? decorate(row) : null;
+  }
+
+  /**
+   * 创建模板。返回 { ok, template?, error? }（IPC 层直接透传信封）。
+   * @param {{name:string, description?:string, goal?:string, tasks:object[], budget?:object, toolWhitelist?:string[]}} input
+   */
+  create(input = {}) {
+    const name = trimStr(input.name, NAME_MAX).trim();
+    if (!name) return { ok: false, error: '模板名称必填' };
+    const tasks = normalizeTasks(input.tasks);
+    if (!tasks.ok) return { ok: false, error: tasks.error };
+    const now = this.now();
+    const templateId = `wt-${now.toString(36)}-${crypto.randomBytes(3).toString('hex')}`;
+    const budget = normalizeBudget(input.budget) || null;
+    try {
+      this.db.prepare(`INSERT INTO workflow_templates
+        (template_id, name, description, goal, tasks_json, budget_json, tool_whitelist_json, builtin, created_at, updated_at)
+        VALUES (?, ?, ?, ?, ?, ?, ?, 0, ?, ?)`)
+        .run(
+          templateId, name, trimStr(input.description, DESC_MAX).trim(), trimStr(input.goal, GOAL_MAX).trim(),
+          JSON.stringify(tasks.tasks), budget ? JSON.stringify(budget) : null,
+          JSON.stringify(normalizeToolWhitelist(input.toolWhitelist)), now, now,
+        );
+    } catch (err) {
+      return { ok: false, error: String(err && err.message || err) };
+    }
+    return { ok: true, template: this.get(templateId) };
+  }
+
+  /**
+   * 更新模板（部分字段）。tasks 一旦提供就必须整份合法——不做「增量合并任务」，
+   * 那会让「两次运行步骤一致」依赖调用方每次都回传完整清单之外的另一套规则。
+   */
+  update(templateId, patch = {}) {
+    const current = this.get(templateId);
+    if (!current) return { ok: false, error: '模板不存在' };
+    const next = {
+      name: current.name,
+      description: current.description,
+      goal: current.goal,
+      tasks: current.tasks,
+      budget: current.budget,
+      toolWhitelist: current.toolWhitelist,
+    };
+    if (patch.name !== undefined) {
+      const name = trimStr(patch.name, NAME_MAX).trim();
+      if (!name) return { ok: false, error: '模板名称必填' };
+      next.name = name;
+    }
+    if (patch.description !== undefined) next.description = trimStr(patch.description, DESC_MAX).trim();
+    if (patch.goal !== undefined) next.goal = trimStr(patch.goal, GOAL_MAX).trim();
+    if (patch.tasks !== undefined) {
+      const tasks = normalizeTasks(patch.tasks);
+      if (!tasks.ok) return { ok: false, error: tasks.error };
+      next.tasks = tasks.tasks;
+    }
+    if (patch.budget !== undefined) next.budget = normalizeBudget(patch.budget);
+    if (patch.toolWhitelist !== undefined) next.toolWhitelist = normalizeToolWhitelist(patch.toolWhitelist);
+    try {
+      this.db.prepare(`UPDATE workflow_templates SET
+        name = ?, description = ?, goal = ?, tasks_json = ?, budget_json = ?, tool_whitelist_json = ?, updated_at = ?
+        WHERE template_id = ?`)
+        .run(
+          next.name, next.description, next.goal, JSON.stringify(next.tasks),
+          next.budget ? JSON.stringify(next.budget) : null, JSON.stringify(next.toolWhitelist), this.now(),
+          current.templateId,
+        );
+    } catch (err) {
+      return { ok: false, error: String(err && err.message || err) };
+    }
+    return { ok: true, template: this.get(current.templateId) };
+  }
+
+  /** 删除模板。历史 run 只存 template_ref 字符串，删除后仍可读（不级联、不改 task_groups）。 */
+  delete(templateId) {
+    const current = this.get(templateId);
+    if (!current) return { ok: false, error: '模板不存在' };
+    this.db.prepare('DELETE FROM workflow_templates WHERE template_id = ?').run(current.templateId);
+    return { ok: true, templateId: current.templateId };
+  }
+
+  /**
+   * 运行期取任务清单（presetTasks 的唯一来源）。
+   * 原样返回保存时的 id/顺序/依赖——不重排、不重编号、不调用模型。
+   * @returns {object[]|null} 模板不存在返回 null
+   */
+  presetTasksFor(templateId) {
+    const t = this.get(templateId);
+    return t ? t.tasks : null;
+  }
+
+  /**
+   * 预览（P2-4）：DAG 分层 + 每步负责人 + 预算 + 工具白名单。
+   * 「负责人」在模板模式下不是具体成员，而是执行者角色（单 Bot 编排 = 主 Agent），
+   * 故字段名用 ownerLabel 而不是 ownerMemberId，避免渲染层误当军团成员渲染。
+   */
+  preview(templateId) {
+    const t = this.get(templateId);
+    if (!t) return { ok: false, error: '模板不存在' };
+    const levels = topoLevels(t.tasks);
+    const byId = new Map(t.tasks.map((x) => [x.id, x]));
+    return {
+      ok: true,
+      template: t,
+      levels,
+      steps: t.tasks.map((x, i) => ({
+        index: i + 1,
+        id: x.id,
+        title: x.title,
+        prompt: x.prompt,
+        dependsOn: x.dependsOn || [],
+        critical: !!x.critical,
+        ownerLabel: '主 Agent',
+        level: levels.findIndex((l) => l.includes(x.id)),
+      })),
+      // 依赖完整性复查：保存时已校验，这里只是让预览页能直接展示「第几步等第几步」
+      dangling: t.tasks
+        .filter((x) => (x.dependsOn || []).some((d) => !byId.has(d)))
+        .map((x) => x.id),
+    };
+  }
+}
+
+module.exports = { WorkflowStore, normalizeTasks, normalizeToolWhitelist, MAX_TASKS };
diff --git a/desktop/renderer/src/components/ContextMenu.d.ts b/desktop/renderer/src/components/ContextMenu.d.ts
new file mode 100644
index 0000000..60eb1bb
--- /dev/null
+++ b/desktop/renderer/src/components/ContextMenu.d.ts
@@ -0,0 +1,27 @@
+// ContextMenu 的对外类型（2026-10-23 需求 5）
+//
+// 组件本体是 ContextMenu.jsx（历史原因保留 JSX）；从 TSX 调用时若没有声明文件，
+// `items = []` 会把入参推断成 never[]，任何菜单项都会报 TS2322。
+// 这里只声明对外契约，不改动组件实现。
+import type { ComponentType } from 'react';
+
+export interface ContextMenuItem {
+  id?: string;
+  label?: string;
+  icon?: ComponentType<{ size?: number }>;
+  disabled?: boolean;
+  danger?: boolean;
+  separator?: boolean;
+  title?: string;
+  onClick?: () => void;
+}
+
+declare const ContextMenu: ComponentType<{
+  open: boolean;
+  x?: number;
+  y?: number;
+  items?: ContextMenuItem[];
+  onClose?: () => void;
+}>;
+
+export default ContextMenu;
diff --git a/desktop/renderer/src/components/EngineModeBar.tsx b/desktop/renderer/src/components/EngineModeBar.tsx
new file mode 100644
index 0000000..fb0d0e9
--- /dev/null
+++ b/desktop/renderer/src/components/EngineModeBar.tsx
@@ -0,0 +1,135 @@
+// P2-3（2026-10-23）：输入框「编排方式」pill。
+//
+// 三态与语义（与 shared/engineMode.mjs 的模式语义一致）：
+//   auto     自动：保持既有行为——模型按任务规模判断是否拆解，出计划卡片等用户确认；
+//   chat     直接回答：不建组、不拆解（send 时带 skipDecompose）；
+//   template 按模板：取模板固化的任务清单建组执行，两次运行步骤完全一致。
+//
+// 「切换不改变历史 run」是硬约束：这里只改**下一次发送**的走向，不触碰任何已落库的任务组。
+// 「先看拆解，再执行」开关放在同一行：勾选后 auto 走 tasks:plan({dryRun:true}) 预览、
+// template 走 workflows:preview，确认后才建组（取消不建 run）。
+import { useEffect, useState } from 'react';
+import { useI18n } from '../i18n';
+import Button from './ui/Button';
+import Switch from './ui/Switch';
+import WorkflowTemplateModal from './WorkflowTemplateModal';
+
+export type EngineMode = 'auto' | 'chat' | 'template';
+
+export interface TemplateOption {
+  templateId: string;
+  name: string;
+}
+
+const MODES: { id: EngineMode; key: string; tipKey: string }[] = [
+  { id: 'auto', key: 'workflow.mode.auto', tipKey: 'workflow.modeTip.auto' },
+  { id: 'chat', key: 'workflow.mode.chat', tipKey: 'workflow.modeTip.chat' },
+  { id: 'template', key: 'workflow.mode.template', tipKey: 'workflow.modeTip.template' },
+];
+
+export interface EngineModeBarProps {
+  mode: EngineMode;
+  onModeChange?: (mode: EngineMode) => void;
+  templateId?: string | null;
+  onTemplateChange?: (templateId: string | null) => void;
+  previewBeforeRun?: boolean;
+  onPreviewChange?: (next: boolean) => void;
+  disabled?: boolean;
+  error?: string;
+}
+
+export default function EngineModeBar({
+  mode,
+  onModeChange,
+  templateId = null,
+  onTemplateChange,
+  previewBeforeRun = false,
+  onPreviewChange,
+  disabled = false,
+  error = '',
+}: EngineModeBarProps) {
+  const { t } = useI18n();
+  const [templates, setTemplates] = useState<TemplateOption[]>([]);
+  const [detailOpen, setDetailOpen] = useState(false);
+
+  // 模板列表：进入组件时拉一次（本地库，成本极低）；失败不阻塞发送——用户切回自动即可
+  useEffect(() => {
+    let cancelled = false;
+    (async () => {
+      try {
+        const r = (await window.mjcode?.workflowsList?.()) as
+          { ok?: boolean; templates?: TemplateOption[] } | undefined;
+        if (cancelled) return;
+        if (r?.ok && Array.isArray(r.templates)) setTemplates(r.templates);
+      } catch (err) {
+        console.warn('[workflow] template list failed:', err);
+      }
+    })();
+    return () => { cancelled = true; };
+  }, []);
+
+  // 模板态下必须始终有一个选中项：模板被删或首次切入时自动选第一个，
+  // 避免「显示按模板但发送时无模板」的静默失败（错误提示只在发送时出现，太晚）。
+  useEffect(() => {
+    if (mode !== 'template' || templates.length === 0) return;
+    if (!templateId || !templates.some((x) => x.templateId === templateId)) {
+      onTemplateChange?.(templates[0].templateId);
+    }
+  }, [mode, templates, templateId, onTemplateChange]);
+
+  return (
+    <div className="mb-2 flex items-center gap-2 flex-wrap">
+      <span className="shrink-0 text-caption text-text2">{t('workflow.modeLabel')}</span>
+      <div className="flex items-center gap-1" role="group" aria-label={t('workflow.modeLabel')}>
+        {MODES.map((m) => (
+          <Button
+            key={m.id}
+            size="xs"
+            variant={mode === m.id ? 'secondary' : 'ghost'}
+            className={mode === m.id ? 'text-text' : ''}
+            disabled={disabled}
+            aria-pressed={mode === m.id}
+            title={t(m.tipKey)}
+            onClick={() => onModeChange?.(m.id)}
+          >
+            {t(m.key)}
+          </Button>
+        ))}
+      </div>
+
+      {mode === 'template' && (
+        <>
+          <select
+            value={templateId || ''}
+            onChange={(e) => onTemplateChange?.(e.target.value || null)}
+            disabled={disabled || templates.length === 0}
+            className="h-6 rounded bg-surface border border-border px-1 text-xs text-text max-w-[180px]"
+            aria-label={t('workflow.templatePlaceholder')}
+          >
+            {templates.length === 0 && <option value="">{t('workflow.noTemplates')}</option>}
+            {templates.map((x) => (
+              <option key={x.templateId} value={x.templateId}>{x.name}</option>
+            ))}
+          </select>
+          <Button size="xs" variant="ghost" disabled={!templateId} onClick={() => setDetailOpen(true)}>
+            {t('workflow.detail')}
+          </Button>
+        </>
+      )}
+
+      <label className="ml-auto flex items-center gap-2 shrink-0" title={t('workflow.previewToggleTip')}>
+        <span className="text-caption text-text2">{t('workflow.previewToggle')}</span>
+        <Switch
+          checked={previewBeforeRun}
+          onChange={() => onPreviewChange?.(!previewBeforeRun)}
+          label={t('workflow.previewToggle')}
+          disabled={disabled}
+        />
+      </label>
+
+      {error && <p className="w-full text-caption text-danger">{error}</p>}
+
+      <WorkflowTemplateModal open={detailOpen} onClose={() => setDetailOpen(false)} templateId={templateId} />
+    </div>
+  );
+}
diff --git a/desktop/renderer/src/components/OrgModals.tsx b/desktop/renderer/src/components/OrgModals.tsx
new file mode 100644
index 0000000..7ff9318
