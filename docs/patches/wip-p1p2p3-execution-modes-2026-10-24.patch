index 0000000..7cd3ca0
--- /dev/null
+++ b/desktop/main/ipc/router.js
@@ -0,0 +1,189 @@
+'use strict';
+// 决策路由 IPC 域（P1-5，2026-10-23）
+//
+// 六条通道（方案 §9.2，去掉与 Python sidecar 绑定的 models:list / models:download）：
+//   router:config:get   读配置快照（脱敏，无密钥）
+//   router:config:set   写配置（**写通道**，已登记进 ipc-write-guard-coverage 的 GUARDED_CHANNELS）
+//   router:status       运行时状态（来源 / 是否可远程 / 缓存与日志条数）
+//   router:decide       显式路由（设置页「规则自测」与未来的输入框 pill 共用）
+//   router:logs         最近决策（调试面板）
+//   router:remote:test  远程连通性自测（发一条固定样例，返回原始输出 + 解析结果）
+//
+// 依赖注入（与其它 ipc/*.js 同款，避免装配顺序耦合）：
+//   audit        —— 每次决策 / 每次配置写入落一条审计（方案 P1-7）
+//   chatOnce     —— 非流式 OpenAI 兼容通道（main.js 的 scheduledAgentChat），远程路由复用同一条
+//   getProviders —— 可选，远程自测时用于展示「当前可用服务商」，拿不到不影响主流程
+const { ipcMain } = require('electron');
+const guard = require('./payloadGuard');
+const decisionConfig = require('../decisionConfig');
+const { createRouter } = require('../router/decide');
+const prompt = require('../router/prompt');
+const schema = require('../router/schema');
+
+const TEST_SAMPLE = '把三个竞品的定价策略分别调研并整理，最后汇总成一页对比表';
+
+/**
+ * @param {{audit?: Function, chatOnce?: Function, getProviders?: Function}} deps
+ */
+function initRouterIpc(deps = {}) {
+  const audit = typeof deps.audit === 'function' ? deps.audit : null;
+  const chatOnce = typeof deps.chatOnce === 'function' ? deps.chatOnce : null;
+  const getProviders = typeof deps.getProviders === 'function' ? deps.getProviders : null;
+
+  const router = createRouter({
+    getConfig: () => decisionConfig.readConfigSync().config,
+    remoteChat: chatOnce,
+    audit,
+  });
+
+  // ── 读：配置快照（含是否处于 v1 待迁移状态，设置页据此提示用户重新选择）──
+  ipcMain.handle('router:config:get', async () => {
+    const snap = decisionConfig.readConfigSync();
+    return {
+      ok: true,
+      config: snap.config,
+      errors: snap.errors,
+      legacy: snap.legacy,
+      needsMigration: snap.needsMigration,
+      exists: snap.exists,
+      filePath: snap.filePath,
+      providers: getProviders ? safeProviders(getProviders) : [],
+    };
+  });
+
+  // ── 写：配置（写通道）——先做载荷边界校验，再落盘；校验失败不写 ──
+  ipcMain.handle('router:config:set', async (_, payload) => {
+    try {
+      const p = guard.assertObject(payload, 'payload');
+      // 配置是嵌套对象，只校验顶层形状；枚举/范围由 decisionConfig.normalizeConfig 统一判定，
+      // 避免两处各写一套规则导致口径漂移。
+      guard.assertObject(p.config, 'config');
+      const res = decisionConfig.writeConfigSync(p.config);
+      if (audit) {
+        try {
+          audit('router.config:set', 'decision.json', {
+            ok: res.ok,
+            path: res.config ? res.config.path : '',
+            errors: res.errors || [],
+          }, res.ok ? 'auto' : 'failed');
+        } catch { /* 审计失败不阻塞写入结果返回 */ }
+      }
+      if (!res.ok) return { ok: false, errors: res.errors, filePath: res.filePath };
+      // 配置变了，缓存必须失效（否则旧模型的判定会继续命中 24h）
+      router.resetCache();
+      return { ok: true, errors: [], config: res.config, filePath: res.filePath };
+    } catch (e) {
+      return { ok: false, errors: [String(e && e.message || e)], filePath: decisionConfig.decisionFilePath() };
+    }
+  });
+
+  // ── 读：运行时状态 ──
+  ipcMain.handle('router:status', async () => {
+    const snap = decisionConfig.readConfigSync();
+    return {
+      ok: true,
+      ...router.status(),
+      needsMigration: snap.needsMigration,
+      configErrors: snap.errors,
+    };
+  });
+
+  // ── 读（计算型）：显式路由 ──
+  ipcMain.handle('router:decide', async (_, payload) => {
+    try {
+      const p = guard.assertObject(payload || {}, 'payload');
+      guard.assertStrings(p, { text: { max: 4000 } });
+      guard.assertArray(p, 'templateIds', { max: 20 });
+      const result = await router.decide({
+        text: p.text,
+        lastSummary: p.lastSummary,
+        pageMode: p.pageMode,
+        templateNames: p.templateNames,
+        templateIds: p.templateIds,
+        explicitMode: p.explicitMode,
+        templateId: p.templateId,
+        entry: p.entry,
+      });
+      return { ok: true, ...result };
+    } catch (e) {
+      return { ok: false, error: String(e && e.message || e) };
+    }
+  });
+
+  // ── 读：最近决策日志 ──
+  ipcMain.handle('router:logs', async (_, payload) => {
+    const limit = payload && Number(payload.limit);
+    return { ok: true, logs: router.recentDecisions(Number.isFinite(limit) ? limit : 20) };
+  });
+
+  // ── 远程连通性自测：发一条固定样例，返回原始输出 + 解析结果 ──
+  // 不写任何配置、不改缓存；失败如实返回原因（设置页用红色文案展示）。
+  ipcMain.handle('router:remote:test', async (_, payload) => {
+    const started = Date.now();
+    try {
+      const p = guard.assertObject(payload || {}, 'payload');
+      guard.assertIdLike(p, ['providerId']);
+      guard.assertStrings(p, {
+        modelId: 200,
+        baseUrl: { max: 500, optional: true, allowEmpty: true },
+        sample: { max: 2000, optional: true, allowEmpty: true },
+      });
+      if (!chatOnce) return { ok: false, error: 'REMOTE_CHANNEL_MISSING' };
+      if (!p.providerId || !p.modelId) return { ok: false, error: 'REMOTE_MODEL_MISSING' };
+
+      const timeoutMs = Math.min(30000, Math.max(1000, Number(p.timeoutMs) || 6000));
+      const controller = new AbortController();
+      const timer = setTimeout(() => controller.abort(), timeoutMs);
+      try {
+        const res = await chatOnce({
+          providerId: p.providerId,
+          model: p.modelId,
+          baseUrl: p.baseUrl || '',
+          messages: [
+            { role: 'system', content: prompt.ROUTER_SYSTEM_PROMPT },
+            {
+              role: 'user',
+              content: prompt.buildRouterUserMessage({ text: p.sample || TEST_SAMPLE, pageMode: 'chat' }),
+            },
+          ],
+          ...prompt.DECODE_PARAMS,
+        }, { signal: controller.signal });
+        if (res && res.aborted) {
+          return { ok: false, error: 'REMOTE_ABORTED', latencyMs: Date.now() - started };
+        }
+        const content = typeof res === 'string' ? res : (res && res.content) || '';
+        const normalized = schema.normalizeDecision(content);
+        return {
+          ok: !normalized.errors.includes('json_invalid'),
+          latencyMs: Date.now() - started,
+          content: content.slice(0, 2000),
+          decision: normalized.decision,
+          errors: normalized.errors,
+        };
+      } finally {
+        clearTimeout(timer);
+      }
+    } catch (e) {
+      return { ok: false, error: String(e && e.message || e), latencyMs: Date.now() - started };
+    }
+  });
+
+  return router;
+}
+
+/** 服务商列表只暴露设置页需要的三个字段（不透传任何凭证字段）。 */
+function safeProviders(fn) {
+  try {
+    const list = fn();
+    if (!Array.isArray(list)) return [];
+    return list.map((p) => ({
+      id: p && p.id,
+      name: (p && p.name) || '',
+      base_url: (p && p.base_url) || '',
+    }));
+  } catch {
+    return [];
+  }
+}
+
+module.exports = { initRouterIpc };
diff --git a/desktop/main/ipc/workflows.js b/desktop/main/ipc/workflows.js
new file mode 100644
index 0000000..d86839f
--- /dev/null
+++ b/desktop/main/ipc/workflows.js
@@ -0,0 +1,288 @@
+'use strict';
+// 模板实体 IPC 域（workflows:*，P2-1 / P2-2 / P2-5）
+//
+// 通道分工（写通道全部过 payloadGuard，并登记在 ipc-write-guard-coverage 的 GUARDED_CHANNELS）：
+//   workflows:list     读：模板列表
+//   workflows:get      读：单条模板
+//   workflows:create   写：创建模板
+//   workflows:update   写：部分更新模板
+//   workflows:delete   写：删除模板（不级联 task_groups —— 历史 run 必须可读）
+//   workflows:preview  读（计算型）：DAG 分层 / 每步 / 预算 / 工具白名单（P2-4 / P2-6 共用）
+//   workflows:run      写：按模板建组并后台执行（presetTasks 旁路，不经 LLM 拆解）
+//   workflows:runs     读：运行记录（按 engine_mode / template_ref 筛，带 token 与耗时，P2-5）
+//
+// 为什么 run 放在本模块而不是 tasks:*：模板运行 = 「取模板 → 建组 → 后台执行」，
+// 三步的输入契约（templateId）与 tasks:* 的输入契约（goal 自由文本）不同；
+// 若塞进 tasks:*，每个调用方都要自己先取模板再拼 presetTasks，等于把可复现性交给调用方。
+//
+// 依赖注入与其它 ipc/*.js 同款（initXxx(deps)），编排状态仍留在 main.js。
+const { ipcMain } = require('electron');
+const guard = require('./payloadGuard');
+const { hostPolicySnapshot } = require('../approvalPolicy');
+const { MAX_TASKS } = require('../workflowStore');
+const { ENGINE_MODES } = require('../../shared/engineMode.mjs');
+
+const TEMPLATE_ID_MAX = 128;
+const GOAL_MAX = 20000;
+const PATH_MAX = 1024;
+const RUN_LIMIT_MAX = 50;
+
+let deps = null;
+
+function unavailable() {
+  return { ok: false, error: '任务编排子系统不可用（初始化失败）' };
+}
+
+function clampLimit(v, fallback) {
+  const n = Math.trunc(Number(v));
+  if (!Number.isFinite(n) || n <= 0) return fallback;
+  return Math.min(RUN_LIMIT_MAX, n);
+}
+
+/** 运行记录投影：token 取任务结算用量（sub_tasks.result_json.tokensUsed），耗时取组创建→最后更新。 */
+function projectRun(taskStore, workflowStore, group, nameCache) {
+  const full = taskStore.getGroup(group.group_id) || group;
+  const tasks = Array.isArray(full.tasks) ? full.tasks : [];
+  let tokens = 0;
+  let done = 0;
+  let failed = 0;
+  for (const t of tasks) {
+    const n = Number(t && t.result && t.result.tokensUsed);
+    if (Number.isFinite(n) && n > 0) tokens += n;
+    if (t.status === 'done') done += 1;
+    else if (t.status === 'failed') failed += 1;
+  }
+  const createdAt = Number(full.created_at) || 0;
+  const updatedAt = Number(full.updated_at) || 0;
+  const templateRef = full.template_ref || null;
+  let templateName = null;
+  if (templateRef) {
+    if (!nameCache.has(templateRef)) nameCache.set(templateRef, workflowStore ? (workflowStore.get(templateRef) || {}).name || null : null);
+    templateName = nameCache.get(templateRef);
+  }
+  return {
+    groupId: full.group_id,
+    goal: full.goal,
+    engineMode: full.engine_mode || 'auto',
+    templateRef,
+    templateName,
+    status: full.status,
+    taskCount: tasks.length,
+    doneCount: done,
+    failedCount: failed,
+    tokens,
+    durationMs: Math.max(0, updatedAt - createdAt),
+    createdAt,
+    updatedAt,
+    error: full.error || null,
+  };
+}
+
+function register() {
+  ipcMain.handle('workflows:list', async () => {
+    const store = deps.getWorkflowStore();
+    if (!store) return unavailable();
+    try {
+      return { ok: true, templates: store.list() };
+    } catch (err) {
+      return { ok: false, error: String(err && err.message || err) };
+    }
+  });
+
+  ipcMain.handle('workflows:get', async (_, payload = {}) => {
+    const store = deps.getWorkflowStore();
+    if (!store) return unavailable();
+    try {
+      guard.assertStrings(payload, { templateId: TEMPLATE_ID_MAX });
+      const template = store.get(payload.templateId);
+      if (!template) return { ok: false, error: '模板不存在' };
+      return { ok: true, template };
+    } catch (err) {
+      return { ok: false, error: String(err && err.message || err) };
+    }
+  });
+
+  // ── 写：创建 ──
+  ipcMain.handle('workflows:create', async (_, payload = {}) => {
+    const store = deps.getWorkflowStore();
+    if (!store) return unavailable();
+    try {
+      guard.assertObject(payload, 'payload');
+      guard.assertStrings(payload, {
+        name: 80,
+        description: { max: 500, optional: true, allowEmpty: true },
+        goal: { max: 4000, optional: true, allowEmpty: true },
+      });
+      guard.assertArray(payload, 'tasks', { max: MAX_TASKS, min: 1 });
+      if (payload.toolWhitelist !== undefined) guard.assertArray(payload, 'toolWhitelist', { max: 64 });
+      if (payload.budget !== undefined && payload.budget !== null) guard.assertObject(payload.budget, 'budget');
+      return store.create({
+        name: payload.name,
+        description: payload.description,
+        goal: payload.goal,
+        tasks: payload.tasks,
+        budget: payload.budget,
+        toolWhitelist: payload.toolWhitelist,
+      });
+    } catch (err) {
+      return { ok: false, error: String(err && err.message || err) };
+    }
+  });
+
+  // ── 写：更新（部分字段；tasks 一旦提供必须整份合法）──
+  ipcMain.handle('workflows:update', async (_, payload = {}) => {
+    const store = deps.getWorkflowStore();
+    if (!store) return unavailable();
+    try {
+      guard.assertObject(payload, 'payload');
+      guard.assertStrings(payload, {
+        templateId: TEMPLATE_ID_MAX,
+        name: { max: 80, optional: true },
+        description: { max: 500, optional: true, allowEmpty: true },
+        goal: { max: 4000, optional: true, allowEmpty: true },
+      });
+      if (payload.tasks !== undefined) guard.assertArray(payload, 'tasks', { max: MAX_TASKS, min: 1 });
+      if (payload.toolWhitelist !== undefined) guard.assertArray(payload, 'toolWhitelist', { max: 64 });
+      if (payload.budget !== undefined && payload.budget !== null) guard.assertObject(payload.budget, 'budget');
+      const patch = {};
+      for (const key of ['name', 'description', 'goal', 'tasks', 'budget', 'toolWhitelist']) {
+        if (payload[key] !== undefined) patch[key] = payload[key];
+      }
+      return store.update(payload.templateId, patch);
+    } catch (err) {
+      return { ok: false, error: String(err && err.message || err) };
+    }
+  });
+
+  // ── 写：删除 ──
+  ipcMain.handle('workflows:delete', async (_, payload = {}) => {
+    const store = deps.getWorkflowStore();
+    if (!store) return unavailable();
+    try {
+      guard.assertStrings(payload, { templateId: TEMPLATE_ID_MAX });
+      return store.delete(payload.templateId);
+    } catch (err) {
+      return { ok: false, error: String(err && err.message || err) };
+    }
+  });
+
+  // ── 读（计算型）：预览（P2-4 详情弹层 / P2-6「先看拆解」共用同一份投影）──
+  ipcMain.handle('workflows:preview', async (_, payload = {}) => {
+    const store = deps.getWorkflowStore();
+    if (!store) return unavailable();
+    try {
+      guard.assertStrings(payload, { templateId: TEMPLATE_ID_MAX });
+      return store.preview(payload.templateId);
+    } catch (err) {
+      return { ok: false, error: String(err && err.message || err) };
+    }
+  });
+
+  // ── 写：按模板运行 ──
+  // 流程：取模板（不存在则拒绝）→ presetTasks 建组（engineMode=template + templateRef）
+  //   → 后台执行（不 await，与 teams:dispatch 同型：调用方立即拿回 groupId，进度走 tasks:event）。
+  ipcMain.handle('workflows:run', async (_, payload = {}) => {
+    const store = deps.getWorkflowStore();
+    const taskStore = deps.getTaskStore();
+    if (!store || !taskStore) return unavailable();
+    if (!deps.orchestrator || !deps.workerPool) return unavailable();
+    try {
+      guard.assertObject(payload, 'payload');
+      guard.assertStrings(payload, {
+        templateId: TEMPLATE_ID_MAX,
+        goal: { max: GOAL_MAX, optional: true, allowEmpty: true },
+        cwd: { max: PATH_MAX, optional: true, allowEmpty: true },
+        projectPath: { max: PATH_MAX, optional: true, allowEmpty: true },
+        threadId: { max: 200, optional: true, allowEmpty: true },
+      });
+      const template = store.get(payload.templateId);
+      if (!template) return { ok: false, code: 'TEMPLATE_NOT_FOUND', error: '模板不存在' };
+      const presetTasks = store.presetTasksFor(template.templateId);
+      if (!Array.isArray(presetTasks) || presetTasks.length === 0) {
+        return { ok: false, code: 'TEMPLATE_EMPTY', error: '模板没有任务' };
+      }
+      const goal = String(payload.goal || '').trim() || template.goal || template.name;
+      const cwd = String(payload.cwd || payload.projectPath || '').trim();
+      const projectPath = String(payload.projectPath || '').trim();
+      const plan = await deps.orchestrator.planGoal({
+        goal,
+        cwd,
+        projectPath,
+        threadId: payload.threadId || null,
+        engineMode: 'template',
+        templateRef: template.templateId,
+        presetTasks,
+        // 预算写进 dag.runMeta.budget，由 groupBudget 在运行期执行（token 软告警 / 墙钟硬闸）
+        ...(template.budget ? { runMeta: { budget: template.budget } } : {}),
+        ...hostPolicySnapshot(cwd, deps.getApprovalMode()),
+      });
+      if (!plan.ok) return { ok: false, code: 'PLAN_FAILED', error: plan.error || '建组失败' };
+      Promise.resolve(deps.workerPool.runGroup(plan.groupId)).catch((e) => {
+        console.warn('[workflows] 模板运行失败:', e?.message || e);
+        deps.emitTaskEvent?.({ type: 'group_update', groupId: plan.groupId, status: 'failed', error: String(e?.message || e) });
+      });
+      return {
+        ok: true,
+        groupId: plan.groupId,
+        templateId: template.templateId,
+        templateName: template.name,
+        tasks: Array.isArray(plan.tasks) ? plan.tasks.length : presetTasks.length,
+        goal,
+      };
+    } catch (err) {
+      return { ok: false, error: String(err && err.message || err) };
+    }
+  });
+
+  // ── 读：运行记录（P2-5）──
+  // 数据源单一：task_groups（engine_mode / template_ref 是落库列，不从 dag 猜）。
+  // 会话内传 threadId 时按会话归属列（与对话页卡片同源）；不传则列全局最近。
+  ipcMain.handle('workflows:runs', async (_, payload = {}) => {
+    const taskStore = deps.getTaskStore();
+    if (!taskStore) return { ok: false, error: '不可用', runs: [] };
+    try {
+      const p = guard.assertObject(payload || {}, 'payload');
+      guard.assertStrings(p, {
+        threadId: { max: 200, optional: true, allowEmpty: true },
+        templateRef: { max: TEMPLATE_ID_MAX, optional: true, allowEmpty: true },
+      });
+      if (p.engineMode !== undefined && p.engineMode !== null && p.engineMode !== '') {
+        guard.assertEnum(p, 'engineMode', ENGINE_MODES);
+      }
+      const limit = clampLimit(p.limit, 20);
+      const threadId = String(p.threadId || '').trim();
+      const engineMode = String(p.engineMode || '').trim();
+      const templateRef = String(p.templateRef || '').trim();
+      const groups = threadId
+        ? taskStore.listGroupsByThread(threadId, { limit: RUN_LIMIT_MAX })
+        : taskStore.listGroups({ limit: RUN_LIMIT_MAX });
+      const store = deps.getWorkflowStore();
+      const nameCache = new Map();
+      const runs = groups
+        .filter((g) => (!engineMode || (g.engine_mode || 'auto') === engineMode)
+          && (!templateRef || g.template_ref === templateRef))
+        .slice(0, limit)
+        .map((g) => projectRun(taskStore, store, g, nameCache));
+      return { ok: true, runs };
+    } catch (err) {
+      return { ok: false, error: String(err && err.message || err), runs: [] };
+    }
+  });
+}
+
+/**
+ * @param {{
+ *   getWorkflowStore: () => any,
+ *   getTaskStore: () => any,
+ *   getApprovalMode: () => string,
+ *   orchestrator: any,
+ *   workerPool: any,
+ *   emitTaskEvent?: Function,
+ * }} initDeps
+ */
+function initWorkflowsIpc(initDeps = {}) {
+  deps = initDeps;
+  register();
+}
+
+module.exports = { initWorkflowsIpc };
diff --git a/desktop/main/router/decide.js b/desktop/main/router/decide.js
new file mode 100644
index 0000000..9eca5a9
--- /dev/null
+++ b/desktop/main/router/decide.js
@@ -0,0 +1,250 @@
+'use strict';
+// 决策路由编排（P1-1，2026-10-23）：L0 → 缓存 → L1 → 远程 → 兜底。
+//
+// 与方案 §5.1 的对照：本项目**不实现 L2 本地决策模型**（不做 Python sidecar，项目硬约束），
+// 因此链路是「L0 显式信号 → L1 离线规则 → L3 远程（可选）→ L4 兜底 chat」。
+//
+// 三条实现纪律：
+//   ① 每次决策都返回同一种结果信封 `{ decision, source, latencyMs, degraded, note, errors, policy }`，
+//      调用方（IPC / 未来的输入框 pill）不需要知道走了哪条路，但能从 source 如实展示；
+//   ② 所有失败都**降级而不抛错**：远程超时 / 格式非法 / 未配置 → 回落到规则结果或 chat，
+//      并把原因写进 note，避免「路由挂了但用户不知道」（方案 §5.7 的硬要求）；
+//   ③ 单例状态（缓存 + 最近决策环形缓冲）封在工厂里，便于单测各自 new 一个，互不污染。
+
+const crypto = require('crypto');
+const rules = require('./rules');
+const schema = require('./schema');
+const prompt = require('./prompt');
+
+const RECENT_MAX = 50;
+const DEFAULT_TIMEOUT_MS = 6000;
+
+function normalizeForCache(value) {
+  return String(value == null ? '' : value).toLowerCase().replace(/\s+/g, ' ').trim();
+}
+
+function nowMs() {
+  return Date.now();
+}
+
+/**
+ * 创建路由实例。
+ * @param {{
+ *   getConfig: () => object,
+ *   remoteChat?: (payload: object, opts: object) => Promise<any>,
+ *   audit?: (action: string, target: string, detail: object, result?: string) => void,
+ * }} deps
+ */
+function createRouter(deps = {}) {
+  const getConfig = typeof deps.getConfig === 'function' ? deps.getConfig : () => ({});
+  const remoteChat = typeof deps.remoteChat === 'function' ? deps.remoteChat : null;
+  const audit = typeof deps.audit === 'function' ? deps.audit : null;
+
+  /** 远程决策缓存：key = sha256(输入 + 摘要 + 页面模式 + 模型版本) */
+  const cache = new Map();
+  /** 最近决策（环形缓冲，最多 50 条；只存输入前 120 字，不存全文——方案 §6.5） */
+  const recent = [];
+
+  function record(result, input) {
+    recent.push({
+      at: nowMs(),
+      textBrief: String(input && input.text || '').slice(0, 120),
+      mode: result.decision.mode,
+      confidence: result.decision.confidence,
+      needClarify: result.decision.need_clarify === true,
+      source: result.source,
+      latencyMs: result.latencyMs,
+      degraded: result.degraded === true,
+      note: result.note || '',
+    });
+    if (recent.length > RECENT_MAX) recent.splice(0, recent.length - RECENT_MAX);
+  }
+
+  function auditDecision(result) {
+    if (!audit) return;
+    try {
+      audit('router.decide', 'router', {
+        source: result.source,
+        mode: result.decision.mode,
+        confidence: result.decision.confidence,
+        need_clarify: result.decision.need_clarify === true,
+        latency_ms: result.latencyMs,
+        degraded: result.degraded === true,
+        note: result.note || '',
+        errors: result.errors || [],
+      }, result.degraded ? 'degraded' : 'auto');
+    } catch {
+      // 审计失败不阻塞路由（fail-open，与既有记忆归档口径一致）
+    }
+  }
+
+  function cacheKeyOf(input, config) {
+    const modelVersion = String(config && config.remote && config.remote.modelId || '');
+    const raw = [
+      normalizeForCache(input.text),
+      normalizeForCache(input.lastSummary),
+      normalizeForCache(input.pageMode || 'chat'),
+      modelVersion,
+    ].join('\u0000');
+    return crypto.createHash('sha256').update(raw).digest('hex');
+  }
+
+  function cacheGet(key, ttlSec) {
+    const hit = cache.get(key);
+    if (!hit) return null;
+    if (ttlSec > 0 && nowMs() - hit.at > ttlSec * 1000) {
+      cache.delete(key);
+      return null;
+    }
+    return hit;
+  }
+
+  function cachePut(key, decision, maxEntries) {
+    cache.set(key, { at: nowMs(), decision });
+    // 简易 LRU：超出上限时删最早插入的一条（Map 保证插入序）
+    const cap = Number.isFinite(Number(maxEntries)) && Number(maxEntries) > 0 ? Number(maxEntries) : 500;
+    while (cache.size > cap) {
+      const oldest = cache.keys().next().value;
+      cache.delete(oldest);
+    }
+  }
+
+  function remoteReady(config) {
+    const remote = config && config.remote;
+    return !!(remoteChat && remote && remote.providerId && remote.modelId);
+  }
+
+  /** 调远程：超时 6s（可配），JSON 非法 / mode 非法一律降级，不重试（§5.7）。 */
+  async function callRemote(input, config) {
+    const remote = config.remote || {};
+    const timeoutMs = Math.min(30000, Math.max(1000, Number(remote.timeoutMs) || DEFAULT_TIMEOUT_MS));
+    const controller = new AbortController();
+    const timer = setTimeout(() => controller.abort(), timeoutMs);
+    try {
+      const res = await remoteChat({
+        providerId: remote.providerId,
+        model: remote.modelId,
+        baseUrl: remote.baseUrl || '',
+        messages: [
+          { role: 'system', content: prompt.ROUTER_SYSTEM_PROMPT },
+          { role: 'user', content: prompt.buildRouterUserMessage(input) },
+        ],
+        ...prompt.DECODE_PARAMS,
+      }, { signal: controller.signal });
+      if (res && res.aborted) throw Object.assign(new Error('REMOTE_ABORTED'), { code: 'ABORTED' });
+      const content = typeof res === 'string' ? res : (res && res.content) || '';
+      return schema.normalizeDecision(content);
+    } finally {
+      clearTimeout(timer);
+    }
+  }
+
+  /**
+   * 执行一次路由决策。
+   * @param {{text?: string, lastSummary?: string, pageMode?: string, templateNames?: string[],
+   *          explicitMode?: string, templateId?: string, entry?: string}} input
+   * @returns {Promise<object>} 结果信封
+   */
+  async function decide(input = {}) {
+    const started = nowMs();
+    const config = getConfig() || {};
+
+    const finish = (decision, source, extra = {}) => {
+      const result = {
+        decision,
+        source,
+        latencyMs: nowMs() - started,
+        degraded: extra.degraded === true,
+        note: extra.note || '',
+        errors: extra.errors || [],
+        policy: schema.confidencePolicy(decision, config.params || {}),
+      };
+      record(result, input);
+      auditDecision(result);
+      return result;
+    };
+
+    // 全局关闭 → 直接 chat（不产生任何远程调用）
+    if (config.enabled === false) {
+      const d = schema.fallbackDecision('决策路由已关闭');
+      return finish(d, 'disabled', { note: 'router_disabled' });
+    }
+
+    // L0：显式信号，confidence=1，硬覆盖
+    const l0 = rules.decideL0(input);
+    if (l0) {
+      const { decision } = schema.normalizeDecision({
+        mode: l0.mode,
+        confidence: l0.confidence,
+        need_clarify: l0.needClarify === true,
+        reason: l0.reason,
+      });
+      return finish(decision, 'l0', { note: l0.ruleId });
+    }
+
+    // L1：离线规则
+    const l1 = rules.decideL1(input);
+    if (l1) {
+      const { decision } = schema.normalizeDecision({
+        mode: l1.mode,
+        confidence: l1.confidence,
+        need_clarify: l1.needClarify === true,
+        reason: l1.reason,
+      });
+      return finish(decision, 'l1', { note: l1.ruleId });
+    }
+
+    // 远程（仅当用户把来源选成 remote 且配置完整）
+    if (config.path === 'remote' && remoteReady(config)) {
+      const ttlSec = Number(config.cache && config.cache.ttlSec) || 0;
+      const maxEntries = config.cache && config.cache.maxEntries;
+      const key = cacheKeyOf(input, config);
+      const cached = cacheGet(key, ttlSec);
+      if (cached) return finish(cached.decision, 'cache', { note: 'cache_hit' });
+
+      try {
+        const { decision, errors } = await callRemote(input, config);
+        const fatal = errors.includes('json_invalid') || errors.includes('mode_invalid');
+        if (fatal) {
+          // 非法输出按 chat 执行并记 router_invalid（不做重试：生成式重试一次已足够，本层不再放大延迟）
+          const chat = schema.fallbackDecision('远程决策输出非法，已按对话模式执行');
+          return finish(chat, 'fallback', { degraded: true, note: 'router_invalid', errors });
+        }
+        cachePut(key, decision, maxEntries);
+        return finish(decision, 'remote', { errors });
+      } catch (err) {
+        const code = (err && err.code) || '';
+        const note = code === 'ABORTED' ? 'remote_timeout' : 'remote_error';
+        // 远程不可用 → 回落规则层。规则层此处已判不出，按 chat 兜底（§5.7）
+        const chat = schema.fallbackDecision('远程决策不可用，已按对话模式执行');
+        return finish(chat, 'fallback', { degraded: true, note: `${note}:${String((err && err.message) || err).slice(0, 120)}` });
+      }
+    }
+
+    // L4：兜底 chat（最轻、不会爆 token）
+    return finish(schema.fallbackDecision('无规则命中，按对话模式执行'), 'fallback', { note: 'no_rule_hit' });
+  }
+
+  return {
+    decide,
+    /** 设置页 / 调试面板用的运行时状态（不含任何密钥） */
+    status() {
+      const config = getConfig() || {};
+      return {
+        enabled: config.enabled !== false,
+        path: config.path === 'remote' ? 'remote' : 'rules',
+        remoteConfigured: remoteReady(config),
+        cacheEntries: cache.size,
+        recentCount: recent.length,
+      };
+    },
+    recentDecisions(limit = 20) {
+      const n = Math.min(RECENT_MAX, Math.max(1, Number(limit) || 20));
+      return recent.slice(-n);
+    },
+    resetCache() { cache.clear(); },
+    resetLog() { recent.length = 0; },
+  };
+}
+
+module.exports = { createRouter, RECENT_MAX, DEFAULT_TIMEOUT_MS };
