new file mode 100644
index 0000000..1ffa740
--- /dev/null
+++ b/desktop/shared/routeHint.mjs
@@ -0,0 +1,129 @@
+// 决策路由 → 输入框 pill 提示的纯映射（P3，2026-10-23）
+//
+// 为什么单独成文件：`router:decide` 的信封（decision / policy / source / degraded）要在
+// 渲染层变成一条**可展示、可一键改判**的提示，而这段映射必须能被 Node 单测直接 import
+// （渲染层依赖 React 与 window.mjcode，测不了）。与 `shared/engineMode.mjs` 同款：
+// 零依赖、零副作用，主进程 / 渲染层 / 测试共用一份，口径不会漂。
+//
+// 三条纪律：
+//   ① **不改写用户的显式选择**：这里只产出「建议」，落不落地由用户点「改用 X」决定；
+//   ② **降级不出建议**：source=fallback / disabled、degraded=true 的信封里 mode 恒为 chat
+//      且 confidence=0.2，把它当建议展开展示等于让路由故障替用户改档位；
+//   ③ **只建议 pill 表达得出的档位**：`team` 在对话页没有对应 pill（团队由军团选择承载），
+//      因此 team 决策不产出可采纳提示，返回 null 而不是给一个点不动的按钮。
+
+/** 决策层可能产出的模式（与 main/router/schema.js 的 MODES 同源） */
+export const ROUTE_MODES = Object.freeze(['chat', 'template', 'auto', 'team']);
+/** 输入框 pill 能表达的档位（team 不在此列，见文件头纪律③） */
+export const PILL_MODES = Object.freeze(['auto', 'chat', 'template']);
+export const HINT_ACTIONS = Object.freeze(['execute', 'suggest', 'clarify']);
+
+/** 置信度策略缺省（与 main/router/schema.js 的 confidencePolicy 同口径，仅作本地兜底） */
+const DEFAULT_THRESHOLD = 0.75;
+const DEFAULT_BAND_LOW = 0.55;
+/** 太短的草稿（如「你好」）不做路由提示：一次本地推理换不来有效建议 */
+export const MIN_HINT_CHARS = 6;
+
+function clamp01(v) {
+  const n = Number(v);
+  if (!Number.isFinite(n)) return 0;
+  return Math.min(1, Math.max(0, n));
+}
+
+/** 合法模式原样返回；非法/缺失返回空串（**不**回落 chat，免得把坏数据演成建议） */
+export function normalizeHintMode(v) {
+  const s = String(v == null ? '' : v).trim();
+  return ROUTE_MODES.includes(s) ? s : '';
+}
+
+/**
+ * 置信度 → 动作（仅在信封里没有 policy 时兜底；正常路径一律用主进程算好的 policy）。
+ * @param {number} confidence
+ * @param {{confidenceThreshold?: number, clarifyBand?: number[]}} params
+ */
+export function actionFromConfidence(confidence, params = {}) {
+  const threshold = Number.isFinite(Number(params.confidenceThreshold)) ? Number(params.confidenceThreshold) : DEFAULT_THRESHOLD;
+  const band = Array.isArray(params.clarifyBand) ? params.clarifyBand : [];
+  const low = Number.isFinite(Number(band[0])) ? Number(band[0]) : DEFAULT_BAND_LOW;
+  const conf = clamp01(confidence);
+  if (conf >= threshold) return 'execute';
+  if (conf >= low) return 'suggest';
+  return 'clarify';
+}
+
+/**
+ * 把 router:decide 的信封映射成 pill 提示。
+ *
+ * @param {object|null} result router:decide 的返回（{ok, decision, policy, source, degraded, errors}）
+ * @param {string} currentMode 当前 pill 档位（auto / chat / template）
+ * @returns {null | {
+ *   kind: 'suggest'|'clarify', mode: string, targetMode: string, action: string,
+ *   confidence: number, source: string, reason: string, question: string,
+ *   canAdopt: boolean, differs: boolean, brief: string
+ * }}
+ */
+export function buildRouteHint(result, currentMode = 'auto') {
+  if (!result || typeof result !== 'object') return null;
+  if (result.ok === false || !result.decision) return null;
+  // 纪律②：降级 / 关闭路由此类信封不构成建议
+  if (result.degraded === true) return null;
+  const source = String(result.source || '');
+  if (source === 'disabled' || source === 'fallback') return null;
+
+  const mode = normalizeHintMode(result.decision.mode);
+  if (!mode) return null;
+  const targetMode = PILL_MODES.includes(mode) ? mode : '';
+  // 纪律③：pill 表达不出的档位（team）不产出提示
+  if (!targetMode) return null;
+
+  const confidence = clamp01(result.decision.confidence);
+  const policy = result.policy && HINT_ACTIONS.includes(result.policy.action) ? result.policy : null;
+  const action = policy ? policy.action : actionFromConfidence(confidence);
+  const question = String(result.decision.clarify_question || '').trim();
+  const differs = targetMode !== String(currentMode == null ? '' : currentMode).trim();
+
+  // clarify 优先：问题本身就是用户下一步要补的东西，比「换个档位」更急
+  if (action === 'clarify' && question) {
+    return {
+      kind: 'clarify',
+      mode,
+      targetMode,
+      action,
+      confidence,
+      source,
+      reason: String(result.decision.reason || '').trim(),
+      question,
+      canAdopt: differs,
+      differs,
+      brief: String(result.decision.task_brief || '').trim(),
+    };
+  }
+  // execute / suggest / 无问题的 clarify：只有「档位不同」才值得打扰用户
+  if (!differs) return null;
+  return {
+    kind: 'suggest',
+    mode,
+    targetMode,
+    action,
+    confidence,
+    source,
+    reason: String(result.decision.reason || '').trim(),
+    question: '',
+    canAdopt: true,
+    differs: true,
+    brief: String(result.decision.task_brief || '').trim(),
+  };
+}
+
+/** 草稿是否值得发起一次路由探测（空串/纯符号/过短都跳过） */
+export function shouldProbe(text) {
+  const s = String(text == null ? '' : text).trim();
+  if (s.length < MIN_HINT_CHARS) return false;
+  // 纯符号 / 纯标点没有语义，探测只会白烧一次本地推理
+  return /[\p{L}\p{N}]/u.test(s);
+}
+
+/** 置信度的展示口径：0.92 → 92（四舍五入到整数百分比） */
+export function confidencePercent(confidence) {
+  return Math.round(clamp01(confidence) * 100);
+}
diff --git a/desktop/test/decision-config.test.mjs b/desktop/test/decision-config.test.mjs
new file mode 100644
index 0000000..414e77c
--- /dev/null
+++ b/desktop/test/decision-config.test.mjs
@@ -0,0 +1,133 @@
+// P1-4：决策路由配置持久化（~/.mjcode/decision.json，v2）
+//
+// 重点验收方案 §6.4 的三条硬要求：
+//   ① v1 → v2 **不静默升级**（读到 v1 只标记 needsMigration，文件原样保留）；
+//   ② 非法枚举/范围一律收敛并记 errors，写通道校验失败时**不落盘**；
+//   ③ 落盘是原子写且权限 0600（文件里虽无密钥，但仍是用户私配）。
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import decisionConfig from '../main/decisionConfig.js';
+
+const { readConfigSync, writeConfigSync, normalizeConfig, decisionFilePath, DEFAULTS } = decisionConfig;
+
+let pass = 0;
+let total = 0;
+function check(name, fn) {
+  total++;
+  try { fn(); console.log(`[PASS] ${name}`); pass++; }
+  catch (e) { console.error(`[FAIL] ${name} — ${e.message}`); process.exitCode = 1; }
+}
+
+const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'mjcode-decision-'));
+process.env.MJCODE_DECISION_FILE = path.join(dir, 'decision.json');
+const file = decisionFilePath();
+
+function writeRaw(obj) {
+  fs.writeFileSync(file, `${JSON.stringify(obj, null, 2)}\n`, 'utf8');
+}
+function removeFile() {
+  try { fs.unlinkSync(file); } catch { /* 不存在即忽略 */ }
+}
+
+check('配置文件路径遵循 MJCODE_DECISION_FILE 覆盖', () => {
+  if (!file.startsWith(dir)) throw new Error(`路径未使用环境变量覆盖：${file}`);
+});
+
+check('文件不存在时返回默认值（enabled / rules / 6000ms）', () => {
+  removeFile();
+  const snap = readConfigSync();
+  if (snap.exists) throw new Error('不应判定为存在');
+  if (snap.config.enabled !== true) throw new Error('默认应启用');
+  if (snap.config.path !== 'rules') throw new Error('默认来源应为仅规则');
+  if (snap.config.remote.timeoutMs !== DEFAULTS.remote.timeoutMs) throw new Error('默认超时不正确');
+  if (snap.config.version !== 2) throw new Error('默认版本应为 2');
+});
+
+check('写入后能原样读回（含 remote / params / cache）', () => {
+  const input = {
+    version: 2,
+    enabled: true,
+    path: 'remote',
+    remote: { providerId: 3, modelId: 'deepseek-chat', baseUrl: 'https://api.example.com', timeoutMs: 8000 },
+    params: { confidenceThreshold: 0.8, clarifyBand: [0.5, 0.7], maxClarify: 1 },
+    cache: { ttlSec: 3600, maxEntries: 100 },
+  };
+  const res = writeConfigSync(input);
+  if (!res.ok) throw new Error(`写入失败：${res.errors.join(',')}`);
+  const snap = readConfigSync();
+  if (snap.needsMigration) throw new Error('v2 不应标记迁移');
+  if (snap.config.path !== 'remote') throw new Error('path 丢失');
+  if (snap.config.remote.providerId !== 3) throw new Error('providerId 丢失');
+  if (snap.config.remote.modelId !== 'deepseek-chat') throw new Error('modelId 丢失');
+  if (snap.config.params.confidenceThreshold !== 0.8) throw new Error('阈值丢失');
+  if (snap.config.cache.ttlSec !== 3600) throw new Error('缓存 TTL 丢失');
+});
+
+check('v1 配置不静默升级：标记 needsMigration 且文件原样保留', () => {
+  const v1 = { version: 1, enabled: true, generic: { providerId: 'p-old', modelId: 'm-old', timeoutMs: 5000 } };
+  writeRaw(v1);
+  const before = fs.readFileSync(file, 'utf8');
+  const snap = readConfigSync();
+  if (!snap.legacy || !snap.needsMigration) throw new Error('v1 未标记为待迁移');
+  if (snap.config.version !== 2) throw new Error('对外快照应为 v2 形状');
+  if (snap.config.remote.providerId !== 'p-old') throw new Error('旧模型配置未尽力保留');
+  if (snap.config.path !== 'remote') throw new Error('有可用旧模型时应指向 remote');
+  const after = fs.readFileSync(file, 'utf8');
+  if (before !== after) throw new Error('读操作不得改写文件（静默升级）');
+});
+
+check('非法 path / enabled 类型收敛并记 errors', () => {
+  const { config, errors } = normalizeConfig({ version: 2, path: 'sidecar', enabled: 'yes' });
+  if (!errors.includes('path_invalid')) throw new Error('非法 path 未标记');
+  if (!errors.includes('enabled_invalid')) throw new Error('非法 enabled 未标记');
+  if (config.path !== 'rules') throw new Error('非法 path 未回落 rules');
+  if (config.enabled !== true) throw new Error('非法 enabled 未回落 true');
+});
+
+check('阈值 / 置信带越界被收敛', () => {
+  const { config, errors } = normalizeConfig({
+    version: 2,
+    params: { confidenceThreshold: 5, clarifyBand: [0.9, 0.2], maxClarify: 99 },
+  });
+  if (config.params.confidenceThreshold !== 1) throw new Error('阈值未收敛到 1');
+  if (!errors.includes('params_clarify_band_invalid')) throw new Error('应识别为非法置信带');
+  if (config.params.clarifyBand[0] !== 0.55) throw new Error('非法置信带未回落默认');
+  if (config.params.maxClarify !== 3) throw new Error('maxClarify 未收敛到 3');
+});
+
+check('缓存上限 0 被收敛到 1（避免 0 与「无上限」语义混淆）', () => {
+  const { config } = normalizeConfig({ version: 2, cache: { ttlSec: -5, maxEntries: 0 } });
+  if (config.cache.ttlSec !== 0) throw new Error('负 TTL 未收敛到 0');
+  if (config.cache.maxEntries !== 1) throw new Error('maxEntries=0 未收敛到 1');
+});
+
+check('非法 baseUrl 写入被拒绝且不落盘', () => {
+  const before = fs.readFileSync(file, 'utf8');
+  const res = writeConfigSync({ version: 2, remote: { baseUrl: 'ftp://evil' } });
+  if (res.ok) throw new Error('非法 baseUrl 不应写入成功');
+  if (!res.errors.includes('remote_base_url_invalid')) throw new Error('未标记 baseUrl 非法');
+  const after = fs.readFileSync(file, 'utf8');
+  if (before !== after) throw new Error('校验失败仍改写了文件');
+});
+
+check('损坏的 JSON 不抛错，返回默认值 + 可读错误', () => {
+  fs.writeFileSync(file, '{ this is not json', 'utf8');
+  const snap = readConfigSync();
+  if (snap.config.path !== 'rules') throw new Error('损坏文件应回落默认');
+  if (!snap.errors.some((e) => e.startsWith('file_unreadable'))) throw new Error('未标记文件不可读');
+});
+
+check('落盘权限为 0600（POSIX）', () => {
+  if (process.platform === 'win32') return; // Windows 权限语义不同，跳过
+  writeConfigSync({ version: 2, path: 'rules' });
+  const mode = fs.statSync(file).mode & 0o777;
+  if (mode !== 0o600) throw new Error(`权限应为 600，实际 ${mode.toString(8)}`);
+});
+
+// 清理：避免影响后续套件（路径由环境变量指向 tmp，仍显式恢复）
+removeFile();
+delete process.env.MJCODE_DECISION_FILE;
+
+console.log(`\ndecision-config: ${pass}/${total} 通过`);
+process.exit(pass === total ? 0 : 1);
diff --git a/desktop/test/engine-mode.test.mjs b/desktop/test/engine-mode.test.mjs
new file mode 100644
index 0000000..2a414e9
--- /dev/null
+++ b/desktop/test/engine-mode.test.mjs
@@ -0,0 +1,139 @@
+// P0 执行模式分层（2026-10-22）守护套件：模式单一事实源 / 工具差集 / 写入口枚举校验 / 卡片投影透出
+//
+// 为什么必须单测而不是只靠真机：
+//   ① 互斥矩阵有三处落点（工具清单差集、分发入口二次校验、建组写入口），
+//      任何一处漏改都只在「模型硬写工具名」时才暴露，手点界面几乎测不到；
+//   ② projection 层的 engineMode 若漏透出，界面只是「少个徽标」，不会报错——静默缺口最难发现；
+//   ③ createGroup 的枚举校验若退化成静默回落，「按模板」会被当成「自动拆解」跑掉，
+//      产物与预期不符且无任何提示（这是本节要守的核心行为）。
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { createRequire } from 'node:module';
+import {
+  ENGINE_MODES, DEFAULT_ENGINE_MODE, isEngineMode, normalizeEngineMode, assertEngineMode,
+  createsGroup, allowsOrchestration, allowsTeamTools, engineModeLabelKey,
+} from '../shared/engineMode.mjs';
+import {
+  blockedToolNamesForMode, filterToolsForMode, checkToolAllowed,
+  ORCHESTRATION_TOOL_NAMES, TEAM_TOOL_NAMES,
+} from '../agent-core/toolTiers.js';
+import { assembleThreadRuns, projectTeamRuns } from '../shared/teamStream.mjs';
+
+const require = createRequire(import.meta.url);
+
+let pass = 0;
+let fail = 0;
+function check(name, ok, detail = '') {
+  if (ok) { pass++; console.log(`✅ ${name}${detail ? ` — ${detail}` : ''}`); }
+  else { fail++; console.log(`❌ ${name}${detail ? ` — ${detail}` : ''}`); }
+}
+
+// ── ① 枚举与能力谓词（单一事实源）──
+check('① 枚举固定为 chat/template/auto/team 四值', ENGINE_MODES.join(',') === 'chat,template,auto,team');
+check('① 缺省档为 auto', DEFAULT_ENGINE_MODE === 'auto');
+check('① isEngineMode 只认合法值', isEngineMode('team') && !isEngineMode('TEAM') && !isEngineMode(''));
+
+// 读路径：坏值回落不中断；写路径：坏值必须抛错（不静默改写用户意图）
+check('① normalizeEngineMode 非法值回落 auto', normalizeEngineMode('nope') === 'auto' && normalizeEngineMode(undefined) === 'auto');
+check('① normalizeEngineMode 合法值原样返回', normalizeEngineMode('template') === 'template');
+let assertThrew = '';
+try { assertEngineMode('bogus'); } catch (err) { assertThrew = String(err && err.message); }
+check('① assertEngineMode 非法值抛错且带允许值提示',
+  assertThrew.includes('非法执行模式') && assertThrew.includes('chat / template / auto / team'), assertThrew);
+check('① assertEngineMode 缺省返回 auto', assertEngineMode() === 'auto' && assertEngineMode('') === 'auto');
+
+// 能力谓词按设计稿 §4.2：chat 不建组；仅 auto 允许编排；仅 team 允许团队工具
+check('① createsGroup：chat 不建组、其余建组',
+  createsGroup('chat') === false && createsGroup('template') && createsGroup('auto') && createsGroup('team'));
+check('① allowsOrchestration 仅 auto',
+  allowsOrchestration('auto') && !allowsOrchestration('chat') && !allowsOrchestration('template') && !allowsOrchestration('team'));
+check('① allowsTeamTools 仅 team',
+  allowsTeamTools('team') && !allowsTeamTools('auto') && !allowsTeamTools('template') && !allowsTeamTools('chat'));
+check('① 徽标 key 前缀统一为 engineMode.*', engineModeLabelKey('team') === 'engineMode.team' && engineModeLabelKey('x') === 'engineMode.auto');
+
+// ── ② 工具清单差集（① 号落点：模型看不见禁用工具）──
+const fakeTools = [{ function: { name: 'read_file' } }, ...ORCHESTRATION_TOOL_NAMES, ...TEAM_TOOL_NAMES]
+  .map((t) => (typeof t === 'string' ? { function: { name: t } } : t));
+const namesOf = (list) => list.map((t) => t.function.name);
+check('② chat：编排与团队工具全部剔除，普通工具保留',
+  namesOf(filterToolsForMode(fakeTools, 'chat')).join(',') === 'read_file',
+  namesOf(filterToolsForMode(fakeTools, 'chat')).join(','));
+check('② template：编排与团队工具都剔除（DAG 来自模板，运行期不得再拆）',
+  namesOf(filterToolsForMode(fakeTools, 'template')).join(',') === 'read_file',
+  namesOf(filterToolsForMode(fakeTools, 'template')).join(','));
+check('② auto：保留编排、剔除团队工具',
+  namesOf(filterToolsForMode(fakeTools, 'auto')).join(',') === 'read_file,orchestrate_task',
+  namesOf(filterToolsForMode(fakeTools, 'auto')).join(','));
+check('② team：保留团队工具、剔除编排',
+  !namesOf(filterToolsForMode(fakeTools, 'team')).includes('orchestrate_task')
+  && namesOf(filterToolsForMode(fakeTools, 'team')).includes('team_wait'));
+
+// 空集保护：全部被剔除时保留原集合（判定异常不该让模型无工具可用）
+check('② 空集保护：全被禁时返回原集合', filterToolsForMode([{ function: { name: 'orchestrate_task' } }], 'chat').length === 1);
+check('② 非数组入参不抛错', filterToolsForMode(null, 'chat').length === 0);
+
+// ③ handler / 分发入口二次校验（模型硬写工具名也拦）
+const locked = checkToolAllowed('chat', 'team_send_message');
+check('③ chat 调团队工具 → ENGINE_MODE_LOCKED',
+  locked.ok === false && locked.code === 'ENGINE_MODE_LOCKED' && locked.error.includes('team_send_message'), locked.error);
+check('③ template 调 orchestrate_task 被拦', checkToolAllowed('template', 'orchestrate_task').ok === false);
+check('③ auto 调 orchestrate_task 放行', checkToolAllowed('auto', 'orchestrate_task').ok === true);
+check('③ team 调 team_board 放行、调 orchestrate_task 被拦',
+  checkToolAllowed('team', 'team_board').ok === true && checkToolAllowed('team', 'orchestrate_task').ok === false);
+check('③ 普通工具不受模式限制', checkToolAllowed('chat', 'read_file').ok === true);
+check('③ 非法模式先归一化（auto）再判定', checkToolAllowed('bogus', 'orchestrate_task').ok === true);
+
+// ── ④ 卡片投影透出 engineMode（P0-6）──
+const fullGroup = { group_id: 'run-1', status: 'done', goal: 'g', engine_mode: 'template', result: { summary: 'ok' }, tasks: [] };
+const runs = assembleThreadRuns({
+  groups: [{ group_id: 'run-1', thread_id: 't1' }],
+  messages: [],
+  events: [],
+  getGroup: () => fullGroup,
+  getTeam: () => null,
+  getBudgetLive: () => null,
+});
+check('④ assembleThreadRuns 透出 engineMode', runs.length === 1 && runs[0].engineMode === 'template', JSON.stringify(runs[0] && runs[0].engineMode));
+const cards = projectTeamRuns(runs);
+check('④ projectTeamRuns 继承 engineMode', cards.length === 1 && cards[0].engineMode === 'template');
+const legacy = projectTeamRuns([{ runId: 'run-2', status: 'done' }]);
+check('④ 历史 run 缺键回落 auto（与库默认同口径）', legacy[0].engineMode === 'auto');
+
+// ── ⑤ createGroup 写入口枚举校验 + 迁移默认值（③ 号落点）──
+const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'mjcode-engine-mode-'));
+const { openDbAsync } = require('../main/db');
+const { TaskStore } = require('../main/taskStore');
+const db = await openDbAsync(dir, { driver: 'sqljs' });
+const store = new TaskStore(db);
+const TASKS = [{ id: 'a', title: 'A', prompt: 'pa', dependsOn: [] }];
+try {
+  const tg = store.createGroup({ groupId: 'g-tpl', goal: '模板目标', cwd: '/tmp', dag: { levels: [['a']] }, tasks: TASKS, engineMode: 'template' });
+  check('⑤ engineMode=template 落库并可读回', tg.engine_mode === 'template');
+  const ag = store.createGroup({ groupId: 'g-def', goal: '缺省目标', cwd: '/tmp', dag: { levels: [['a']] }, tasks: TASKS });
+  check('⑤ 未传 engineMode → 默认 auto', ag.engine_mode === 'auto');
+
+  let badErr = '';
+  try {
+    store.createGroup({ groupId: 'g-bad', goal: '非法模式', cwd: '/tmp', dag: null, tasks: TASKS, engineMode: 'fast' });
+  } catch (err) { badErr = String(err && err.message); }
+  check('⑤ 非法 engineMode 直接抛错（不静默回落）', badErr.includes('非法执行模式'), badErr);
+  check('⑤ 非法建组未落库（事务未执行）', store.getGroup('g-bad') === null);
+
+  // 历史库：迁移后列存在且为 NOT NULL DEFAULT 'auto'（v15 契约）
+  const cols = db.prepare('PRAGMA table_info(task_groups)').all();
+  const modeCol = cols.find((c) => c.name === 'engine_mode');
+  check('⑤ task_groups 存在 engine_mode 列且默认 auto',
+    !!modeCol && String(modeCol.dflt_value).includes('auto') && Number(modeCol.notnull) === 1,
+    modeCol ? `dflt=${modeCol.dflt_value} notnull=${modeCol.notnull}` : 'missing');
+  check('⑤ router_json / template_ref 列存在（P0-2 契约）',
+    cols.some((c) => c.name === 'router_json') && cols.some((c) => c.name === 'template_ref'));
+} finally {
+  try { db.close(); } catch { /* 已关闭 */ }
+  fs.rmSync(dir, { recursive: true, force: true });
+}
+
+console.log(`\nengine-mode: ${pass}/${pass + fail} 通过`);
+if (fail > 0) process.exitCode = 1;
+assert.ok(pass > 0);
diff --git a/desktop/test/pricing-tiers.test.mjs b/desktop/test/pricing-tiers.test.mjs
new file mode 100644
index 0000000..5d23061
--- /dev/null
+++ b/desktop/test/pricing-tiers.test.mjs
@@ -0,0 +1,80 @@
+// 分时计价守护套件（需求 4 增强，2026-10-23）：shared/pricing.mjs 的纯函数行为
+//
+// 为什么单测：这套逻辑要保证「运行跨过闲时/忙时边界时不会整单按一个价算错」，
+// 而真机上很难恰好跨档跑一次；且一旦 `from > to`（跨零点）判断写反，
+// 白天会被按闲时计价——用户只会觉得「账单对不上」，不会报错。
+import assert from 'node:assert/strict';
+import {
+  hhmmToMin, minToHhmm, tierHitsMinute, activeRateAt,
+  costAtRate, costForWindow, fmtMoney,
+} from '../shared/pricing.mjs';
+
+let pass = 0;
+let fail = 0;
+function check(name, ok, detail = '') {
+  if (ok) { pass++; console.log(`✅ ${name}${detail ? ` — ${detail}` : ''}`); }
+  else { fail++; console.log(`❌ ${name}${detail ? ` — ${detail}` : ''}`); }
+}
+
+// 固定日期（本地时区），只测「分钟值 → 档位」而不依赖真实当前时间
+const at = (h, m) => new Date(2026, 0, 15, h, m, 0, 0).getTime();
+
+const DEEPSEEK = {
+  currency: 'CNY',
+  input: 2,
+  output: 8,
+  tiers: [{ from: '00:30', to: '08:30', input: 1, output: 4, label: '闲时' }],
+};
+
+// ── 1) 时间解析 ──
+check('hhmmToMin 解析合法值', hhmmToMin('00:30') === 30 && hhmmToMin('23:59') === 1439);
+check('hhmmToMin 拒绝非法值', hhmmToMin('24:00') === null && hhmmToMin('8:5') === null && hhmmToMin('') === null);
+check('minToHhmm 归一化越界值', minToHhmm(30) === '00:30' && minToHhmm(-5) === '00:00' && minToHhmm(5000) === '23:59');
+
+// ── 2) 档位命中 ──
+check('普通区间含左不含右', tierHitsMinute(30, 510, 30) === true && tierHitsMinute(30, 510, 510) === false);
+check('跨零点区间（22:30-08:30）两侧都命中', tierHitsMinute(1350, 510, 23 * 60) === true && tierHitsMinute(1350, 510, 3 * 60) === true);
+check('跨零点区间白天不命中', tierHitsMinute(1350, 510, 12 * 60) === false);
+
+// ── 3) 当前生效单价 ──
+const nightRate = activeRateAt(DEEPSEEK, at(7, 0));
+check('闲时命中取时段价', nightRate && nightRate.input === 1 && nightRate.output === 4 && nightRate.label === '闲时', JSON.stringify(nightRate));
+const dayRate = activeRateAt(DEEPSEEK, at(9, 0));
+check('闲时之外取基础价', dayRate && dayRate.input === 2 && dayRate.output === 8 && dayRate.label === '', JSON.stringify(dayRate));
+check('未配置费用返回 null', activeRateAt(null, at(9, 0)) === null && activeRateAt({}, at(9, 0)) === null);
+check('只有时段也能取价（无基础价）', (() => {
+  const r = activeRateAt({ tiers: [{ from: '00:00', to: '23:59', input: 3, output: 9 }] }, at(9, 0));
+  return r && r.input === 3 && r.output === 9;
+})());
+
+// ── 4) 单点计费（每百万 token） ──
+const single = costAtRate({ input: 2, output: 8, currency: 'CNY', label: '' }, 1_000_000, 500_000);
+check('单点费用 = 输入单价×输入量 + 输出单价×输出量', single && Math.abs(single.cost - (2 + 4)) < 1e-9, JSON.stringify(single));
+
+// ── 5) 跨档窗口切段计价（忙时 2h + 闲时 1h） ──
+// window 06:30 → 09:30：06:30-08:30 闲时(1/4)，08:30-09:30 基础(2/8)
+const windowCost = costForWindow(DEEPSEEK, 1_000_000, 1_000_000, { from: at(6, 30), to: at(9, 30) });
+check('跨档窗口切成两段', windowCost && windowCost.mixed === true && windowCost.segments.length === 2,
+  JSON.stringify(windowCost && windowCost.segments.map((s) => [s.rate.label || '基础', Math.round((s.to - s.from) / 60000)])));
+// 期望：闲时 2/3 的用量按 1/4，基础 1/3 按 2/8
+const expect = (1_000_000 * (2 / 3) * 1 + 1_000_000 * (2 / 3) * 4 + 1_000_000 * (1 / 3) * 2 + 1_000_000 * (1 / 3) * 8) / 1e6;
+check('跨档费用按时间占比加权', windowCost && Math.abs(windowCost.cost - expect) < 1e-6, `${windowCost && windowCost.cost} vs ${expect}`);
+check('跨档 label 如实拼接档位名', windowCost && windowCost.label.includes('闲时'), windowCost && windowCost.label);
+
+// ── 6) 全在闲时：不切段、不标 mixed ──
+const nightWindow = costForWindow(DEEPSEEK, 1_000_000, 0, { from: at(3, 0), to: at(5, 0) });
+check('全在闲时只按闲时价', nightWindow && nightWindow.mixed === false && Math.abs(nightWindow.cost - 1) < 1e-9 && nightWindow.label === '闲时', JSON.stringify(nightWindow && { cost: nightWindow.cost, label: nightWindow.label }));
+check('全在闲时只有一段', nightWindow && nightWindow.segments.length === 1);
+
+// ── 7) 未配置费用 → null（调用方只显示 token） ──
+check('未配置费用时窗口费用为 null', costForWindow(null, 1000, 1000, { from: at(3, 0), to: at(5, 0) }) === null);
+
+// ── 8) 无跨度退化为单点（按 at 取价） ──
+const pointCost = costForWindow(DEEPSEEK, 1_000_000, 0, { at: at(4, 0) });
+check('无起止时按 at 单点取价', pointCost && Math.abs(pointCost.cost - 1) < 1e-9 && pointCost.mixed === false, JSON.stringify(pointCost && pointCost.cost));
+
+// ── 9) 金额格式化 ──
+check('金额格式化：小额四位、常规两位', fmtMoney(0.0005, 'CNY') === '¥0.0005' && fmtMoney(1.234, 'USD') === '$1.23' && fmtMoney(0, 'CNY') === '¥0');
+
+console.log(`\n${pass}/${pass + fail} 通过`);
+assert.equal(fail, 0, `${fail} 条断言失败`);
diff --git a/desktop/test/route-hint.test.mjs b/desktop/test/route-hint.test.mjs
new file mode 100644
index 0000000..58e4c0b
--- /dev/null
+++ b/desktop/test/route-hint.test.mjs
@@ -0,0 +1,100 @@
+// 决策路由 → 输入框 pill 提示的守护套件（P3，2026-10-23）：shared/routeHint.mjs
+//
+// 为什么单测：这段映射直接决定「pill 下方那一行会不会出现、会不会把用户档位改掉」。
+// 三类错误在真机上很难复现，但后果都很重：
+//   ① 把降级信封（source=fallback / degraded）当建议展示 —— 路由故障替用户改档位；
+//   ② 决策为 team 时给一个 pill 点不动的「改用团队」按钮 —— 假可用性；
+//   ③ 把短草稿（「你好」）也送去做一次本地推理 —— 每敲两个字烧一次模型。
+import assert from 'node:assert/strict';
+import {
+  ROUTE_MODES, PILL_MODES, HINT_ACTIONS, MIN_HINT_CHARS,
+  normalizeHintMode, actionFromConfidence, buildRouteHint, shouldProbe, confidencePercent,
+} from '../shared/routeHint.mjs';
+
+let pass = 0;
+let fail = 0;
+function check(name, ok, detail = '') {
+  if (ok) { pass++; console.log(`✅ ${name}${detail ? ` — ${detail}` : ''}`); }
+  else { fail++; console.log(`❌ ${name}${detail ? ` — ${detail}` : ''}`); }
+}
+
+/** 构造一个「合法远程/本地决策」信封：policy 由调用方给，confidence 与 mode 可覆盖 */
+function envelope(mode, confidence, extra = {}) {
+  return {
+    ok: true,
+    source: 'local',
+    degraded: false,
+    decision: {
+      mode,
+      confidence,
+      task_brief: '给功能起名',
+      reason: '单轮命名建议',
+      need_clarify: false,
+      clarify_question: '',
+    },
+    policy: { action: confidence >= 0.75 ? 'execute' : confidence >= 0.55 ? 'suggest' : 'clarify', reason: '' },
+    ...extra,
+  };
+}
+
+// ── 1) 枚举与 pill 支持的档位 ──
+check('四种模式齐全', ROUTE_MODES.join(',') === 'chat,template,auto,team');
+check('pill 只表达三种档位（不含 team）', PILL_MODES.join(',') === 'auto,chat,template' && !PILL_MODES.includes('team'));
+check('三种动作齐全', HINT_ACTIONS.join(',') === 'execute,suggest,clarify');
+
+// ── 2) 模式归一化：非法值不回落成 chat ──
+check('合法模式原样返回', normalizeHintMode('template') === 'template');
+check('非法/缺失返回空串（不是 chat）', normalizeHintMode('nope') === '' && normalizeHintMode(null) === '' && normalizeHintMode(undefined) === '');
+check('大小写与空白不做猜测', normalizeHintMode(' Chat ') === '');
+
+// ── 3) 置信度 → 动作（仅在信封缺 policy 时兜底） ──
+check('高置信 → execute', actionFromConfidence(0.9) === 'execute');
+check('中置信 → suggest', actionFromConfidence(0.6) === 'suggest');
+check('低置信 → clarify', actionFromConfidence(0.2) === 'clarify');
+check('阈值可配', actionFromConfidence(0.6, { confidenceThreshold: 0.5 }) === 'execute');
+check('置信度越界被夹紧', actionFromConfidence(5) === 'execute' && actionFromConfidence(-1) === 'clarify');
+
+// ── 4) 建议提示：档位不同才出 ──
+const suggest = buildRouteHint(envelope('chat', 0.82), 'auto');
+check('高置信且档位不同 → suggest', suggest && suggest.kind === 'suggest' && suggest.targetMode === 'chat', JSON.stringify(suggest && { kind: suggest.kind, targetMode: suggest.targetMode }));
+check('suggest 可采纳且带百分比', suggest && suggest.canAdopt === true && confidencePercent(suggest.confidence) === 82);
+check('档位相同 → 不出提示（避免每条草稿都打扰）', buildRouteHint(envelope('chat', 0.82), 'chat') === null);
+check('低置信但需要补信息时优先 clarify', (() => {
+  const e = envelope('chat', 0.3);
+  e.decision.need_clarify = true;
+  e.decision.clarify_question = '这个功能具体做什么？';
+  e.policy = { action: 'clarify', reason: 'need_clarify' };
+  const h = buildRouteHint(e, 'auto');
+  return h && h.kind === 'clarify' && h.question === '这个功能具体做什么？' && h.canAdopt === true;
+})());
+check('clarify 但无可问的问题 → 退化成 suggest/null', (() => {
+  const e = envelope('template', 0.4);
+  e.policy = { action: 'clarify', reason: 'low_confidence' };
+  const h = buildRouteHint(e, 'auto');
+  // 档位不同 → 仍给「改用按模板」；档位相同 → null
+  return h && h.kind === 'suggest' && buildRouteHint(e, 'template') === null;
+})());
+
+// ── 5) 降级信封一律不出建议（纪律②） ──
+check('source=fallback 不出建议', buildRouteHint(envelope('chat', 0.2, { source: 'fallback', degraded: true }), 'auto') === null);
+check('degraded=true 即使 mode 合法也不出', buildRouteHint(envelope('chat', 0.9, { degraded: true }), 'auto') === null);
+check('source=disabled 不出建议', buildRouteHint(envelope('chat', 0.9, { source: 'disabled' }), 'auto') === null);
+check('ok=false / 无 decision 不出建议', buildRouteHint({ ok: false, error: 'x' }, 'auto') === null && buildRouteHint({ ok: true }, 'auto') === null);
+check('空信封不出建议', buildRouteHint(null, 'auto') === null && buildRouteHint(undefined, 'auto') === null);
+
+// ── 6) team 决策不产出可采纳提示（纪律③：pill 点不动） ──
+check('team 决策返回 null', buildRouteHint(envelope('team', 0.9), 'auto') === null);
+check('非法 mode 返回 null', buildRouteHint(envelope('ops', 0.9), 'auto') === null);
+
+// ── 7) 探测门槛（纪律③：别为短草稿烧一次本地推理） ──
+check('过短草稿不探测', shouldProbe('你好') === false && shouldProbe(`12345`) === false, `MIN_HINT_CHARS=${MIN_HINT_CHARS}`);
+check('纯标点不探测', shouldProbe('……？？！') === false);
+check('空串/null 不探测', shouldProbe('') === false && shouldProbe(null) === false && shouldProbe(undefined) === false);
+check('正常句子探测', shouldProbe('帮我想想这个功能叫什么名字') === true);
+check('中英混排与数字都算有语义', shouldProbe('rename this 功能') === true && shouldProbe('2026 路线图怎么排') === true);
+
+// ── 8) 百分比口径 ──
+check('百分比四舍五入', confidencePercent(0.923) === 92 && confidencePercent(0) === 0 && confidencePercent(1.9) === 100);
+
+console.log(`\n${pass}/${pass + fail} 通过`);
+assert.equal(fail, 0, `${fail} 条断言失败`);
