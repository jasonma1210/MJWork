@@ -0,0 +1,111 @@
+// P2（2026-10-23）：对话页编排方式的「会话先行」入口。
+//
+// 为什么编排（模板 run / 先看拆解 / 直接回答）都必须先有会话：
+// 任务组落库时写的是 thread_id，而对话内卡片按 thread_id 反查。若新会话直接建组，
+// thread_id 为空 → 卡片查不到，界面只剩一句提示（M5/T5-8 真机事故同款）。
+//
+// 口径与 useAgentRun.send / 团队派活保持一致：
+//   ① 新会话且用户没主动选目录 → 自建时间戳目录（产物落在本次任务自己的目录，不污染上一个工作区）；
+//   ② 目录创建失败直接阻断（不回落旧目录）；
+//   ③ 新建线程后通知 App 切过去，否则仍停在欢迎页。
+import { api } from './api';
+import { tGlobal } from '../i18n';
+
+export interface RunSessionResult {
+  ok: boolean;
+  threadId?: string;
+  cwd?: string;
+  projectPath?: string;
+  /** 本次是否新建了会话（新建时用户消息由切换后的拉取结果覆盖，调用方不要再就地补气泡） */
+  created?: boolean;
+  error?: string;
+}
+
+export interface RunSessionArgs {
+  threadId?: string | number | null;
+  cwd?: string;
+  projectPath?: string;
+  projectPicked?: boolean;
+  selectedModel?: {
+    provider?: { id?: unknown; name?: unknown };
+    model?: { id?: unknown; model_id?: unknown };
+  } | null;
+  goal: string;
+  onAutoProject?: (project: {
+    id: string; name: string; path: string; branch: string;
+  }) => void;
+  onNewMessage?: () => void;
+  onThreadCreated?: (thread: unknown) => void;
+}
+
+function errText(err: unknown): string {
+  return String((err as Error)?.message || err);
+}
+
+export async function ensureRunSession(args: RunSessionArgs): Promise<RunSessionResult> {
+  const goal = String(args.goal || '');
+  const rawThreadId = args.threadId == null ? '' : String(args.threadId).trim();
+  let runThreadId: string | null = rawThreadId || null;
+  let runCwd = String(args.cwd || '');
+  let runProjectPath = String(args.projectPath || '');
+  let created = false;
+
+  if (runThreadId == null && !args.projectPicked) {
+    try {
+      const r = (await window.mjcode?.createProject?.({ name: '' })) as
+        { ok?: boolean; path?: string; name?: string; error?: string } | undefined;
+      if (r?.ok && r.path) {
+        runCwd = r.path;
+        runProjectPath = r.path;
+        args.onAutoProject?.({
+          id: r.path,
+          name: r.name || String(r.path).split('/').filter(Boolean).pop() || r.path,
+          path: r.path,
+          branch: '',
+        });
+      } else {
+        return {
+          ok: false,
+          error: tGlobal('runtime.taskDirCreateFailed', {
+            error: String(r?.error || tGlobal('runtime.unknownError')),
+          }),
+        };
+      }
+    } catch (err) {
+      return { ok: false, error: tGlobal('runtime.taskDirCreateFailed', { error: errText(err) }) };
+    }
+  }
+
+  if (runThreadId == null) {
+    try {
+      const nt = (await api.createThread({
+        provider_id: args.selectedModel?.provider?.id,
+        model_id: args.selectedModel?.model?.id,
+        provider_name: args.selectedModel?.provider?.name,
+        model_name: args.selectedModel?.model?.model_id,
+        cwd: runCwd,
+        project_path: runProjectPath,
+        title: goal.slice(0, 50),
+      })) as { id?: string | number } | null;
+      if (!nt?.id) throw new Error('no thread id');
+      runThreadId = String(nt.id);
+      created = true;
+      args.onNewMessage?.();
+      args.onThreadCreated?.(nt);
+    } catch (err) {
+      return { ok: false, error: tGlobal('runtime.threadCreateFailed', { error: errText(err) }) };
+    }
+  }
+
+  return { ok: true, threadId: runThreadId || undefined, cwd: runCwd, projectPath: runProjectPath, created };
+}
+
+/** 把用户目标落库为会话里的 user 消息（团队 / 模板 run 本身不产生 assistant 消息，必须显式落）。 */
+export async function persistUserGoal(threadId: string, goal: string): Promise<{ ok: boolean; error?: string }> {
+  try {
+    await api.sendMessage(threadId, { role: 'user', content: goal });
+    return { ok: true };
+  } catch (err) {
+    return { ok: false, error: errText(err) };
+  }
+}
