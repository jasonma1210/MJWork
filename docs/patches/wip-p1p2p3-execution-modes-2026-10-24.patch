+            </div>
+            <div className="py-4 border-b border-border">
+              <div className="text-sm font-medium mb-2">{t('settings.routerModel')}</div>
+              <Input
+                value={cfg.remote.modelId}
+                placeholder={t('settings.routerModelPlaceholder')}
+                onChange={(e) => patchRemote('modelId', e.target.value)}
+              />
+            </div>
+            <div className="py-4 border-b border-border">
+              <div className="text-sm font-medium mb-2">{t('settings.routerBaseUrl')}</div>
+              <Input
+                value={cfg.remote.baseUrl}
+                placeholder={currentProvider ? currentProvider.base_url : t('settings.routerBaseUrlPlaceholder')}
+                onChange={(e) => patchRemote('baseUrl', e.target.value)}
+              />
+            </div>
+            <div className="py-4">
+              <div className="text-sm font-medium mb-2">{t('settings.routerTimeout')}</div>
+              <input
+                type="number"
+                min={1000}
+                max={30000}
+                step={500}
+                value={cfg.remote.timeoutMs}
+                onChange={(e) => patchRemote('timeoutMs', Number(e.target.value))}
+                className="w-full bg-input border border-border rounded-lg px-3 py-2 text-sm outline-none focus:border-accent"
+              />
+              <p className="mt-2 text-xs text-text2">{t('settings.routerTimeoutDesc')}</p>
+            </div>
+          </>
+        )}
+      </Section>
+
+      <Section title={t('settings.routerPolicyTitle')}>
+        <div className="py-4 border-b border-border">
+          <div className="text-sm font-medium mb-2">{t('settings.routerThreshold')}</div>
+          <input
+            type="number"
+            min={0.5}
+            max={0.99}
+            step={0.01}
+            value={cfg.params.confidenceThreshold}
+            onChange={(e) => patchParams('confidenceThreshold', Number(e.target.value))}
+            className="w-full bg-input border border-border rounded-lg px-3 py-2 text-sm outline-none focus:border-accent"
+          />
+          <p className="mt-2 text-xs text-text2">{t('settings.routerThresholdDesc')}</p>
+        </div>
+        <div className="py-4">
+          <div className="text-sm font-medium mb-2">{t('settings.routerBand')}</div>
+          <div className="flex items-center gap-2">
+            <input
+              type="number" min={0} max={1} step={0.01}
+              value={cfg.params.clarifyBand[0]}
+              onChange={(e) => patchParams('clarifyBand', [Number(e.target.value), cfg.params.clarifyBand[1]])}
+              className="w-full bg-input border border-border rounded-lg px-3 py-2 text-sm outline-none focus:border-accent"
+            />
+            <span className="text-text2 text-sm">–</span>
+            <input
+              type="number" min={0} max={1} step={0.01}
+              value={cfg.params.clarifyBand[1]}
+              onChange={(e) => patchParams('clarifyBand', [cfg.params.clarifyBand[0], Number(e.target.value)])}
+              className="w-full bg-input border border-border rounded-lg px-3 py-2 text-sm outline-none focus:border-accent"
+            />
+          </div>
+          <p className="mt-2 text-xs text-text2">{t('settings.routerBandDesc')}</p>
+        </div>
+      </Section>
+
+      <div className="mb-8 flex items-center gap-3">
+        <Button onClick={save} disabled={saving}>{saving ? t('settings.routerSaving') : t('settings.routerSave')}</Button>
+        {flash && <span className="text-xs text-accent">{flash}</span>}
+        {error && <span className="text-xs text-danger break-all">{error}</span>}
+      </div>
+
+      <Section title={t('settings.routerSelfTestTitle')}>
+        <div className="py-4">
+          <p className="text-xs text-text2 mb-2">{t('settings.routerSelfTestDesc')}</p>
+          <Input value={sample} onChange={(e) => setSample(e.target.value)} placeholder={t('settings.routerSelfTestPlaceholder')} />
+          <div className="mt-3 flex items-center gap-3">
+            <Button onClick={runRuleTest} disabled={sampleBusy || !sample.trim()}>
+              {sampleBusy ? t('settings.routerTesting') : t('settings.routerRunTest')}
+            </Button>
+            {sampleResult && !sampleResult.ok && (
+              <span className="text-xs text-danger break-all">{sampleResult.error}</span>
+            )}
+          </div>
+          {sampleResult && sampleResult.ok && sampleResult.decision && (
+            <div className="mt-3 rounded-xl border border-border px-4 py-3 text-xs space-y-1">
+              <div>{t('settings.routerResultMode')}: <span className="font-medium">{sampleResult.decision.mode}</span></div>
+              <div>{t('settings.routerResultConfidence')}: {Math.round(sampleResult.decision.confidence * 100)}%</div>
+              <div>{t('settings.routerResultSource')}: {sourceLabel(sampleResult.source)}</div>
+              <div>{t('settings.routerLatency')}: {sampleResult.latencyMs} ms</div>
+              {sampleResult.decision.reason && <div className="text-text2">{sampleResult.decision.reason}</div>}
+            </div>
+          )}
+        </div>
+
+        <div className="py-4 border-t border-border">
+          <div className="text-sm font-medium mb-1">{t('settings.routerRemoteTest')}</div>
+          <p className="text-xs text-text2 mb-3">{t('settings.routerRemoteTestDesc')}</p>
+          <div className="flex items-center gap-3">
+            <Button onClick={runRemoteTest} disabled={remoteBusy || cfg.path !== 'remote' || !cfg.remote.providerId || !cfg.remote.modelId}>
+              {remoteBusy ? t('settings.routerTesting') : t('settings.routerRemoteTestRun')}
+            </Button>
+            {cfg.path !== 'remote' && <span className="text-xs text-text2">{t('settings.routerRemoteDisabled')}</span>}
+          </div>
+          {remoteResult && (
+            <div className="mt-3 rounded-xl border border-border px-4 py-3 text-xs space-y-1">
+              <div>{remoteResult.ok ? t('settings.routerRemoteOk') : t('settings.routerRemoteFailed')}</div>
+              {typeof remoteResult.latencyMs === 'number' && <div>{t('settings.routerLatency')}: {remoteResult.latencyMs} ms</div>}
+              {remoteResult.decision && (
+                <div>
+                  {t('settings.routerResultMode')}: {remoteResult.decision.mode} · {Math.round(remoteResult.decision.confidence * 100)}%
+                </div>
+              )}
+              {remoteResult.error && <div className="text-danger break-all">{remoteResult.error}</div>}
+              {remoteResult.content && (
+                <pre className="mt-1 whitespace-pre-wrap break-all text-text2">{remoteResult.content}</pre>
+              )}
+            </div>
+          )}
+        </div>
+      </Section>
+
+      <Section title={t('settings.routerLogsTitle')}>
+        <div className="py-4">
+          {logs.length === 0 ? (
+            <p className="text-xs text-text2">{t('settings.routerLogsEmpty')}</p>
+          ) : (
+            <ul className="space-y-2">
+              {logs.slice().reverse().map((row, i) => (
+                <li key={`${row.at}-${i}`} className="text-xs border-b border-border last:border-0 pb-2 last:pb-0">
+                  <div className="flex items-center gap-2">
+                    <span className="font-medium">{row.mode}</span>
+                    <span className="text-text2">{Math.round(row.confidence * 100)}%</span>
+                    <span className="text-text2">· {sourceLabel(row.source)}</span>
+                    <span className="text-text2">· {row.latencyMs} ms</span>
+                    {row.degraded && <span className="text-danger">{t('settings.routerLogsDegraded')}</span>}
+                  </div>
+                  <div className="text-text2 mt-1 truncate">{row.textBrief}</div>
+                </li>
+              ))}
+            </ul>
+          )}
+        </div>
+      </Section>
+    </div>
+  );
+}
diff --git a/desktop/renderer/src/hooks/useRouteHint.ts b/desktop/renderer/src/hooks/useRouteHint.ts
new file mode 100644
index 0000000..0eb92b6
--- /dev/null
+++ b/desktop/renderer/src/hooks/useRouteHint.ts
@@ -0,0 +1,86 @@
+// P3（2026-10-23）：输入框草稿 → 决策路由 → pill 提示。
+//
+// 三条纪律（与 shared/routeHint.mjs 的文件头一致）：
+//   ① 只产出**建议**：采纳与否由用户点 pill 上的「改用 X」决定，绝不自动改档位；
+//   ② 降级不出建议：source=fallback/disabled、degraded 由 buildRouteHint 直接滤掉；
+//   ③ 探测是**可省的成本**：草稿过短不发请求；同一份草稿 + 同一档位只探测一次
+//      （内存去重；主进程还有 24h 决策缓存，重复探测也是命中缓存）。
+//
+// 并发：IPC 不可中断，因此用「同一时刻只跑一个探测 + 递增序号丢弃过期结果」，
+// 避免用户连续敲字时几个慢请求（本地推理可达十几秒）乱序覆盖界面。
+import { useEffect, useRef, useState } from 'react';
+import { buildRouteHint, shouldProbe, type DecideEnvelope, type RouteHint } from '../../../shared/routeHint.mjs';
+
+const DEBOUNCE_MS = 700;
+
+export interface UseRouteHintOptions {
+  /** 输入框草稿 */
+  text: string;
+  /** 当前 pill 档位（auto / chat / template） */
+  engineMode: string;
+  /** 页面模式（透传给路由，用于规则判据） */
+  pageMode?: string;
+  /** 关掉后不发起任何探测（例如运行中、选中军团时） */
+  enabled?: boolean;
+}
+
+export interface RouteHintState {
+  hint: RouteHint | null;
+  /** 用户忽略或已采纳后清空，避免同一条建议反复出现 */
+  dismiss: () => void;
+}
+
+export function useRouteHint({ text, engineMode, pageMode = 'chat', enabled = true }: UseRouteHintOptions): RouteHintState {
+  const [hint, setHint] = useState<RouteHint | null>(null);
+  const seqRef = useRef(0);
+  const busyRef = useRef(false);
+  const cacheRef = useRef<Map<string, DecideEnvelope | null>>(new Map());
+  // 被用户忽略过的建议指纹（text+mode），同一份草稿不再打扰
+  const dismissedRef = useRef<Set<string>>(new Set());
+
+  useEffect(() => {
+    const raw = String(text || '').trim();
+    const key = `${engineMode}\u0000${raw}`;
+    if (!enabled || !shouldProbe(raw)) {
+      setHint(null);
+      return;
+    }
+    if (dismissedRef.current.has(key)) {
+      setHint(null);
+      return;
+    }
+    let cancelled = false;
+    const timer = setTimeout(async () => {
+      if (busyRef.current) return; // 上一个探测还没回来：直接放弃本次（不发请求）
+      const decide = window.mjcode?.routerDecide;
+      if (typeof decide !== 'function') return;
+      const seq = ++seqRef.current;
+      busyRef.current = true;
+      try {
+        let res = cacheRef.current.get(raw);
+        if (res === undefined) {
+          res = (await decide({ text: raw, pageMode })) as DecideEnvelope;
+          cacheRef.current.set(raw, res || null);
+        }
+        if (cancelled || seq !== seqRef.current) return;
+        setHint(buildRouteHint(res, engineMode));
+      } catch {
+        // 路由不可用不该打扰用户：静默不出建议（失败原因在设置页「最近决策」里能查）
+        if (!cancelled && seq === seqRef.current) setHint(null);
+      } finally {
+        busyRef.current = false;
+      }
+    }, DEBOUNCE_MS);
+    return () => { cancelled = true; clearTimeout(timer); };
+  }, [text, engineMode, pageMode, enabled]);
+
+  function dismiss() {
+    const raw = String(text || '').trim();
+    if (raw) dismissedRef.current.add(`${engineMode}\u0000${raw}`);
+    setHint(null);
+  }
+
+  return { hint, dismiss };
+}
+
+export default useRouteHint;
diff --git a/desktop/renderer/src/hooks/useRunReattach.ts b/desktop/renderer/src/hooks/useRunReattach.ts
new file mode 100644
index 0000000..75bbc9e
--- /dev/null
+++ b/desktop/renderer/src/hooks/useRunReattach.ts
@@ -0,0 +1,98 @@
+// P0-9（2026-10-22）：渲染层 run 重连。
+// 背景：Agent 循环在主进程执行，渲染层刷新/重载后内存注册表（runRegistry/runIndex）被清空，
+// 用户回到会话只看到「什么都没发生」——既看不到在跑的 run，也无法中止它（孤儿 run 继续烧 token）。
+// 做法：挂载/切会话时向主进程查本会话在役 run；命中则把状态收养进 runRegistry（流式增量按
+// runId 重新挂钩），并以固定间隔探测终态；结束后清索引、刷新消息与线程列表。
+import { useEffect } from 'react';
+import { runRegistry, runIndex, makeRunState } from '../lib/runRegistry';
+import { api } from '../lib/api';
+
+// 2s 是「用户感知到结束」与「无谓 IPC 轮询」之间的折中：run 收尾本身已由主进程落库，
+// 这里只负责把 UI 从「运行中」复位；更短没有收益，更长会让用户以为卡死。
+const POLL_MS = 2000;
+
+type ActiveRun = { runId?: string; conversationId?: string; startedAt?: number };
+
+export default function useRunReattach(opts: {
+  threadId: string | number | null | undefined;
+  activeThreadIdRef: { current: string | null };
+  activeRunIdRef: { current: string | null };
+  setActiveRunId?: (v: string | null) => void;
+  setLoading: (v: boolean) => void;
+  setMessages: (v: any[]) => void;
+  onSettled?: () => void;
+}): void {
+  const {
+    threadId, activeThreadIdRef, activeRunIdRef, setActiveRunId, setLoading, setMessages, onSettled,
+  } = opts;
+  const threadKey = threadId == null ? '' : String(threadId);
+  useEffect(() => {
+    if (!threadKey) return;
+    let disposed = false;
+    // 本次收养的 runId（null = 尚未收养）。只收养一次：run 结束后不再自动重新收养，
+    // 否则「刚结束的 run」与「同一会话马上发起的新 run」会在轮询窗口内互相踩状态。
+    let adopted: string | null = null;
+    const isCurrent = () => activeThreadIdRef.current === threadKey;
+    const tick = async () => {
+      if (disposed) return;
+      if (typeof window.mjcode?.agentListActiveRuns !== 'function') return;
+      let list: ActiveRun[] = [];
+      try {
+        list = (await window.mjcode.agentListActiveRuns()) || [];
+      } catch {
+        return; // 查询失败不收养也不复位：宁可保持现状，也不误判「已结束」
+      }
+      if (!Array.isArray(list)) return;
+      const hit = list.find((r) => r?.runId && String(r.conversationId || '') === threadKey);
+      if (hit?.runId && !adopted) {
+        const local = runRegistry.get(threadKey);
+        // 本实例自己发起的 run（注册表已登记且在跑）不重复收养，只补挂流式索引。
+        if (local?.inFlight) {
+          adopted = local.runId;
+          runIndex.set(local.runId, local);
+          return;
+        }
+        const rs = makeRunState(hit.runId, threadKey);
+        rs.inFlight = true;
+        // applied=false：完成消息尚未进过可见列表（切走再回来时由既有补挂逻辑处理）
+        rs.applied = false;
+        rs.startedAt = Number(hit.startedAt) || Date.now();
+        adopted = hit.runId;
+        if (isCurrent()) {
+          activeRunIdRef.current = hit.runId;
+          setActiveRunId?.(hit.runId);
+          setLoading(true);
+        }
+        return;
+      }
+      if (!hit && adopted) {
+        const rs = runRegistry.get(threadKey);
+        if (rs) {
+          rs.inFlight = false;
+          rs.done = true;
+          rs.settledAt = Date.now();
+          runIndex.delete(rs.runId);
+        }
+        adopted = null;
+        if (isCurrent()) {
+          activeRunIdRef.current = null;
+          setActiveRunId?.(null);
+          setLoading(false);
+          try {
+            const msgs = await api.messages(threadId as any);
+            if (Array.isArray(msgs)) setMessages(msgs);
+          } catch { /* 刷新失败不阻塞：切会话时仍会按既有逻辑重新拉取 */ }
+          onSettled?.();
+        }
+      }
+    };
+    void tick();
+    const timer = setInterval(() => { void tick(); }, POLL_MS);
+    return () => {
+      disposed = true;
+      clearInterval(timer);
+    };
+    // 只随会话切换重建；refs 与 setter 均为稳定引用（useRef / useState setter）
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [threadKey]);
+}
