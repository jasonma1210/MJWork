+++ b/desktop/main/decisionSidecar.js
@@ -0,0 +1,241 @@
+'use strict';
+// 本地决策模型 sidecar（需求 1，2026-10-23）
+//
+// 职责边界（有意做窄）：
+//   · 只负责「把官方推理服务拉起来 + 健康检查 + 停掉」；
+//   · 不实现模型自己的决策 readout —— 方案 §1.2 已核实：d3 系列的决策逻辑在配套 Python 代码里，
+//     自拼 prompt 得不到正确结果，所以必须跑官方服务（默认 vLLM OpenAI 兼容 server）。
+//
+// fail-closed：Python / vLLM / 权重任一缺失都不假装可用——状态如实报 error 并附 stderr 尾部，
+// 路由层据此把决策降级回规则层（decide.js 的降级链路），不会静默返回错误结论。
+const fs = require('fs');
+const { spawn } = require('child_process');
+
+const LOG_TAIL_MAX = 40;
+const HEALTH_POLL_MS = 700;
+const HEALTH_WAIT_MS = 25000;
+
+let child = null;
+let sink = null;
+let pollTimer = null;
+let startedAt = 0;
+let state = {
+  status: 'stopped', // stopped | starting | running | error
+  pid: 0,
+  port: 0,
+  modelId: '',
+  modelDir: '',
+  error: '',
+  logTail: [],
+  health: null,
+};
+
+function setStatusSink(fn) {
+  sink = typeof fn === 'function' ? fn : null;
+}
+
+function emit() {
+  if (!sink) return;
+  try { sink(publicStatus()); } catch { /* 广播失败不影响进程 */ }
+}
+
+function publicStatus() {
+  return {
+    ...state,
+    logTail: state.logTail.slice(-LOG_TAIL_MAX),
+    command: state.command || '',
+  };
+}
+
+function log(line) {
+  const text = String(line || '').trim();
+  if (!text) return;
+  state.logTail.push(text.slice(0, 400));
+  if (state.logTail.length > LOG_TAIL_MAX) state.logTail.splice(0, state.logTail.length - LOG_TAIL_MAX);
+}
+
+/** 引号包裹路径（含空格 / 中文目录都能跑）；内部双引号转义 */
+function quote(p) {
+  return `"${String(p || '').replace(/"/g, '\\"')}"`;
+}
+
+/** 默认启动命令：vLLM 的 OpenAI 兼容 server（d3 系列是 Python 栈，node-llama-cpp 走不通） */
+function defaultCommand(local = {}) {
+  const py = local.pythonPath || 'python3';
+  const modelDir = local.modelDir || '';
+  const port = Number(local.port) || 18181;
+  const served = local.modelId || 'decision';
+  return `${py} -m vllm.entrypoints.openai.api_server --model ${quote(modelDir)}`
+    + ` --served-model-name ${served} --host 127.0.0.1 --port ${port} --trust-remote-code`;
+}
+
+function commandOf(local = {}) {
+  const custom = String(local.serveCommand || '').trim();
+  return custom || defaultCommand(local);
+}
+
+async function probeHealth(port, timeoutMs = 1500) {
+  const started = Date.now();
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), timeoutMs);
+  try {
+    const res = await fetch(`http://127.0.0.1:${port}/v1/models`, { signal: controller.signal });
+    if (!res.ok) return { ok: false, latencyMs: Date.now() - started, error: `HTTP ${res.status}` };
+    const json = await res.json().catch(() => ({}));
+    const models = Array.isArray(json && json.data) ? json.data.map((m) => m && m.id).filter(Boolean) : [];
+    return { ok: true, latencyMs: Date.now() - started, models };
+  } catch (e) {
+    return { ok: false, latencyMs: Date.now() - started, error: String((e && e.message) || e) };
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+function stopPoll() {
+  if (pollTimer) clearTimeout(pollTimer);
+  pollTimer = null;
+}
+
+async function pollUntilHealthy(port) {
+  const deadline = Date.now() + HEALTH_WAIT_MS;
+  const tick = async () => {
+    pollTimer = null;
+    if (!child || state.status === 'stopped' || state.status === 'error') return;
+    const h = await probeHealth(port);
+    // 一次性写入（逐个赋值会各触发一次 require-atomic-updates）
+    Object.assign(state, { health: h });
+    if (h.ok) {
+      Object.assign(state, { status: 'running', error: '' });
+      emit();
+      return;
+    }
+    if (Date.now() > deadline) {
+      Object.assign(state, {
+        status: 'error',
+        error: `sidecar 启动超时（${Math.round(HEALTH_WAIT_MS / 1000)}s 内 /v1/models 未就绪）：${h.error || ''}`,
+      });
+      emit();
+      return;
+    }
+    pollTimer = setTimeout(tick, HEALTH_POLL_MS);
+  };
+  tick();
+}
+
+/**
+ * 启动 sidecar。立即返回（status=starting），健康状态经 statusSink 推送。
+ * @param {object} local decisionConfig 的 local 段
+ */
+function start(local = {}) {
+  if (child) return publicStatus();
+  const modelDir = String(local.modelDir || '').trim();
+  if (!modelDir) throw new Error('MODEL_DIR_MISSING：请先下载并选择一个本地决策模型');
+  if (!fs.existsSync(modelDir)) throw new Error(`MODEL_NOT_INSTALLED：目录不存在 ${modelDir}`);
+  if (local.licenseAccepted !== true) throw new Error('LICENSE_REQUIRED：请先接受 Apache-2.0 许可证');
+
+  const port = Number(local.port) || 18181;
+  const command = commandOf(local);
+  state = {
+    status: 'starting', pid: 0, port, modelId: local.modelId || 'decision',
+    modelDir, error: '', logTail: [], health: null, command,
+  };
+  startedAt = Date.now();
+  emit();
+
+  try {
+    child = spawn(command, {
+      shell: true,
+      env: { ...process.env, PYTHONUNBUFFERED: '1' },
+      stdio: ['ignore', 'pipe', 'pipe'],
+    });
+  } catch (e) {
+    child = null;
+    state.status = 'error';
+    state.error = `spawn 失败：${String((e && e.message) || e)}`;
+    emit();
+    return publicStatus();
+  }
+
+  state.pid = child.pid || 0;
+  emit();
+  child.stdout.on('data', (buf) => { String(buf).split('\n').forEach(log); });
+  child.stderr.on('data', (buf) => { String(buf).split('\n').forEach(log); });
+  child.on('error', (e) => {
+    state.status = 'error';
+    state.error = `无法启动：${String((e && e.message) || e)}（请检查 Python 路径与 vLLM 是否已安装）`;
+    emit();
+  });
+  child.on('exit', (code, signal) => {
+    const wasStopping = state.status === 'stopped';
+    child = null;
+    stopPoll();
+    if (!wasStopping) {
+      state.status = code === 0 ? 'stopped' : 'error';
+      state.error = code === 0 ? '' : `sidecar 退出（code=${code}${signal ? `, signal=${signal}` : ''}）：${state.logTail.slice(-3).join(' | ')}`;
+    }
+    state.health = null;
+    emit();
+  });
+
+  pollUntilHealthy(port);
+  return publicStatus();
+}
+
+function stop() {
+  stopPoll();
+  state.status = 'stopped';
+  state.error = '';
+  state.health = null;
+  emit();
+  if (!child) return { ok: true };
+  const proc = child;
+  child = null;
+  try { proc.kill('SIGTERM'); } catch { /* 已退出 */ }
+  setTimeout(() => {
+    try { proc.kill('SIGKILL'); } catch { /* 已退出 */ }
+  }, 2000).unref?.();
+  return { ok: true };
+}
+
+/** 健康检查（设置页「测试」按钮：不启动也能看连接状态） */
+async function health(port) {
+  const p = Number(port) || state.port || 18181;
+  const h = await probeHealth(p);
+  Object.assign(state, { health: h });
+  emit();
+  return h;
+}
+
+async function status() {
+  if (child && state.status === 'running') {
+    const h = await probeHealth(state.port);
+    Object.assign(state, { health: h });
+    if (h && h.ok === false && child) {
+      // 仍在跑但健康检查失败：保持 running + 暴露 error，让 UI 显示「进程在、接口不通」
+      Object.assign(state, { error: h.error || '' });
+    }
+  }
+  return publicStatus();
+}
+
+/** 开机/启动时按配置自动拉起（失败只记状态，不阻塞主进程） */
+function maybeAutoStart(config = {}) {
+  const local = config.local || {};
+  if (config.path !== 'local' || local.autoStart === false) return Promise.resolve(publicStatus());
+  if (!local.modelDir || !fs.existsSync(local.modelDir)) return Promise.resolve(publicStatus());
+  try {
+    return Promise.resolve(start(local));
+  } catch (e) {
+    state.status = 'error';
+    state.error = String((e && e.message) || e);
+    emit();
+    return Promise.resolve(publicStatus());
+  }
+}
+
+module.exports = {
+  start, stop, status, health, maybeAutoStart,
+  setStatusSink, defaultCommand, commandOf, probeHealth,
+  uptimeMs: () => (startedAt && state.status !== 'stopped' ? Date.now() - startedAt : 0),
+  _resetForTest: () => { stop(); state = { status: 'stopped', pid: 0, port: 0, modelId: '', modelDir: '', error: '', logTail: [], health: null }; startedAt = 0; },
+};
diff --git a/desktop/main/ipc/decision.js b/desktop/main/ipc/decision.js
new file mode 100644
index 0000000..f242120
--- /dev/null
+++ b/desktop/main/ipc/decision.js
@@ -0,0 +1,230 @@
+'use strict';
+// 本地决策模型 IPC 域（需求 1，2026-10-23）
+//
+// 与 `ipc/router.js`（router:* 六通道）分文件的两个理由：
+//   ① 职责不同：router:* 是「决策怎么走」，这里是「本地模型怎么装、怎么起」；
+//   ② 体量：下载/进程管理合计 9 条通道，塞进 router.js 会把它推过可读性拐点。
+//
+// 通道清单：
+//   decision:models:list       读：六档 d3 模型清单（含安装状态 / 体积 / 当前下载进度）
+//   decision:models:download   写：流式下载（**写通道**，需登记 GUARDED_CHANNELS）
+//   decision:models:cancel     写：取消当前下载
+//   decision:models:remove     写：删除已下载模型目录
+//   decision:sidecar:status    读：sidecar 进程状态 + 健康检查
+//   decision:sidecar:start     写：按 config.local 拉起本机推理服务
+//   decision:sidecar:stop      写：停止
+//   decision:sidecar:test      读（计算型）：探测端口 /v1/models，不启动进程
+//
+// 两条广播（单向，不是写通道）：
+//   decision:models:progress   下载进度事件
+//   decision:sidecar:status    进程状态变化事件
+const { ipcMain, BrowserWindow } = require('electron');
+const guard = require('./payloadGuard');
+const decisionConfig = require('../decisionConfig');
+const decisionModels = require('../decisionModels');
+const decisionSidecar = require('../decisionSidecar');
+const { LOCAL_PROVIDER_ID, LOCAL_DEFAULT_PORT } = require('../router/decide');
+
+/** 广播给所有窗口（与 emitTaskEvent / emitTeamsEvent 同款；窗口销毁后静默跳过） */
+function broadcast(channel, payload) {
+  let wins = [];
+  try { wins = BrowserWindow.getAllWindows(); } catch { return; }
+  for (const w of wins) {
+    try { if (!w.isDestroyed()) w.webContents.send(channel, payload); } catch { /* 窗口已销毁 */ }
+  }
+}
+
+/**
+ * 本地 sidecar 的非流式对话通道（OpenAI 兼容，**无鉴权**）。
+ *
+ * 为什么不能复用 `scheduledAgentChat`：那条通道第一步就是 `resolveSecret(providerId)`，
+ * 拿不到 api_key 直接抛 KEY_MISSING。本地 sidecar 是本机 127.0.0.1 上的进程，没有也不需要 Key，
+ * 因此这里单起一条极窄的直连实现——只做「发请求 → 取 content」，不碰配额/凭证/重试。
+ *
+ * @param {{providerId?: string, model: string, baseUrl?: string, messages: any[], temperature?: number,
+ *          top_p?: number, max_tokens?: number, reasoning_effort?: string}} payload
+ * @param {{signal?: AbortSignal}} opts
+ */
+async function localSidecarChat(payload = {}, opts = {}) {
+  const root = String(payload.baseUrl || '').replace(/\/+$/, '')
+    || `http://127.0.0.1:${LOCAL_DEFAULT_PORT}/v1`;
+  const body = { model: payload.model || 'decision', messages: payload.messages || [], stream: false };
+  if (Number.isFinite(Number(payload.temperature))) body.temperature = Number(payload.temperature);
+  if (Number.isFinite(Number(payload.top_p))) body.top_p = Number(payload.top_p);
+  if (Number.isFinite(Number(payload.max_tokens))) body.max_tokens = Math.round(Number(payload.max_tokens));
+
+  const external = opts.signal || null;
+  if (external && external.aborted) return { content: '', aborted: true };
+  // 兜底超时（30s）：即使调用方没传 signal，也不会把一条请求永远挂在这里
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), 30000);
+  const signal = (external && typeof AbortSignal.any === 'function')
+    ? AbortSignal.any([controller.signal, external])
+    : controller.signal;
+  try {
+    const res = await fetch(`${root}/chat/completions`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify(body),
+      signal,
+    });
+    if (external && external.aborted) return { content: '', aborted: true };
+    if (!res.ok) throw new Error(`本地决策服务 HTTP ${res.status}: ${(await res.text().catch(() => '')).slice(0, 200)}`);
+    const j = await res.json();
+    const choice = (j.choices && j.choices[0]) || {};
+    const msg = choice.message || {};
+    return {
+      content: msg.content || '',
+      usage: j.usage ? { prompt_tokens: j.usage.prompt_tokens || 0, completion_tokens: j.usage.completion_tokens || 0 } : null,
+      finish_reason: choice.finish_reason || null,
+    };
+  } catch (e) {
+    if (external && external.aborted) return { content: '', aborted: true };
+    if (controller.signal.aborted) throw Object.assign(new Error('本地决策服务响应超时（30s）'), { code: 'ABORTED' });
+    throw e;
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+/**
+ * L3 层分派：本地 providerId 走直连，其余保持原样透传给既有模型通道。
+ * decide.js 只认 `remoteChat(payload, opts)`，分派就在这里收口，路由层不需要知道 Key 的事。
+ */
+function makeL3Chat(chatOnce) {
+  return async function l3Chat(payload = {}, opts = {}) {
+    if (payload && payload.providerId === LOCAL_PROVIDER_ID) return localSidecarChat(payload, opts);
+    if (typeof chatOnce !== 'function') throw new Error('REMOTE_CHANNEL_MISSING');
+    return chatOnce(payload, opts);
+  };
+}
+
+/**
+ * @param {{audit?: Function, chatOnce?: Function}} deps
+ */
+function initDecisionIpc(deps = {}) {
+  const audit = typeof deps.audit === 'function' ? deps.audit : null;
+  const chatOnce = typeof deps.chatOnce === 'function' ? deps.chatOnce : null;
+
+  // 进度 / 状态一律单向广播：渲染层不轮询，避免 2s 一次 IPC 抖动
+  decisionModels.setProgressSink((evt) => broadcast('decision:models:progress', evt));
+  decisionSidecar.setStatusSink((st) => broadcast('decision:sidecar:status', st));
+
+  const readLocalConfig = () => (decisionConfig.readConfigSync().config || {}).local || {};
+
+  // ── 读：模型清单 ──
+  ipcMain.handle('decision:models:list', async () => {
+    try {
+      return { ok: true, root: decisionModels.modelsRoot(), models: decisionModels.list(), activeId: decisionModels.activeId() };
+    } catch (e) {
+      return { ok: false, error: String((e && e.message) || e) };
+    }
+  });
+
+  // ── 写：下载 ──
+  ipcMain.handle('decision:models:download', async (_, payload) => {
+    try {
+      const p = guard.assertObject(payload || {}, 'payload');
+      guard.assertIdLike(p, ['modelId']);
+      guard.assertObject(p.opts || {}, 'opts');
+      const res = await decisionModels.download(p.modelId, { licenseAccepted: p.opts && p.opts.licenseAccepted === true });
+      if (audit) {
+        try {
+          audit('decision.models:download', p.modelId, { bytes: res.bytes, dir: res.dir }, 'auto');
+        } catch { /* 审计失败不影响结果 */ }
+      }
+      return { ok: true, ...res };
+    } catch (e) {
+      return { ok: false, error: String((e && e.message) || e), code: (e && e.code) || '' };
+    }
+  });
+
+  // ── 写：取消下载 ──
+  ipcMain.handle('decision:models:cancel', async (_, payload) => {
+    try {
+      const p = guard.assertObject(payload || {}, 'payload');
+      guard.assertIdLike(p, ['modelId']);
+      return { ok: true, ...decisionModels.cancel() };
+    } catch (e) {
+      return { ok: false, error: String((e && e.message) || e) };
+    }
+  });
+
+  // ── 写：删除模型 ──
+  ipcMain.handle('decision:models:remove', async (_, payload) => {
+    try {
+      const p = guard.assertObject(payload || {}, 'payload');
+      guard.assertIdLike(p, ['modelId']);
+      const res = await decisionModels.remove(p.modelId);
+      if (audit) {
+        try { audit('decision.models:remove', p.modelId, { dir: res.dir }, 'auto'); } catch { /* 忽略 */ }
+      }
+      return { ok: true, ...res };
+    } catch (e) {
+      return { ok: false, error: String((e && e.message) || e) };
+    }
+  });
+
+  // ── 读：sidecar 状态（会顺带探活一次） ──
+  ipcMain.handle('decision:sidecar:status', async () => {
+    try {
+      return { ok: true, status: await decisionSidecar.status(), uptimeMs: decisionSidecar.uptimeMs() };
+    } catch (e) {
+      return { ok: false, error: String((e && e.message) || e) };
+    }
+  });
+
+  // ── 写：启动 ──
+  // 目录 / 端口 / 许可证都取 decision.json 的 local 段：设置页先 router:config:set 再点启动，
+  // 这样进程参数与配置永远同源，不会出现「界面显示 A、实际跑 B」。
+  ipcMain.handle('decision:sidecar:start', async () => {
+    try {
+      const local = readLocalConfig();
+      const st = decisionSidecar.start(local);
+      if (audit) {
+        try { audit('decision.sidecar:start', String(local.modelId || 'decision'), { port: local.port, dir: local.modelDir }, 'auto'); } catch { /* 忽略 */ }
+      }
+      return { ok: true, status: st };
+    } catch (e) {
+      return { ok: false, error: String((e && e.message) || e) };
+    }
+  });
+
+  // ── 写：停止 ──
+  ipcMain.handle('decision:sidecar:stop', async () => {
+    try {
+      const res = decisionSidecar.stop();
+      if (audit) {
+        try { audit('decision.sidecar:stop', 'sidecar', {}, 'auto'); } catch { /* 忽略 */ }
+      }
+      return { ok: true, ...res };
+    } catch (e) {
+      return { ok: false, error: String((e && e.message) || e) };
+    }
+  });
+
+  // ── 读（计算型）：只探活，不启动 ──
+  ipcMain.handle('decision:sidecar:test', async (_, payload) => {
+    try {
+      const p = guard.assertObject(payload || {}, 'payload');
+      const port = Number(p.port) || Number(readLocalConfig().port) || LOCAL_DEFAULT_PORT;
+      const h = await decisionSidecar.health(port);
+      return { ok: h.ok === true, port, ...h };
+    } catch (e) {
+      return { ok: false, error: String((e && e.message) || e) };
+    }
+  });
+
+  // 自启：读 decision.json 不需要 app ready，但拉起子进程应等窗口/数据库初始化完成，
+  // 否则首次启动会和它们抢 CPU。失败只记录状态（静默 catch），不影响应用启动。
+  try {
+    const { app } = require('electron');
+    const ready = app && typeof app.whenReady === 'function' ? app.whenReady() : Promise.resolve();
+    ready.then(() => decisionSidecar.maybeAutoStart(decisionConfig.readConfigSync().config || {}))
+      .catch(() => { /* 自启失败不影响应用 */ });
+  } catch { /* 非 electron 宿主（单测）直接跳过 */ }
+
+  return { l3Chat: makeL3Chat(chatOnce) };
+}
+
+module.exports = { initDecisionIpc, localSidecarChat, makeL3Chat };
diff --git a/desktop/main/ipc/router.js b/desktop/main/ipc/router.js
