+                className="w-full bg-input border border-border rounded-lg px-3 py-2 text-sm outline-none focus:border-accent"
+              >
+                <option value="">{t('settings.routerProviderPlaceholder')}</option>
+                {providers.map((p) => (
+                  <option key={String(p.id)} value={String(p.id)}>{p.name || String(p.id)}</option>
