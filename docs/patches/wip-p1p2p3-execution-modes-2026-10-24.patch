--- /dev/null
+++ b/desktop/shared/pricing.mjs
@@ -0,0 +1,181 @@
+// 分时计价纯函数（需求 4 增强，2026-10-23）
+//
+// 为什么单独成文件：同一套「按时间轴取价」既要在渲染层结算费用，也要能被 Node 单测直接
+// import（modelConfig.js 依赖 i18n 与 localStorage，测试跑不起来）。这里零依赖、零副作用，
+// 与 `shared/engineMode.mjs` 同款：主进程/渲染层/测试共用一份，口径不会漂。
+//
+// 口径（与设置页文案一致）：
+//   · tiers[{ from, to, input, output, label }]，from/to 为 HH:MM **本地时间**，按「每百万 token」计价；
+//   · from > to 表示跨零点（如 22:30-08:30）；
+//   · 未命中任何时段 → 用基础 input/output；命中 → 用时段价（时段价缺失项回落基础价在上层归一化时完成）；
+//   · 一次运行的 token 视为在 [from, to] 内**均匀发生**，按档位边界切段分别计价——
+//     这样「忙时开始、闲时结束」的跨档运行不会整单按其中一个档位算错。
+
+const DAY_MIN = 1440;
+/** 窗口跨度上限（天）：超过则退化为「按窗口中点取一个档位」，避免切段数与日期数一起膨胀 */
+const MAX_SPAN_DAYS = 8;
+
+function num(v) {
+  const n = Number(v);
+  return Number.isFinite(n) && n > 0 ? n : 0;
+}
+
+export function hhmmToMin(s) {
+  const m = String(s || '').trim().match(/^(\d{1,2}):(\d{2})$/);
+  if (!m) return null;
+  const h = Number(m[1]);
+  const mi = Number(m[2]);
+  if (h > 23 || mi > 59) return null;
+  return h * 60 + mi;
+}
+
+export function minToHhmm(v) {
+  const n = Math.max(0, Math.min(DAY_MIN - 1, Math.round(Number(v) || 0)));
+  return `${String(Math.floor(n / 60)).padStart(2, '0')}:${String(n % 60).padStart(2, '0')}`;
+}
+
+/**
+ * 时段是否命中某一分钟（跨零点区间拆成「≥from 或 <to」）。
+ * @param {{from:number,to:number}} tier 分钟值
+ * @param {number} minute 当前分钟（0-1439）
+ */
+export function tierHitsMinute(from, to, minute) {
+  if (from == null || to == null) return false;
+  return from <= to ? (minute >= from && minute < to) : (minute >= from || minute < to);
+}
+
+/**
+ * 当前时刻生效的单价。未配置 → null。命中时段 → 时段价，否则基础价。
+ * @param {{currency?:string,input?:number,output?:number,tiers?:Array}} pricing
+ * @param {number} at 毫秒时间戳
+ */
+export function activeRateAt(pricing, at = Date.now()) {
+  if (!pricing || typeof pricing !== 'object') return null;
+  const tiers = Array.isArray(pricing.tiers) ? pricing.tiers : [];
+  const baseInput = num(pricing.input);
+  const baseOutput = num(pricing.output);
+  if (!baseInput && !baseOutput && !tiers.length) return null;
+  const currency = pricing.currency === 'USD' ? 'USD' : 'CNY';
+
+  const d = new Date(at);
+  if (Number.isNaN(d.getTime())) return null;
+  const minute = d.getHours() * 60 + d.getMinutes();
+  for (const t of tiers) {
+    const from = hhmmToMin(t && t.from);
+    const to = hhmmToMin(t && t.to);
+    if (!tierHitsMinute(from, to, minute)) continue;
+    const ti = num(t.input) || baseInput;
+    const toPrice = num(t.output) || baseOutput;
+    if (!ti && !toPrice) continue;
+    return { input: ti, output: toPrice, currency, label: String(t.label || '') };
+  }
+  if (!baseInput && !baseOutput) return null;
+  return { input: baseInput, output: baseOutput, currency, label: '' };
+}
+
+/** 单点计价（一次请求的已知用量，按调用时刻取价） */
+export function costAtRate(rate, tokensIn, tokensOut) {
+  if (!rate) return null;
+  const cost = ((Number(tokensIn) || 0) * rate.input + (Number(tokensOut) || 0) * rate.output) / 1e6;
+  return { cost, currency: rate.currency, label: rate.label || '' };
+}
+
+/** 收集窗口内所有档位边界（含跨零点区间的两端），按天展开后排序去重 */
+function boundariesInWindow(pricing, fromMs, toMs) {
+  const pts = new Set([fromMs, toMs]);
+  const tiers = pricing && Array.isArray(pricing.tiers) ? pricing.tiers : [];
+  const start = new Date(fromMs);
+  const cursor = new Date(start.getFullYear(), start.getMonth(), start.getDate(), 0, 0, 0, 0);
+  let guard = 0;
+  while (cursor.getTime() <= toMs && guard <= MAX_SPAN_DAYS) {
+    const dayStart = cursor.getTime();
+    for (const t of tiers) {
+      const f = hhmmToMin(t && t.from);
+      const e = hhmmToMin(t && t.to);
+      for (const m of [f, e]) {
+        if (m == null) continue;
+        const at = dayStart + m * 60000;
+        if (at > fromMs && at < toMs) pts.add(at);
+      }
+    }
+    cursor.setDate(cursor.getDate() + 1);
+    guard += 1;
+  }
+  return Array.from(pts).sort((a, b) => a - b);
+}
+
+/**
+ * 按时间轴加权计价：token 视为在 [fromMs, toMs] 内均匀发生，跨档位切段分别计价。
+ *
+ * @param {{currency?:string,input?:number,output?:number,tiers?:Array}} pricing
+ * @param {number} tokensIn 提示 token
+ * @param {number} tokensOut 生成 token
+ * @param {{from?:number,to?:number,at?:number}} span 运行起止（缺省退化为单点 at）
+ * @returns {{cost:number,currency:string,label:string,mixed:boolean,
+ *            segments:Array<{from:number,to:number,rate:object,tokensIn:number,tokensOut:number}>}|null}
+ */
+export function costForWindow(pricing, tokensIn, tokensOut, span = {}) {
+  const fromRaw = Number(span.from);
+  const toRaw = Number(span.to);
+  const atRaw = Number(span.at);
+  const hasSpan = Number.isFinite(fromRaw) && Number.isFinite(toRaw) && toRaw > fromRaw;
+  const fromMs = hasSpan ? fromRaw : (Number.isFinite(atRaw) ? atRaw : Date.now());
+  const toMs = hasSpan ? toRaw : fromMs;
+  const totalIn = Number(tokensIn) || 0;
+  const totalOut = Number(tokensOut) || 0;
+
+  // 无跨度（单点请求）或跨度过长：直接按单点/中点取价，不做切段
+  if (!hasSpan || toMs - fromMs > MAX_SPAN_DAYS * 86400000) {
+    const rate = activeRateAt(pricing, hasSpan ? fromMs + (toMs - fromMs) / 2 : fromMs);
+    const single = costAtRate(rate, totalIn, totalOut);
+    if (!single) return null;
+    return {
+      ...single,
+      mixed: false,
+      segments: [{ from: fromMs, to: toMs, rate, tokensIn: totalIn, tokensOut: totalOut }],
+    };
+  }
+
+  const pts = boundariesInWindow(pricing, fromMs, toMs);
+  const totalMs = toMs - fromMs;
+  const segments = [];
+  let cost = 0;
+  let currency = 'CNY';
+  let label = '';
+  const labels = new Set();
+  for (let i = 0; i < pts.length - 1; i += 1) {
+    const a = pts[i];
+    const b = pts[i + 1];
+    const dur = b - a;
+    if (dur <= 0) continue;
+    const rate = activeRateAt(pricing, a + dur / 2);
+    if (!rate) continue;
+    const share = dur / totalMs;
+    const segIn = totalIn * share;
+    const segOut = totalOut * share;
+    const seg = costAtRate(rate, segIn, segOut);
+    cost += seg.cost;
+    currency = rate.currency;
+    if (rate.label) labels.add(rate.label);
+    label = rate.label || label;
+    segments.push({ from: a, to: b, rate, tokensIn: segIn, tokensOut: segOut });
+  }
+  if (!segments.length) return null;
+  const mixed = segments.length > 1;
+  return {
+    cost,
+    currency,
+    // 跨档时 label 用「A + B」如实呈现，单档时就是该档名称
+    label: mixed ? Array.from(labels).join(' + ') : label,
+    mixed,
+    segments,
+  };
+}
+
+export function fmtMoney(cost, currency = 'CNY') {
+  const sym = currency === 'USD' ? '$' : '¥';
+  const v = Number(cost) || 0;
+  if (v <= 0) return `${sym}0`;
+  if (v < 0.01) return `${sym}${v.toFixed(4)}`;
+  return `${sym}${v.toFixed(2)}`;
+}
