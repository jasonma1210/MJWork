+++ b/desktop/test/router-rules.test.mjs
@@ -0,0 +1,155 @@
+// P1-2：决策路由 L0/L1 规则层验收（60 条标注样本）
+//
+// 验收口径来自方案 §12 的 P1-2：
+//   · 规则层覆盖率 ≥ 50%（规则给出结论且与标注一致）；
+//   · 误判率 ≤ 3%（规则给出结论但与标注不一致）。
+//
+// 为什么用「标注样本 + 比例门禁」而不是逐条断言：规则词典一定会随用户措辞漂移，
+// 逐条硬编码会让任何一次词典微调都变成 60 处失败；比例门禁守住的是「整体判断力不退化」。
+// 同时保留逐条输出，便于看清是哪条样本掉出了覆盖。
+import rules from '../main/router/rules.js';
+
+let pass = 0;
+let total = 0;
+function check(name, fn) {
+  total++;
+  try { fn(); console.log(`[PASS] ${name}`); pass++; }
+  catch (e) { console.error(`[FAIL] ${name} — ${e.message}`); process.exitCode = 1; }
+}
+
+// 标注：expect 是「人认为应该走哪个模式」；null 表示「规则层判不出也没关系」（交给远程/兜底）。
+// 注意：expect 为 chat 但规则返回 null 的样本**不算误判**，只算未覆盖。
+const SAMPLES = [
+  // ── 对话类 ──
+  { text: '你好', expect: 'chat' },
+  { text: '在吗？', expect: 'chat' },
+  { text: '收到', expect: 'chat' },
+  { text: 'ok', expect: 'chat' },
+  { text: 'thanks', expect: 'chat' },
+  { text: '这段代码是什么意思？', expect: 'chat' },
+  { text: '什么是闭包？', expect: 'chat' },
+  { text: '为什么这里会报错？', expect: 'chat' },
+  { text: '这个类有哪些方法？', expect: 'chat' },
+  { text: '这套接口怎么用？', expect: 'chat' },
+  { text: '把这句话翻译成英文', expect: 'chat' },
+  { text: '润色一下这段文字', expect: 'chat' },
+  { text: '帮我总结一下这篇文章', expect: 'chat' },
+  { text: '解释一下这个函数的作用', expect: 'chat' },
+  { text: '这个文件里有什么', expect: 'chat' },
+  { text: '这个函数是做什么的', expect: 'chat' },
+  { text: '读一下这个脚本', expect: 'chat' },
+  { text: '这个变量的默认值是多少', expect: 'chat' },
+  { text: '请解释一下这个概念', expect: 'chat' },
+  { text: '这段文字帮我润色一下', expect: 'chat' },
+  { text: '翻译成中文', expect: 'chat' },
+  { text: '这个脚本能不能跑？', expect: 'chat' },
+  // 对话型目标（团队「报数」类）
+  { text: '报数', expect: 'chat' },
+  { text: '每个人轮流说一句', expect: 'chat' },
+  { text: '大家各说一句', expect: 'chat' },
+  { text: '一人一句自我介绍', expect: 'chat' },
+
+  // ── 团队类 ──
+  { text: '帮我把这个架构方案评审一下，产品和技术各出意见', expect: 'team' },
+  { text: '组织一次红队评审，找出方案漏洞', expect: 'team' },
+  { text: '两位工程师互相 review 一下这段设计', expect: 'team' },
+  { text: '这个方案需要多方意见，帮我论证可行性', expect: 'team' },
+  { text: '让产品和设计分别给出评审意见', expect: 'team' },
+  { text: '请产品、技术、运营三方讨论后给结论', expect: 'team' },
+  { text: '让三位专家辩论一下这个方案', expect: 'team' },
+  { text: '各自出一份方案，再比较优劣', expect: 'team' },
+
+  // ── 自动拆解类 ──
+  { text: '调研三个竞品的定价策略，分别整理，最后汇总成一页对比', expect: 'auto' },
+  { text: '先把数据库迁移做完，再补测试，最后更新文档', expect: 'auto' },
+  { text: '并行处理这三个模块的改造', expect: 'auto' },
+  { text: '同时调研 A 和 B 两个方案的优劣', expect: 'auto' },
+  { text: '分析这三份日志并汇总成一份报告', expect: 'auto' },
+  { text: '把整个项目升级到新的构建工具', expect: 'auto' },
+  { text: '分成两个阶段推进：设计阶段和实现阶段', expect: 'auto' },
+  { text: '拆成三个步骤：先分析、再实现、然后验证', expect: 'auto' },
+  { text: '研究一下竞品并整理成对比表', expect: 'auto' },
+  { text: '并行改造多个模块', expect: 'auto' },
+  { text: '同时处理多个文件', expect: 'auto' },
+  { text: '先梳理接口，再实现，最后补文档', expect: 'auto' },
+
+  // ── 规则判不出（允许未覆盖，但绝不能误判成 auto/team）──
+  { text: '帮我写一个快速排序', expect: 'chat' },
+  { text: '修复登录页的 bug', expect: 'chat' },
+  { text: '生成一张架构图', expect: 'chat' },
+  { text: '部署到服务器', expect: 'chat' },
+  { text: '重构这段代码', expect: 'chat' },
+  { text: '帮我看看这个报错', expect: 'chat' },
+  { text: '优化一下数据库索引', expect: 'chat' },
+  { text: '写个脚本把图片压缩', expect: 'chat' },
+  { text: '给我的项目加个 README', expect: 'chat' },
+  { text: '这段 SQL 是不是很慢', expect: 'chat' },
+  { text: '帮我想个名字', expect: 'chat' },
+  { text: '数据库连接池怎么配置', expect: 'chat' },
+  { text: '讲个笑话', expect: 'chat' },
+  { text: '你好，帮我订个会议室', expect: 'chat' },
+];
+
+check(`样本数为 60（当前 ${SAMPLES.length}）`, () => {
+  if (SAMPLES.length !== 60) throw new Error(`样本数应为 60，实际 ${SAMPLES.length}`);
+});
+
+const outcomes = SAMPLES.map((s) => {
+  const hit = rules.decideL1({ text: s.text });
+  return { ...s, got: hit ? hit.mode : null, ruleId: hit ? hit.ruleId : '' };
+});
+
+const covered = outcomes.filter((o) => o.got && o.got === o.expect);
+const mismatched = outcomes.filter((o) => o.got && o.got !== o.expect);
+
+check(`规则层覆盖率 ≥ 50%（${covered.length}/${SAMPLES.length}）`, () => {
+  const rate = covered.length / SAMPLES.length;
+  if (rate < 0.5) {
+    const misses = outcomes.filter((o) => !o.got).map((o) => o.text).join(' / ');
+    throw new Error(`覆盖率 ${(rate * 100).toFixed(1)}% 低于 50%；未命中样本：${misses}`);
+  }
+});
+
+check(`误判率 ≤ 3%（${mismatched.length}/${SAMPLES.length}）`, () => {
+  const rate = mismatched.length / SAMPLES.length;
+  if (rate > 0.03) {
+    throw new Error(`误判率 ${(rate * 100).toFixed(1)}% 超过 3%：${mismatched.map((m) => `${m.text}→${m.got}(期望 ${m.expect})`).join(' / ')}`);
+  }
+});
+
+// ── L0：显式信号必须 100% 生效，且优先级高于 L1 ──
+check('L0 手选模式硬覆盖（即使文本命中 auto 规则）', () => {
+  const hit = rules.decideL0({ text: '并行处理多个模块', explicitMode: 'chat' });
+  if (!hit || hit.mode !== 'chat' || hit.confidence !== 1) throw new Error('手选模式未硬覆盖');
+});
+
+check('L0 斜杠命令 /flow → auto、/team → team、/chat → chat', () => {
+  const flow = rules.decideL0({ text: '/flow 把这三个模块分别改一遍' });
+  const team = rules.decideL0({ text: '/team 帮我评审一下' });
+  const chat = rules.decideL0({ text: '/chat 解释一下闭包' });
+  if (!flow || flow.mode !== 'auto') throw new Error('/flow 未映射为 auto');
+  if (!team || team.mode !== 'team') throw new Error('/team 未映射为 team');
+  if (!chat || chat.mode !== 'chat') throw new Error('/chat 未映射为 chat');
+});
+
+check('L0 选中模板 → template；无模板 id 时不误判', () => {
+  const hit = rules.decideL0({ text: '写个周报', templateId: 'weekly' });
+  if (!hit || hit.mode !== 'template' || hit.confidence !== 1) throw new Error('模板信号未生效');
+  if (rules.decideL0({ text: '写个周报', templateId: '  ' })) throw new Error('空模板 id 不应触发 template');
+});
+
+check('L0 团队工作室入口 → team', () => {
+  const hit = rules.decideL0({ text: '帮我看下这个方案', entry: 'studio' });
+  if (!hit || hit.mode !== 'team') throw new Error('工作室入口未映射为 team');
+});
+
+check('L0 无信号时返回 null（交给 L1）', () => {
+  if (rules.decideL0({ text: '帮我写个排序' }) !== null) throw new Error('无信号不应产出决策');
+});
+
+// 逐条打印未命中样本，便于后续词典微调时定位（不影响门禁）
+const misses = outcomes.filter((o) => !o.got);
+if (misses.length) console.log(`[INFO] 未覆盖样本 ${misses.length} 条：${misses.map((m) => m.text).join(' / ')}`);
+
+console.log(`\nrouter-rules: ${pass}/${total} 通过（覆盖 ${covered.length}/60，误判 ${mismatched.length}/60）`);
+process.exit(pass === total ? 0 : 1);
diff --git a/desktop/test/router-schema.test.mjs b/desktop/test/router-schema.test.mjs
new file mode 100644
index 0000000..3fb4135
--- /dev/null
+++ b/desktop/test/router-schema.test.mjs
@@ -0,0 +1,154 @@
+// P1-1/P1-3：RouterDecision 校验与归一化（纯函数）
+//
+// 覆盖方案 §5.2 的最小必填集与 §5.7 的降级语义：
+//   · 非法 mode → chat + mode_invalid（不静默回落成别的模式）；
+//   · 全 0 / NaN / 缺项 → 不抛错，按 0 处理并记录错误码；
+//   · steps 超 8 → 保留 auto 但清空 steps（不截断）；
+//   · markdown 围栏与前后噪声 → 能抠出 JSON。
+import schema from '../main/router/schema.js';
+
+const {
+  normalizeDecision, extractJsonObject, confidencePolicy, fallbackDecision, emptyDecision, MAX_STEPS,
+} = schema;
+
+let pass = 0;
+let total = 0;
+function check(name, fn) {
+  total++;
+  try { fn(); console.log(`[PASS] ${name}`); pass++; }
+  catch (e) { console.error(`[FAIL] ${name} — ${e.message}`); process.exitCode = 1; }
+}
+
+check('合法决策原样通过（含 steps 与 budget_hint）', () => {
+  const raw = {
+    mode: 'auto',
+    confidence: 0.88,
+    task_brief: '竞品定价调研与汇总',
+    reason: '三个互不依赖的调研步骤加一个汇总步骤',
+    need_clarify: false,
+    steps: [
+      { id: 's1', title: '竞品A', action: '检索 A 的定价', depends_on: [] },
+      { id: 's2', title: '汇总', action: '基于 s1 输出对比', depends_on: ['s1'] },
+    ],
+    budget_hint: { class: 'medium', est_tokens: 40000 },
+  };
+  const { decision, errors } = normalizeDecision(raw);
+  if (errors.length) throw new Error(`不应有错误：${errors.join(',')}`);
+  if (decision.mode !== 'auto' || decision.steps.length !== 2) throw new Error('合法步骤被丢弃');
+  if (decision.steps[1].depends_on[0] !== 's1') throw new Error('依赖关系丢失');
+  if (!decision.budget_hint || decision.budget_hint.class !== 'medium') throw new Error('预算丢失');
+});
+
+check('markdown 围栏 + 前后解释文字能被抠出', () => {
+  const raw = '好的，结果如下：\n```json\n{"mode":"chat","confidence":0.9,"need_clarify":false}\n```\n以上。';
+  const { decision, errors } = normalizeDecision(raw);
+  if (errors.length) throw new Error(`不应有错误：${errors.join(',')}`);
+  if (decision.mode !== 'chat' || decision.confidence !== 0.9) throw new Error('围栏内 JSON 未正确解析');
+});
+
+check('完全无 JSON → json_invalid 且不抛错', () => {
+  const { decision, errors } = normalizeDecision('我觉得应该拆一下');
+  if (!errors.includes('json_invalid')) throw new Error('未标记 json_invalid');
+  if (decision.mode !== 'chat') throw new Error('非法输出应回落 chat');
+});
+
+check('非法 mode → 按 chat 执行并记 mode_invalid', () => {
+  const { decision, errors } = normalizeDecision({ mode: 'multi-agent', confidence: 0.9 });
+  if (!errors.includes('mode_invalid')) throw new Error('未标记 mode_invalid');
+  if (decision.mode !== 'chat') throw new Error('非法 mode 应回落 chat');
+});
+
+check('confidence 全 0 / NaN / 缺项都被收敛到 [0,1]', () => {
+  const zero = normalizeDecision({ mode: 'chat', confidence: 0, need_clarify: false });
+  if (zero.decision.confidence !== 0) throw new Error('0 被改写');
+
+  const nan = normalizeDecision({ mode: 'chat', confidence: NaN, need_clarify: false });
+  if (!nan.errors.includes('confidence_invalid')) throw new Error('NaN 未标记');
+  if (nan.decision.confidence !== 0) throw new Error('NaN 未收敛为 0');
+
+  const missing = normalizeDecision({ mode: 'chat', need_clarify: false });
+  if (!missing.errors.includes('confidence_missing')) throw new Error('缺项未标记');
+  if (missing.decision.confidence !== 0) throw new Error('缺项未收敛为 0');
+
+  const over = normalizeDecision({ mode: 'chat', confidence: 2.5, need_clarify: false });
+  if (over.decision.confidence !== 1) throw new Error('超界未收敛为 1');
+});
+
+check('steps 超过 8 → 保留 auto 且清空（不截断）', () => {
+  const steps = Array.from({ length: MAX_STEPS + 1 }, (_, i) => ({
+    id: `s${i + 1}`, title: `t${i}`, action: 'a', depends_on: [],
+  }));
+  const { decision, errors } = normalizeDecision({ mode: 'auto', confidence: 0.8, need_clarify: false, steps });
+  if (!errors.includes('steps_too_many')) throw new Error('未标记 steps_too_many');
+  if (decision.mode !== 'auto') throw new Error('mode 不应被改写');
+  if (decision.steps.length !== 0) throw new Error('超限步骤未被清空');
+});
+
+check('非法 step id / 未知依赖被剔除并标记', () => {
+  const { decision, errors } = normalizeDecision({
+    mode: 'auto',
+    confidence: 0.8,
+    need_clarify: false,
+    steps: [
+      { id: 'x1', title: 'bad', action: 'a', depends_on: [] },
+      { id: 's1', title: 'ok', action: 'a', depends_on: ['s9'] },
+    ],
+  });
+  if (!errors.some((e) => e.includes('bad_id'))) throw new Error('非法 id 未标记');
+  if (!errors.includes('steps_s1_dep_unknown')) throw new Error('未知依赖未标记');
+  if (decision.steps.length !== 1 || decision.steps[0].depends_on.length !== 0) throw new Error('步骤清理不正确');
+});
+
+check('chat 模式携带 steps 时直接丢弃（不报错）', () => {
+  const { decision, errors } = normalizeDecision({
+    mode: 'chat', confidence: 0.9, need_clarify: false,
+    steps: [{ id: 's1', title: 't', action: 'a', depends_on: [] }],
+  });
+  if (decision.steps.length !== 0) throw new Error('chat 不应保留 steps');
+  if (errors.length) throw new Error(`不应报错：${errors.join(',')}`);
+});
+
+check('need_clarify=true 缺问题 → 补默认追问文案', () => {
+  const { decision } = normalizeDecision({ mode: 'chat', confidence: 0.4, need_clarify: true });
+  if (!decision.clarify_question) throw new Error('未补默认追问');
+});
+
+check('budget_hint 非法 class → 丢弃并标记', () => {
+  const { decision, errors } = normalizeDecision({
+    mode: 'chat', confidence: 0.9, need_clarify: false, budget_hint: { class: 'huge', est_tokens: 100 },
+  });
+  if (!errors.includes('budget_class_invalid')) throw new Error('非法 class 未标记');
+  if (decision.budget_hint !== null) throw new Error('非法预算未被丢弃');
+});
+
+check('extractJsonObject 对非对象 / 空串返回 null', () => {
+  if (extractJsonObject('') !== null) throw new Error('空串应返回 null');
+  if (extractJsonObject('[]') !== null) throw new Error('数组应返回 null');
+  if (extractJsonObject(null) !== null) throw new Error('null 应返回 null');
+});
+
+check('置信度策略三档与方案 §5.6 一致', () => {
+  const params = { confidenceThreshold: 0.75, clarifyBand: [0.55, 0.75] };
+  if (confidencePolicy({ mode: 'chat', confidence: 0.9, need_clarify: false }, params).action !== 'execute') {
+    throw new Error('高置信度应为 execute');
+  }
+  if (confidencePolicy({ mode: 'auto', confidence: 0.6, need_clarify: false }, params).action !== 'suggest') {
+    throw new Error('中置信度应为 suggest');
+  }
+  if (confidencePolicy({ mode: 'auto', confidence: 0.3, need_clarify: false }, params).action !== 'clarify') {
+    throw new Error('低置信度应为 clarify');
+  }
+  if (confidencePolicy({ mode: 'auto', confidence: 0.99, need_clarify: true }, params).action !== 'clarify') {
+    throw new Error('need_clarify 应优先于高置信度');
+  }
+});
+
+check('兜底决策恒为 chat 且置信度低', () => {
+  const d = fallbackDecision('测试');
+  if (d.mode !== 'chat' || d.confidence > 0.3) throw new Error('兜底决策不符合预期');
+  const e = emptyDecision();
+  if (e.mode !== 'chat' || e.steps.length !== 0) throw new Error('空决策形状不正确');
+});
+
+console.log(`\nrouter-schema: ${pass}/${total} 通过`);
+process.exit(pass === total ? 0 : 1);
diff --git a/desktop/test/workflow-store.test.mjs b/desktop/test/workflow-store.test.mjs
new file mode 100644
index 0000000..e5e287f
--- /dev/null
+++ b/desktop/test/workflow-store.test.mjs
@@ -0,0 +1,111 @@
+// P2-1/P2-2 模板实体测试（sql.js 驱动）：迁移 / CRUD / 结构校验 / 预览 / 运行期确定性
+// .mjs 走 ESM，被测实现是 CJS —— 统一 createRequire 引入（与其它 .mjs 套件同款）。
+import { createRequire } from 'node:module';
+const require = createRequire(import.meta.url);
+const fs = require('fs');
+const path = require('path');
+const os = require('os');
+const { openDbAsync, MIGRATIONS } = require('../main/db');
+const { WorkflowStore } = require('../main/workflowStore');
+
+let pass = 0;
+let fail = 0;
+function check(name, ok, detail = '') {
+  if (ok) { pass++; console.log(`✅ ${name}${detail ? ` — ${detail}` : ''}`); }
+  else { fail++; console.log(`❌ ${name}${detail ? ` — ${detail}` : ''}`); }
+}
+
+const TASKS = [
+  { id: 'collect', title: '收集', prompt: '收集资料', dependsOn: [] },
+  { id: 'compare', title: '对比', prompt: '对比分析', dependsOn: ['collect'] },
+  { id: 'report', title: '汇总', prompt: '产出报告', dependsOn: ['compare'], critical: true },
+];
+
+(async () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'mjcode-workflows-'));
+  const db = await openDbAsync(dir, { driver: 'sqljs' });
+  const store = new WorkflowStore(db);
+
+  // ── 迁移 v16 ──
+  const v16 = MIGRATIONS.find((m) => m.version === 16);
+  check('迁移 v16 workflow-templates 存在', !!v16 && v16.name === 'workflow-templates');
+
+  // ── 内置模板（开箱即用）──
+  const builtins = store.list().filter((t) => t.builtin);
+  check('内置模板已播种（≥2 条）', builtins.length >= 2, `实际 ${builtins.length}`);
+  check('内置模板任务清单非空且依赖闭合', builtins.every((t) => t.tasks.length >= 2
+    && t.tasks.every((x) => (x.dependsOn || []).every((d) => t.tasks.some((y) => y.id === d)))));
+
+  // ── 创建 ──
+  const created = store.create({
+    name: '我的模板',
+    description: '三步走',
+    goal: '默认目标',
+    tasks: TASKS,
+    budget: { max_rounds: 6, max_tokens: 120000, max_wall_ms: 900000 },
+    toolWhitelist: ['read_file', 'write_file', 'read_file'],
+  });
+  check('创建模板成功', created.ok === true && !!created.template);
+  const id = created.template && created.template.templateId;
+  check('模板 id 前缀 wt-', typeof id === 'string' && id.startsWith('wt-'));
+  check('任务清单原样落库（顺序/id/依赖）', JSON.stringify(created.template.tasks.map((t) => t.id)) === JSON.stringify(['collect', 'compare', 'report'])
+    && JSON.stringify(created.template.tasks[1].dependsOn) === JSON.stringify(['collect']));
+  check('预算按三键归一', created.template.budget.max_rounds === 6 && created.template.budget.max_tokens === 120000 && created.template.budget.max_wall_ms === 900000);
+  check('工具白名单去重', JSON.stringify(created.template.toolWhitelist) === JSON.stringify(['read_file', 'write_file']));
+
+  // ── 合法性校验（复用 validateDag：字段/依赖/环）──
+  check('缺 prompt 拒绝', store.create({ name: 'x', tasks: [{ id: 'a', title: 'A' }] }).ok === false);
+  check('依赖不存在拒绝', store.create({ name: 'x', tasks: [{ id: 'a', title: 'A', prompt: 'p', dependsOn: ['zz'] }, { id: 'b', title: 'B', prompt: 'p' }] }).ok === false);
+  check('环依赖拒绝', store.create({
+    name: 'x',
+    tasks: [
+      { id: 'a', title: 'A', prompt: 'p', dependsOn: ['b'] },
+      { id: 'b', title: 'B', prompt: 'p', dependsOn: ['a'] },
+    ],
+  }).ok === false);
+  check('单步模板合法（min=1）', store.create({ name: '一步', tasks: [{ id: 'only', title: '单步', prompt: 'p' }] }).ok === true);
+  check('空名称拒绝', store.create({ name: '  ', tasks: TASKS }).ok === false);
+  check('超过 8 个任务拒绝', store.create({
+    name: 'x',
+    tasks: Array.from({ length: 9 }, (_, i) => ({ id: `t${i}`, title: `T${i}`, prompt: 'p' })),
+  }).ok === false);
+
+  // ── 更新 ──
+  const updated = store.update(id, { name: '改名后', tasks: TASKS.slice(0, 2) });
+  check('更新名称与任务清单', updated.ok && updated.template.name === '改名后' && updated.template.tasks.length === 2);
+  check('未提供的字段保持不变', updated.template.goal === '默认目标' && updated.template.budget.max_rounds === 6);
+  check('更新不存在的模板拒绝', store.update('wt-nope', { name: 'x' }).ok === false);
+
+  // ── 预览（P2-4 / P2-6）──
+  const preview = store.preview(id);
+  check('预览返回分层与步骤', preview.ok && preview.levels.length === 2 && preview.steps.length === 2);
+  check('预览步骤带序号与负责人占位', preview.steps[0].index === 1 && preview.steps[0].ownerLabel === '主 Agent');
+  check('预览无悬空依赖', preview.dangling.length === 0);
+
+  // ── 确定性（P2-2）：同一模板两次取出的任务清单逐字节一致 ──
+  const a = JSON.stringify(store.presetTasksFor(id));
+  const b = JSON.stringify(store.presetTasksFor(id));
+  check('同一模板两次取出任务清单完全一致', a === b && a.length > 10);
+
+  // ── 删除 ──
+  const del = store.delete(id);
+  check('删除成功且不可再查', del.ok && store.get(id) === null);
+  check('删除不存在的模板拒绝', store.delete(id).ok === false);
+  check('删除后列表不含该模板', store.list().every((t) => t.templateId !== id));
+
+  // ── 运行引用（模板删除后历史 run 仍可读：template_ref 只是字符串）──
+  // 用 TaskStore 建组而不是手写 INSERT：顺带验证 createGroup 的 templateRef 落库路径（P2-2 接线）。
+  const { TaskStore } = require('../main/taskStore');
+  const taskStore = new TaskStore(db);
+  taskStore.createGroup({
+    groupId: 'g-tpl', goal: '目标', cwd: '', tasks: TASKS.slice(0, 2), engineMode: 'template', templateRef: 'wt-deleted',
+  });
+  const group = taskStore.getGroup('g-tpl');
+  check('模板删除后运行组引用仍可读', group && group.template_ref === 'wt-deleted' && group.engine_mode === 'template');
+
+  console.log(`\nworkflow-store: ${pass} 通过 / ${fail} 失败`);
+  process.exit(fail === 0 ? 0 : 1);
+})().catch((e) => {
+  console.error('[workflow-store] 测试异常：', e);
+  process.exit(1);
+});
