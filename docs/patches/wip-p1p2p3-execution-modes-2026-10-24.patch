@@ -0,0 +1,109 @@
+// 组织页的两个表单弹窗（2026-10-23 需求 5）
+//
+// 从 TeamsPage.tsx 抽出的原因：需求 5 新增「编辑成员档案」与「顶部派单」两个弹窗，
+// 直接写在页面里会把 TeamsPage 推过 800 行黄线（单文件行数阈值）。
+// 两者都是**纯受控表单**（值 + onChange + 提交由页面持有），不持有任何业务状态，
+// 因此抽到独立文件不改变语义，只缩短页面文件。
+import Modal from './ui/Modal';
+import Button from './ui/Button';
+import { Field } from './TeamMemberModal';
+
+type TFunc = (key: string, params?: Record<string, string | number>) => string;
+
+export function EditMemberModal(props: {
+  t: TFunc;
+  name: string;
+  prompt: string;
+  busy: boolean;
+  onName: (v: string) => void;
+  onPrompt: (v: string) => void;
+  onClose: () => void;
+  onSave: () => void;
+}) {
+  const { t, name, prompt, busy, onName, onPrompt, onClose, onSave } = props;
+  return (
+    <Modal
+      open
+      onClose={onClose}
+      title={t('teams.editMemberTitle')}
+      size="md"
+      footer={(
+        <>
+          <Button variant="secondary" size="md" onClick={onClose}>{t('teams.cancel')}</Button>
+          <Button size="md" loading={busy} onClick={onSave}>{t('teams.save')}</Button>
+        </>
+      )}
+    >
+      <div className="space-y-3">
+        <Field label={t('teams.memberNameLabel')} required>
+          <input
+            value={name}
+            onChange={(e) => onName(e.target.value)}
+            maxLength={60}
+            className="w-full h-8 px-3 rounded-lg bg-input text-sm"
+          />
+        </Field>
+        <Field label={t('teams.memberPromptLabel')} hint={t('teams.memberPromptHint')}>
+          <textarea
+            value={prompt}
+            onChange={(e) => onPrompt(e.target.value)}
+            rows={4}
+            maxLength={12000}
+            placeholder={t('teams.memberPromptPlaceholder')}
+            className="w-full px-3 py-2 rounded-lg bg-input text-sm resize-none"
+          />
+        </Field>
+      </div>
+    </Modal>
+  );
+}
+
+export function DispatchModal(props: {
+  t: TFunc;
+  teams: Array<{ id: string; name: string }>;
+  teamId: string;
+  goal: string;
+  busy: boolean;
+  onTeam: (v: string) => void;
+  onGoal: (v: string) => void;
+  onClose: () => void;
+  onSubmit: () => void;
+}) {
+  const { t, teams, teamId, goal, busy, onTeam, onGoal, onClose, onSubmit } = props;
+  return (
+    <Modal
+      open
+      onClose={onClose}
+      title={t('teams.dispatchTop')}
+      size="md"
+      footer={(
+        <>
+          <Button variant="secondary" size="md" onClick={onClose}>{t('teams.cancel')}</Button>
+          <Button size="md" loading={busy} onClick={onSubmit}>{t('teams.dispatchSubmit')}</Button>
+        </>
+      )}
+    >
+      <div className="space-y-3">
+        <Field label={t('teams.orgLabel')} required>
+          <select
+            value={teamId}
+            onChange={(e) => onTeam(e.target.value)}
+            className="w-full h-8 px-3 rounded-lg bg-input text-sm"
+          >
+            {teams.map((x) => <option key={x.id} value={x.id}>{x.name}</option>)}
+          </select>
+        </Field>
+        <Field label={t('teams.dispatchGoalLabel')} required>
+          <textarea
+            value={goal}
+            onChange={(e) => onGoal(e.target.value)}
+            rows={3}
+            maxLength={4000}
+            placeholder={t('teams.dispatchGoalPlaceholder')}
+            className="w-full px-3 py-2 rounded-lg bg-input text-sm resize-none"
+          />
+        </Field>
+      </div>
+    </Modal>
+  );
+}
diff --git a/desktop/renderer/src/components/RunHistoryDrawer.tsx b/desktop/renderer/src/components/RunHistoryDrawer.tsx
new file mode 100644
index 0000000..1f0df44
--- /dev/null
+++ b/desktop/renderer/src/components/RunHistoryDrawer.tsx
@@ -0,0 +1,192 @@
+// P2-5（2026-10-23）：运行记录抽屉——按执行模式 / 模板筛选，带 token 与耗时。
+//
+// 入口刻意做成「触发器 + 弹层」同文件，并挂在既有顶栏里：不新增一级导航，
+// 也不新增页面。数据源单一（task_groups 的 engine_mode / template_ref 落库列，
+// 由 workflows:runs 投影），不在渲染层从 dag 猜模式。
+import { useEffect, useState } from 'react';
+import { useI18n } from '../i18n';
+import Button from './ui/Button';
+import Modal from './ui/Modal';
+import { IconClock, IconSpinner } from './icons';
+import WorkflowTemplateModal from './WorkflowTemplateModal';
+
+interface WorkflowRun {
+  groupId?: string;
+  goal?: string;
+  engineMode?: string;
+  templateRef?: string | null;
+  templateName?: string | null;
+  status?: string;
+  taskCount?: number;
+  doneCount?: number;
+  failedCount?: number;
+  tokens?: number;
+  durationMs?: number;
+  createdAt?: number;
+  error?: string | null;
+}
+
+interface TemplateRef {
+  templateId: string;
+  name: string;
+}
+
+type ModeFilter = 'all' | 'auto' | 'template' | 'team';
+
+const MODE_FILTERS: { id: ModeFilter; key: string }[] = [
+  { id: 'all', key: 'workflow.runsFilterAll' },
+  { id: 'auto', key: 'workflow.runsModeAuto' },
+  { id: 'template', key: 'workflow.runsModeTemplate' },
+  { id: 'team', key: 'workflow.runsModeTeam' },
+];
+
+function modeLabelKey(mode: string | undefined): string {
+  if (mode === 'template') return 'workflow.runsModeTemplate';
+  if (mode === 'team') return 'workflow.runsModeTeam';
+  return 'workflow.runsModeAuto';
+}
+
+export interface RunHistoryDrawerProps {
+  threadId?: string | null;
+}
+
+export default function RunHistoryDrawer({ threadId }: RunHistoryDrawerProps) {
+  const { t } = useI18n();
+  const [open, setOpen] = useState(false);
+  const [runs, setRuns] = useState<WorkflowRun[]>([]);
+  const [templates, setTemplates] = useState<TemplateRef[]>([]);
+  const [filter, setFilter] = useState<ModeFilter>('all');
+  const [templateRef, setTemplateRef] = useState('');
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState('');
+  const [detailId, setDetailId] = useState<string | null>(null);
+
+  // 模板下拉：只用于筛选与「详情」，模板被删不影响历史 run 展示
+  useEffect(() => {
+    let cancelled = false;
+    (async () => {
+      try {
+        const r = (await window.mjcode?.workflowsList?.()) as
+          { ok?: boolean; templates?: { templateId: string; name: string }[] } | undefined;
+        if (!cancelled && r?.ok && Array.isArray(r.templates)) setTemplates(r.templates);
+      } catch (err) {
+        console.warn('[workflow] run history template list failed:', err);
+      }
+    })();
+    return () => { cancelled = true; };
+  }, []);
+
+  useEffect(() => {
+    if (!open || !threadId) return undefined;
+    let cancelled = false;
+    setLoading(true);
+    setError('');
+    (async () => {
+      try {
+        const payload: Record<string, unknown> = { threadId, limit: 20 };
+        if (filter !== 'all') payload.engineMode = filter;
+        if (templateRef) payload.templateRef = templateRef;
+        const r = (await window.mjcode?.workflowsRuns?.(payload)) as
+          { ok?: boolean; runs?: WorkflowRun[]; error?: string } | undefined;
+        if (cancelled) return;
+        if (!r?.ok) { setRuns([]); setError(String(r?.error || t('workflow.runsLoadFailed'))); return; }
+        setRuns(Array.isArray(r.runs) ? r.runs : []);
+      } catch (err) {
+        if (!cancelled) { setRuns([]); setError(String((err as Error)?.message || err)); }
+      } finally {
+        if (!cancelled) setLoading(false);
+      }
+    })();
+    return () => { cancelled = true; };
+  }, [open, threadId, filter, templateRef, t]);
+
+  return (
+    <>
+      <Button
+        size="xs"
+        variant="ghost"
+        disabled={!threadId}
+        onClick={() => setOpen(true)}
+        title={t('workflow.runsOpen')}
+        aria-label={t('workflow.runsOpen')}
+      >
+        <IconClock size={14} />
+      </Button>
+      <Modal open={open} onClose={() => setOpen(false)} title={t('workflow.runsTitle')} size="lg">
+        <div className="space-y-3">
+          <div className="flex items-center gap-2 flex-wrap">
+            {MODE_FILTERS.map((m) => (
+              <Button
+                key={m.id}
+                size="xs"
+                variant={filter === m.id ? 'secondary' : 'ghost'}
+                aria-pressed={filter === m.id}
+                onClick={() => setFilter(m.id)}
+              >
+                {t(m.key)}
+              </Button>
+            ))}
+            <select
+              value={templateRef}
+              onChange={(e) => setTemplateRef(e.target.value)}
+              className="ml-auto h-6 rounded bg-surface border border-border px-1 text-xs text-text max-w-[180px]"
+              aria-label={t('workflow.templatePlaceholder')}
+            >
+              <option value="">{t('workflow.runsFilterAll')}</option>
+              {templates.map((x) => (
+                <option key={x.templateId} value={x.templateId}>{x.name}</option>
+              ))}
+            </select>
+          </div>
+
+          {loading && (
+            <div className="flex items-center gap-2 text-xs text-text2">
+              <IconSpinner size={14} /> {t('workflow.runsLoading')}
+            </div>
+          )}
+          {!loading && error && <p className="text-caption text-danger">{error}</p>}
+          {!loading && !error && runs.length === 0 && (
+            <p className="text-xs text-text2">{t('workflow.runsEmpty')}</p>
+          )}
+
+          {!loading && !error && runs.length > 0 && (
+            <div className="space-y-2">
+              {runs.map((run) => {
+                const total = Number(run.taskCount) || 0;
+                const done = Number(run.doneCount) || 0;
+                const failed = Number(run.failedCount) || 0;
+                const tokens = Number(run.tokens) || 0;
+                const seconds = `${Math.round((Number(run.durationMs) || 0) / 1000)}s`;
+                return (
+                  <div key={String(run.groupId || '')} className="rounded-lg border border-border bg-surface px-3 py-2">
+                    <div className="flex items-center gap-2 flex-wrap">
+                      <span className="text-caption px-2 rounded bg-raise text-text2">{t(modeLabelKey(run.engineMode))}</span>
+                      {run.templateName && <span className="text-caption text-text2 truncate">{run.templateName}</span>}
+                      {run.createdAt ? (
+                        <span className="text-caption text-text2">{new Date(run.createdAt).toLocaleString()}</span>
+                      ) : null}
+                      {run.templateRef && (
+                        <Button size="xs" variant="ghost" className="ml-auto" onClick={() => setDetailId(String(run.templateRef))}>
+                          {t('workflow.detail')}
+                        </Button>
+                      )}
+                    </div>
+                    <div className="mt-1 text-xs text-text truncate" title={String(run.goal || '')}>{String(run.goal || '')}</div>
+                    <div className="mt-1 flex items-center gap-3 flex-wrap text-caption text-text2">
+                      <span>{t('workflow.runsProgress', { done, total })}</span>
+                      <span>{t('workflow.runsTokens', { n: tokens })}</span>
+                      <span>{t('workflow.runsDuration', { s: seconds })}</span>
+                      {failed > 0 && <span className="text-danger">{t('workflow.runsFailed', { n: failed })}</span>}
+                    </div>
+                    {run.error && <div className="mt-1 text-caption text-danger truncate" title={run.error}>{run.error}</div>}
+                  </div>
+                );
+              })}
+            </div>
+          )}
+        </div>
+      </Modal>
+      <WorkflowTemplateModal open={!!detailId} onClose={() => setDetailId(null)} templateId={detailId} />
+    </>
+  );
+}
diff --git a/desktop/renderer/src/components/WorkflowPlanCard.tsx b/desktop/renderer/src/components/WorkflowPlanCard.tsx
new file mode 100644
index 0000000..81111c6
--- /dev/null
+++ b/desktop/renderer/src/components/WorkflowPlanCard.tsx
@@ -0,0 +1,82 @@
+// P2-6（2026-10-23）：对话内「先看拆解，再执行」的计划预览卡。
+//
+// 语义：这张卡出现时**还没有建任何 task_group**（auto 走 tasks:plan({dryRun:true})，
+// template 走 workflows:preview）——用户点「取消」即什么都不产生，符合「取消不建 run」。
+// 视觉沿用对话页的任务卡片（bg-surface + border + rounded-xl），不引入新模态。
+import { useI18n } from '../i18n';
+import Button from './ui/Button';
+import type { WorkflowPlan } from '../lib/dispatchTemplateRun';
+
+export interface WorkflowPlanCardProps {
+  plan: WorkflowPlan;
+  busy?: boolean;
+  error?: string;
+  onConfirm?: () => void;
+  onCancel?: () => void;
+}
+
+function budgetText(t: ReturnType<typeof useI18n>['t'], plan: WorkflowPlan): string {
+  const budget = plan.budget;
+  if (!budget) return t('workflow.planNoBudget');
+  const tokens = Number(budget.max_tokens) || 0;
+  const minutes = Math.round((Number(budget.max_wall_ms) || 0) / 60000);
+  return t('workflow.planBudget', { tokens, minutes });
+}
+
+export default function WorkflowPlanCard({ plan, busy = false, error = '', onConfirm, onCancel }: WorkflowPlanCardProps) {
+  const { t } = useI18n();
+  const byId = new Map(plan.steps.map((s) => [s.id, s]));
+  const levels = plan.levels.length ? plan.levels : [plan.steps.map((s) => s.id)];
+
+  return (
+    <div className="mb-2 rounded-xl border border-border bg-surface p-3">
+      <div className="flex items-center gap-2 flex-wrap">
+        <span className="text-xs font-medium text-text">{t('workflow.planTitle')}</span>
+        <span className="text-caption text-text2">
+          {plan.mode === 'template'
+            ? t('workflow.planTemplate', { name: plan.templateName || plan.templateId || '' })
+            : t('workflow.planModeAuto')}
+        </span>
+        <span className="text-caption text-text2">{t('workflow.planSteps', { n: plan.steps.length })}</span>
+        <span className="text-caption text-text2">{budgetText(t, plan)}</span>
+        <div className="ml-auto flex items-center gap-2">
+          <Button size="xs" variant="ghost" disabled={busy} onClick={onCancel}>{t('workflow.cancel')}</Button>
+          <Button size="xs" variant="primary" loading={busy} onClick={onConfirm}>{t('workflow.confirmRun')}</Button>
+        </div>
+      </div>
+
+      <div className="mt-2 space-y-2">
+        {levels.map((ids, i) => (
+          <div key={`level-${i}`} className="flex items-start gap-2">
+            <span className="shrink-0 text-caption text-text2 tabular-nums pt-1 w-14">
+              {t('workflow.levelLabel', { n: i + 1 })}
+            </span>
+            <div className="flex-1 min-w-0 space-y-1">
+              {ids.map((id) => {
+                const step = byId.get(id);
+                if (!step) return null;
+                return (
+                  <div key={id} className="rounded-lg border border-border bg-bg px-2 py-2">
+                    <div className="flex items-center gap-2">
+                      <span className="text-xs text-text truncate">{step.title}</span>
+                    </div>
+                    <div className="text-caption text-text2 truncate">
+                      {t('workflow.stepOwner', { owner: t('workflow.ownerMain') })}
+                      <span className="mx-1">·</span>
+                      {step.dependsOn.length
+                        ? t('workflow.stepDeps', { deps: step.dependsOn.join(', ') })
+                        : t('workflow.stepNoDeps')}
+                    </div>
+                    <div className="text-caption text-text2 truncate" title={step.prompt}>{step.prompt}</div>
+                  </div>
+                );
+              })}
+            </div>
+          </div>
+        ))}
+      </div>
+
+      {error && <p className="mt-2 text-caption text-danger">{error}</p>}
+    </div>
+  );
+}
diff --git a/desktop/renderer/src/components/WorkflowTemplateModal.tsx b/desktop/renderer/src/components/WorkflowTemplateModal.tsx
new file mode 100644
index 0000000..a7567b5
--- /dev/null
+++ b/desktop/renderer/src/components/WorkflowTemplateModal.tsx
@@ -0,0 +1,149 @@
+// P2-4（2026-10-23）：模板详情弹层——DAG 预览 / 每步负责人 / 预算与工具白名单。
+//
+// 数据源与「先看拆解」共用 workflows:preview 投影（主进程 workflowStore.preview），
+// 保证「弹层里看到的步骤」与「真正运行时建出来的组」同源，不做渲染层二次推导。
+//
+// 两个入口都复用本组件：输入框 pill 的「详情」按钮、运行记录行的「详情」。
+import { useEffect, useState } from 'react';
+import { useI18n } from '../i18n';
+import Modal from './ui/Modal';
+import { IconSpinner } from './icons';
+import type { WorkflowPlanBudget } from '../lib/dispatchTemplateRun';
+
+interface PreviewStep {
+  id?: string;
+  title?: string;
+  prompt?: string;
+  dependsOn?: string[];
+}
+
+interface PreviewData {
+  name: string;
+  description: string;
+  goal: string;
+  levels: string[][];
+  steps: PreviewStep[];
+  budget: WorkflowPlanBudget | null;
+  toolWhitelist: string[];
+}
+
+export interface WorkflowTemplateModalProps {
+  open: boolean;
+  onClose: () => void;
+  templateId?: string | null;
+}
+
+export default function WorkflowTemplateModal({ open, onClose, templateId }: WorkflowTemplateModalProps) {
+  const { t } = useI18n();
+  const [data, setData] = useState<PreviewData | null>(null);
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState('');
+
+  useEffect(() => {
+    if (!open) return undefined;
+    const id = String(templateId || '').trim();
+    if (!id) { setData(null); setError(t('workflow.templateRequired')); return undefined; }
+    let cancelled = false;
+    setLoading(true);
+    setError('');
+    (async () => {
+      try {
+        const r = (await window.mjcode?.workflowsPreview?.(id)) as
+          | {
+              ok?: boolean;
+              error?: string;
+              template?: {
+                name?: string; description?: string; goal?: string;
+                budget?: WorkflowPlanBudget | null; toolWhitelist?: string[];
+              };
+              levels?: unknown;
+              steps?: PreviewStep[];
+            }
+          | undefined;
+        if (cancelled) return;
+        if (!r?.ok || !r.template) {
+          setData(null);
+          setError(String(r?.error || t('workflow.previewFailed')));
+          return;
+        }
+        const steps = Array.isArray(r.steps) ? r.steps : [];
+        const levels = Array.isArray(r.levels) && r.levels.length
+          ? (r.levels as unknown[]).map((l) => (Array.isArray(l) ? l.map(String) : []))
+          : [steps.map((s, i) => String(s?.id || `t${i + 1}`))];
+        setData({
+          name: String(r.template.name || ''),
+          description: String(r.template.description || ''),
+          goal: String(r.template.goal || ''),
+          levels,
+          steps,
+          budget: r.template.budget || null,
+          toolWhitelist: Array.isArray(r.template.toolWhitelist) ? r.template.toolWhitelist : [],
+        });
+      } catch (err) {
+        if (!cancelled) setError(String((err as Error)?.message || err));
+      } finally {
+        if (!cancelled) setLoading(false);
+      }
+    })();
+    return () => { cancelled = true; };
+  }, [open, templateId, t]);
+
+  const byId = new Map((data?.steps || []).map((s, i) => [String(s?.id || `t${i + 1}`), s]));
+  const budgetLabel = data?.budget
+    ? t('workflow.planBudget', {
+        tokens: Number(data.budget.max_tokens) || 0,
+        minutes: Math.round((Number(data.budget.max_wall_ms) || 0) / 60000),
+      })
+    : t('workflow.planNoBudget');
+
+  return (
+    <Modal open={open} onClose={onClose} title={data?.name || t('workflow.detail')} size="lg">
+      {loading && (
+        <div className="flex items-center gap-2 text-xs text-text2">
+          <IconSpinner size={14} /> {t('workflow.runsLoading')}
+        </div>
+      )}
+      {!loading && error && <p className="text-caption text-danger">{error}</p>}
+      {!loading && !error && data && (
+        <div className="space-y-3">
+          {data.description && <p className="text-xs text-text2">{data.description}</p>}
+          <div className="flex items-center gap-4 flex-wrap text-caption text-text2">
+            <span className="flex items-center gap-1">
+              <span>{t('workflow.budgetLabel')}</span>
+              <span>{budgetLabel}</span>
+            </span>
+            <span className="flex items-center gap-1">
+              <span>{t('workflow.toolsLabel')}</span>
+              <span>{data.toolWhitelist.length ? data.toolWhitelist.join(', ') : t('workflow.toolsNone')}</span>
+            </span>
+          </div>
+          <div className="space-y-2">
+            {data.levels.map((ids, li) => (
+              <div key={`lv-${li}`} className="flex items-start gap-2">
+                <span className="shrink-0 text-caption text-text2 pt-1 w-14">{t('workflow.levelLabel', { n: li + 1 })}</span>
+                <div className="flex-1 min-w-0 space-y-2">
+                  {ids.map((id) => {
+                    const step = byId.get(id);
+                    if (!step) return null;
+                    const deps = Array.isArray(step.dependsOn) ? step.dependsOn : [];
+                    return (
+                      <div key={id} className="rounded-lg border border-border bg-surface px-3 py-2">
+                        <div className="text-xs text-text">{String(step.title || id)}</div>
+                        <div className="mt-1 text-caption text-text2">
+                          {t('workflow.stepOwner', { owner: t('workflow.ownerMain') })}
+                          <span className="mx-1">·</span>
+                          {deps.length ? t('workflow.stepDeps', { deps: deps.join(', ') }) : t('workflow.stepNoDeps')}
+                        </div>
+                        <div className="mt-1 text-caption text-text2 whitespace-pre-wrap break-words">{String(step.prompt || '')}</div>
+                      </div>
+                    );
+                  })}
+                </div>
+              </div>
+            ))}
+          </div>
+        </div>
+      )}
+    </Modal>
+  );
+}
diff --git a/desktop/renderer/src/components/settings/RouterLocalPanel.tsx b/desktop/renderer/src/components/settings/RouterLocalPanel.tsx
new file mode 100644
index 0000000..8a597ed
--- /dev/null
+++ b/desktop/renderer/src/components/settings/RouterLocalPanel.tsx
@@ -0,0 +1,357 @@
+// ── 本地决策模型面板（需求 1，2026-10-23）──
+//
+// 从 RouterTab 拆出来的原因有两条：
+//   ① 职责边界：RouterTab 管「决策怎么走」，这里管「本地模型怎么装、怎么起」；
+//   ② 体量：下载进度 + 进程状态 + 六个参数项合计两百多行，塞回 RouterTab 会把它推过 800 行黄线。
+//
+// 交互约定：
+//   · 所有落盘（选择模型 / 许可证 / 端口 / 命令）都走父组件的 onSaveLocal → router:config:set，
+//     保证「界面显示」与「sidecar 实际使用的 decision.json」永远同源；
+//   · 下载 / 启停 / 测试是即时动作，不落配置，但启动前会先把当前参数存盘（否则 sidecar 读到旧端口）；
+//   · 两条事件流（下载进度 / 进程状态）都是单向订阅，卸载时必须退订，避免调试面板重复 setState。
+import { useEffect, useRef, useState } from 'react';
+import { useI18n } from '../../i18n';
+import { Input, Toggle } from './shared';
+import Button from '../ui/Button';
+
+export interface LocalConfig {
+  modelId: string;
+  modelDir: string;
+  pythonPath: string;
+  port: number;
+  autoStart: boolean;
+  licenseAccepted: boolean;
+  serveCommand: string;
+}
+
+export interface DecisionModelInfo {
+  id: string;
+  name: string;
+  params: string;
+  repo: string;
+  license: string;
+  hint: string;
+  dir: string;
+  installed: boolean;
+  sizeBytes: number;
+  download: { status: string; file: string; received: number; total: number; files: number; doneFiles: number } | null;
+}
+
+export interface SidecarStatus {
+  status: 'stopped' | 'starting' | 'running' | 'error';
+  pid: number;
+  port: number;
+  modelId: string;
+  modelDir: string;
+  error: string;
+  logTail: string[];
+  command: string;
+}
+
+interface Props {
+  local: LocalConfig;
+  /** 改内存态（不落盘） */
+  onPatch: (patch: Partial<LocalConfig>) => void;
+  /** 落盘（父组件写 decision.json 并回填规范化结果） */
+  onSaveLocal: (next: LocalConfig) => Promise<boolean>;
+}
+
+const STATUS_KEY: Record<string, string> = {
+  stopped: 'settings.routerLocalStatusStopped',
+  starting: 'settings.routerLocalStatusStarting',
+  running: 'settings.routerLocalStatusRunning',
+  error: 'settings.routerLocalStatusError',
+};
+
+function fmtSize(bytes: number): string {
+  if (!bytes || bytes < 0) return '—';
+  const gb = bytes / (1024 ** 3);
+  if (gb >= 1) return `${gb.toFixed(1)} GB`;
+  return `${(bytes / (1024 ** 2)).toFixed(0)} MB`;
+}
+
+export default function RouterLocalPanel({ local, onPatch, onSaveLocal }: Props) {
+  const { t } = useI18n();
+  const [models, setModels] = useState<DecisionModelInfo[]>([]);
+  const [root, setRoot] = useState('');
+  const [activeId, setActiveId] = useState('');
+  const [progress, setProgress] = useState<{ id: string; received: number; total: number; file: string } | null>(null);
+  const [sidecar, setSidecar] = useState<SidecarStatus | null>(null);
+  const [busy, setBusy] = useState('');
+  const [msg, setMsg] = useState('');
+  const [err, setErr] = useState('');
+  const alive = useRef(true);
+
+  async function refreshModels() {
+    const br = window.mjcode;
+    const res = await br?.decisionModelsList?.() as { ok: boolean; root?: string; models?: DecisionModelInfo[]; activeId?: string; error?: string } | undefined;
+    if (!alive.current || !res) return;
+    if (!res.ok) { setErr(res.error || ''); return; }
+    setModels(Array.isArray(res.models) ? res.models : []);
+    setRoot(res.root || '');
+    setActiveId(res.activeId || '');
+  }
+
+  async function refreshSidecar() {
+    const br = window.mjcode;
+    const res = await br?.decisionSidecarStatus?.() as { ok: boolean; status?: SidecarStatus; error?: string } | undefined;
+    if (!alive.current || !res) return;
+    if (res.ok && res.status) setSidecar(res.status);
+    else if (res.error) setErr(res.error);
+  }
+
+  useEffect(() => {
+    alive.current = true;
+    refreshModels();
+    refreshSidecar();
+    const br = window.mjcode;
+    const offProgress = br?.onDecisionModelProgress?.((evt: { type: string; id: string; received?: number; total?: number; file?: string; error?: string }) => {
+      if (!alive.current) return;
+      if (evt.type === 'progress') {
+        setProgress({ id: evt.id, received: evt.received || 0, total: evt.total || 0, file: evt.file || '' });
+      } else if (evt.type === 'error') {
+        setErr(evt.error || '');
+        setProgress(null);
+        setActiveId('');
+        refreshModels();
+      } else if (evt.type === 'done' || evt.type === 'removed') {
+        setProgress(null);
+        setActiveId('');
+        refreshModels();
+      }
+    });
+    const offStatus = br?.onDecisionSidecarStatus?.((st: SidecarStatus) => {
+      if (alive.current) setSidecar(st);
+    });
+    return () => {
+      alive.current = false;
+      if (typeof offProgress === 'function') offProgress();
+      if (typeof offStatus === 'function') offStatus();
+    };
+  }, []); // eslint-disable-line react-hooks/exhaustive-deps
+
+  async function download(m: DecisionModelInfo) {
+    if (!local.licenseAccepted) {
+      setErr(t('settings.routerLocalLicenseRequired'));
+      return;
+    }
+    setBusy(m.id);
+    setErr('');
+    setMsg('');
+    try {
+      const br = window.mjcode;
+      if (!br?.decisionModelDownload) throw new Error(t('settings.routerLocalChannelMissing'));
+      setActiveId(m.id);
+      const res = await br.decisionModelDownload({ modelId: m.id, opts: { licenseAccepted: true } }) as { ok: boolean; error?: string };
+      if (!alive.current) return;
+      if (!res.ok) setErr(res.error || '');
+      else setMsg(t('settings.routerLocalDownloadDone', { name: m.name }));
+    } catch (e) {
+      if (alive.current) setErr((e as Error).message || String(e));
+    } finally {
+      if (alive.current) { setBusy(''); setProgress(null); refreshModels(); }
+    }
+  }
+
+  async function cancel() {
+    try {
+      setBusy('cancel');
+      await window.mjcode?.decisionModelCancel?.({ modelId: activeId });
+    } catch (e) {
+      if (alive.current) setErr((e as Error).message || String(e));
+    } finally {
+      if (alive.current) setBusy('');
+    }
+  }
+
+  async function remove(m: DecisionModelInfo) {
+    setBusy(`rm:${m.id}`);
+    setErr('');
+    try {
+      const res = await window.mjcode?.decisionModelRemove?.({ modelId: m.id }) as { ok: boolean; error?: string } | undefined;
+      if (res && !res.ok) setErr(res.error || '');
+      await refreshModels();
+    } catch (e) {
+      if (alive.current) setErr((e as Error).message || String(e));
+    } finally {
+      if (alive.current) setBusy('');
+    }
+  }
+
+  async function choose(m: DecisionModelInfo) {
+    const next: LocalConfig = { ...local, modelId: 'decision', modelDir: m.dir };
+    onPatch({ modelId: 'decision', modelDir: m.dir });
+    setErr('');
+    const ok = await onSaveLocal(next);
+    setMsg(ok ? t('settings.routerLocalChosen', { name: m.name }) : '');
+  }
+
+  async function start() {
+    setBusy('start');
+    setErr('');
+    setMsg('');
+    try {
+      // 先落盘：sidecar 启动参数取 decision.json，内存态未保存会读到旧端口
+      const ok = await onSaveLocal(local);
+      if (!ok) return;
+      const res = await window.mjcode?.decisionSidecarStart?.() as { ok: boolean; status?: SidecarStatus; error?: string } | undefined;
+      if (res && !res.ok) setErr(res.error || '');
+      else if (res?.status) setSidecar(res.status);
+    } catch (e) {
+      if (alive.current) setErr((e as Error).message || String(e));
+    } finally {
+      if (alive.current) setBusy('');
+    }
+  }
+
+  async function stop() {
+    setBusy('stop');
+    try {
+      await window.mjcode?.decisionSidecarStop?.();
+      await refreshSidecar();
+    } catch (e) {
+      if (alive.current) setErr((e as Error).message || String(e));
+    } finally {
+      if (alive.current) setBusy('');
+    }
+  }
+
+  async function test() {
+    setBusy('test');
+    setErr('');
+    setMsg('');
+    try {
+      const res = await window.mjcode?.decisionSidecarTest?.({ port: local.port }) as { ok: boolean; latencyMs?: number; models?: string[]; error?: string } | undefined;
+      if (res && res.ok) setMsg(t('settings.routerLocalTestOk', { ms: res.latencyMs || 0, models: (res.models || []).join(', ') || '—' }));
+      else setErr((res && res.error) || t('settings.routerLocalTestFailed'));
+    } catch (e) {
+      if (alive.current) setErr((e as Error).message || String(e));
+    } finally {
+      if (alive.current) setBusy('');
+    }
+  }
+
+  const pct = progress && progress.total > 0 ? Math.min(100, Math.round((progress.received / progress.total) * 100)) : 0;
+
+  return (
+    <div>
+      <p className="text-xs text-text2 mb-3">{t('settings.routerLocalIntro')}</p>
+
+      <div className="flex items-center justify-between gap-4 py-3 border-t border-border">
+        <div className="min-w-0">
+          <div className="text-sm font-medium">{t('settings.routerLocalLicense')}</div>
+          <div className="text-xs text-text2 mt-1">{t('settings.routerLocalLicenseDesc')}</div>
+        </div>
+        <Toggle on={local.licenseAccepted} label={t('settings.routerLocalLicense')}
+          onChange={() => { onPatch({ licenseAccepted: !local.licenseAccepted }); setErr(''); }} />
+      </div>
+
+      <div className="py-3 border-t border-border">
+        <div className="text-sm font-medium mb-2">{t('settings.routerLocalModels')}</div>
+        <p className="text-xs text-text2 mb-2">{t('settings.routerLocalModelsDesc', { dir: root || local.modelDir || '~/.mjcode/decision-models' })}</p>
+        <ul className="space-y-2">
+          {models.map((m) => {
+            const chosen = !!local.modelDir && local.modelDir === m.dir;
+            const downloading = activeId === m.id || (m.download && m.download.status === 'downloading');
+            return (
+              <li key={m.id} className="rounded-xl border border-border px-3 py-2">
+                <div className="flex items-center gap-2">
+                  <span className="text-sm font-medium">{m.name}</span>
+                  <span className="text-xs text-text2">{m.params}</span>
+                  <span className="text-xs text-text2">· {m.license}</span>
+                  {m.installed
+                    ? <span className="text-xs text-accent">{t('settings.routerLocalInstalled')}</span>
+                    : <span className="text-xs text-text2">{t('settings.routerLocalNotInstalled')}</span>}
+                  {chosen && <span className="text-xs text-accent">· {t('settings.routerLocalSelected')}</span>}
+                </div>
+                <div className="mt-1 text-xs text-text2">
+                  {m.hint} · {t('settings.routerLocalSize')}: {m.installed ? fmtSize(m.sizeBytes) : '—'}
+                </div>
+                <div className="mt-2 flex items-center gap-2">
+                  {!m.installed && !downloading && (
+                    <Button onClick={() => download(m)} disabled={!!busy}>{t('settings.routerLocalDownload')}</Button>
+                  )}
+                  {downloading && (
+                    <>
+                      <span className="text-xs text-text2">
+                        {progress && progress.id === m.id
+                          ? `${t('settings.routerLocalDownloading')} ${pct}% · ${progress.file}`
+                          : t('settings.routerLocalPreparing')}
+                      </span>
+                      <Button variant="danger-ghost" size="xs" onClick={cancel}>{t('settings.routerLocalCancel')}</Button>
+                    </>
+                  )}
+                  {m.installed && (
+                    <>
+                      <Button onClick={() => choose(m)} disabled={!!busy || chosen}>{chosen ? t('settings.routerLocalSelected') : t('settings.routerLocalUse')}</Button>
+                      <Button variant="danger-ghost" size="xs" onClick={() => remove(m)} disabled={!!busy || local.modelDir === m.dir}>
+                        {t('settings.routerLocalRemove')}
+                      </Button>
+                    </>
+                  )}
+                </div>
+              </li>
+            );
+          })}
+        </ul>
+      </div>
+
+      <div className="py-3 border-t border-border">
+        <div className="text-sm font-medium mb-2">{t('settings.routerLocalRuntime')}</div>
+        <div className="grid grid-cols-2 gap-3">
+          <div>
+            <div className="text-xs text-text2 mb-1">{t('settings.routerLocalPython')}</div>
+            <Input value={local.pythonPath} placeholder="python3" onChange={(e) => onPatch({ pythonPath: e.target.value })} />
+          </div>
+          <div>
+            <div className="text-xs text-text2 mb-1">{t('settings.routerLocalPort')}</div>
+            <input type="number" min={1024} max={65535} value={local.port}
+              onChange={(e) => onPatch({ port: Number(e.target.value) })}
+              className="w-full bg-input border border-border rounded-lg px-3 py-2 text-sm outline-none focus:border-accent" />
+          </div>
+        </div>
+        <p className="mt-2 text-xs text-text2">{t('settings.routerLocalRuntimeDesc')}</p>
+        <div className="mt-3">
+          <div className="text-xs text-text2 mb-1">{t('settings.routerLocalServeCommand')}</div>
+          <Input value={local.serveCommand} placeholder={t('settings.routerLocalServeCommandPlaceholder')}
+            onChange={(e) => onPatch({ serveCommand: e.target.value })} />
+          <p className="mt-1 text-xs text-text2">{t('settings.routerLocalServeCommandDesc')}</p>
+        </div>
+        <div className="mt-3 flex items-center justify-between gap-4">
+          <div className="text-xs text-text2">{t('settings.routerLocalAutoStartDesc')}</div>
+          <Toggle on={local.autoStart} label={t('settings.routerLocalAutoStart')} onChange={() => onPatch({ autoStart: !local.autoStart })} />
+        </div>
+      </div>
+
+      <div className="py-3 border-t border-border">
+        <div className="flex items-center gap-2">
+          <span className="text-sm font-medium">{t('settings.routerLocalSidecar')}</span>
+          {sidecar && (
+            <span className={sidecar.status === 'running' ? 'text-xs text-accent' : sidecar.status === 'error' ? 'text-xs text-danger' : 'text-xs text-text2'}>
+              {t(STATUS_KEY[sidecar.status] || 'settings.routerLocalStatusStopped')}
+              {sidecar.pid ? ` · pid ${sidecar.pid}` : ''}{sidecar.port ? ` · :${sidecar.port}` : ''}
+            </span>
+          )}
+        </div>
+        <div className="mt-2 flex items-center gap-2">
+          <Button onClick={start} disabled={!!busy || !local.modelDir}>{busy === 'start' ? t('settings.routerSaving') : t('settings.routerLocalStart')}</Button>
+          <Button variant="ghost" size="xs" onClick={stop} disabled={!!busy}>{t('settings.routerLocalStop')}</Button>
+          <Button variant="accent-ghost" size="xs" onClick={test} disabled={!!busy}>
+            {busy === 'test' ? t('settings.routerTesting') : t('settings.routerLocalTest')}
+          </Button>
+          {!local.modelDir && <span className="text-xs text-text2">{t('settings.routerLocalNoModel')}</span>}
+        </div>
+        {sidecar?.error && <p className="mt-2 text-xs text-danger break-all">{sidecar.error}</p>}
+        {sidecar?.command && <p className="mt-2 text-xs text-text2 break-all">{t('settings.routerLocalCommand')}: {sidecar.command}</p>}
+        {sidecar && sidecar.logTail && sidecar.logTail.length > 0 && (
+          <pre className="mt-2 max-h-40 overflow-auto rounded-lg bg-surface border border-border p-2 text-[11px] text-text2 whitespace-pre-wrap break-all">
+            {sidecar.logTail.join('\n')}
+          </pre>
+        )}
+      </div>
+
+      {msg && <p className="mt-2 text-xs text-accent break-all">{msg}</p>}
+      {err && <p className="mt-2 text-xs text-danger break-all">{err}</p>}
+    </div>
+  );
+}
