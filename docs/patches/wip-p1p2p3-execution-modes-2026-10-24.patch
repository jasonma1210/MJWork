+// ── 决策路由（P1，2026-10-23）──
+// 目标：把「执行模式怎么选」从写死变成可解释、可配置、可自测。
+// 页面包含四块：开关与来源 / 置信度策略 / 自测（规则 + 远程）/ 最近决策。
+//
+// 与方案文档的差异：本项目不做 Python sidecar 与本地决策模型（项目硬约束），
+// 因此这里没有「Python 状态 / sidecar 健康 / 模型族选择 / 许可证闸门」四个区块，
+// 只保留「仅规则」与「规则 + 远程」两种来源。
+import { useEffect, useMemo, useState } from 'react';
+import { useI18n } from '../../i18n';
+import { Section, Toggle, Input } from './shared';
+import Button from '../ui/Button';
+
+interface RemoteConfig {
+  providerId: string | number;
+  modelId: string;
+  baseUrl: string;
+  timeoutMs: number;
+}
+
+interface ParamsConfig {
+  confidenceThreshold: number;
+  clarifyBand: number[];
+  maxClarify: number;
+}
+
+interface RouterConfig {
+  version: number;
+  enabled: boolean;
+  path: 'rules' | 'remote';
+  remote: RemoteConfig;
+  params: ParamsConfig;
+  cache: { ttlSec: number; maxEntries: number };
+}
+
+interface ProviderView { id: string | number; name: string; base_url: string }
+
+interface ConfigSnap {
+  ok: boolean;
+  config: RouterConfig;
+  errors: string[];
+  legacy: boolean;
+  needsMigration: boolean;
+  exists: boolean;
+  filePath: string;
+  providers: ProviderView[];
+}
+
+interface DecideResult {
+  ok: boolean;
+  decision?: { mode: string; confidence: number; need_clarify: boolean; reason: string; steps: unknown[] };
+  source?: string;
+  latencyMs?: number;
+  note?: string;
+  errors?: string[];
+  error?: string;
+  policy?: { action: string; reason: string };
+}
+
+interface LogRow {
+  at: number;
+  textBrief: string;
+  mode: string;
+  confidence: number;
+  source: string;
+  latencyMs: number;
+  degraded: boolean;
+  note: string;
+}
+
+interface RemoteTestResult {
+  ok: boolean;
+  latencyMs?: number;
+  content?: string;
+  decision?: { mode: string; confidence: number };
+  errors?: string[];
+  error?: string;
+}
+
+// router:status —— 只读运行时状态（不带密钥）。设置页用它显示「当前真正生效的是什么」，
+// 避免用户改完配置却不知道规则层/远程是否已经就绪（黑盒感）。
+interface RouterStatus {
+  enabled: boolean;
+  path: 'rules' | 'remote';
+  remoteConfigured: boolean;
+  cacheEntries: number;
+  recentCount: number;
+}
+
+const SOURCE_KEYS: Record<string, string> = {
+  l0: 'settings.routerSourceL0',
+  l1: 'settings.routerSourceL1',
+  cache: 'settings.routerSourceCache',
+  remote: 'settings.routerSourceRemote',
+  fallback: 'settings.routerSourceFallback',
+  disabled: 'settings.routerSourceDisabled',
+};
+
+export default function RouterTab() {
+  const { t } = useI18n();
+  const [cfg, setCfg] = useState<RouterConfig | null>(null);
+  const [meta, setMeta] = useState<{ legacy: boolean; needsMigration: boolean; filePath: string } | null>(null);
+  const [providers, setProviders] = useState<ProviderView[]>([]);
+  const [status, setStatus] = useState<RouterStatus | null>(null);
+  const [logs, setLogs] = useState<LogRow[]>([]);
+  const [flash, setFlash] = useState('');
+  const [error, setError] = useState('');
+  const [saving, setSaving] = useState(false);
+
+  const [sample, setSample] = useState(() => t('settings.routerSampleDefault'));
+  const [sampleResult, setSampleResult] = useState<DecideResult | null>(null);
+  const [sampleBusy, setSampleBusy] = useState(false);
+  const [remoteResult, setRemoteResult] = useState<RemoteTestResult | null>(null);
+  const [remoteBusy, setRemoteBusy] = useState(false);
+
+  async function loadAll() {
+    try {
+      // 整桥别名：必须写成 `const br = window.mjcode`（bridge-parity 的静态扫描只认这种形态，
+      // 用 `(window.mjcode as Record<string, unknown>)[name]` 动态取名会被判定为死桥）。
+      const br = window.mjcode;
+      const [snap, logRes, statusRes] = await Promise.all([
+        br?.routerConfigGet ? (br.routerConfigGet() as Promise<ConfigSnap | null>) : Promise.resolve(null),
+        br?.routerLogs ? (br.routerLogs({ limit: 20 }) as Promise<{ ok: boolean; logs: LogRow[] } | null>) : Promise.resolve(null),
+        br?.routerStatus ? (br.routerStatus() as Promise<RouterStatus | null>) : Promise.resolve(null),
+      ]);
+      const st = statusRes as RouterStatus | null;
+      if (st) setStatus(st);
+      const s = snap as ConfigSnap | null;
+      if (s && s.ok) {
+        setCfg(s.config);
+        setProviders(Array.isArray(s.providers) ? s.providers : []);
+        setMeta({ legacy: s.legacy, needsMigration: s.needsMigration, filePath: s.filePath });
+        if (s.errors && s.errors.length) setError(s.errors.join(' / '));
+      }
+      const l = logRes as { ok: boolean; logs: LogRow[] } | null;
+      if (l && l.ok) setLogs(Array.isArray(l.logs) ? l.logs : []);
+    } catch (e) {
+      setError((e as Error).message || String(e));
