new file mode 100644
index 0000000..ca16464
--- /dev/null
+++ b/desktop/main/decisionConfig.js
@@ -0,0 +1,248 @@
+'use strict';
+// 决策路由配置持久化（P1-4，2026-10-23）
+//
+// 落点：`~/.mjcode/decision.json`（与 models.json 同目录，便于用户手改与备份；
+// 可用 `MJCODE_DECISION_FILE` 覆盖，供测试与多实例隔离）。
+//
+// 职责只有三件（方案 §6.4 明确要求，禁止越界）：
+//   ① 读写该文件（原子写 + 0o600）；
+//   ② 校验枚举与范围（非法值一律纠正并记 errors，让设置页能如实提示）；
+//   ③ 对外提供脱敏快照。
+// **不承载任何路由判定逻辑**——判定在 router/ 目录，两者分离才可单测。
+//
+// v1 → v2 的迁移必须是「显式」的（方案 §6.4 的破坏性变更表）：
+//   v1 的 `runtime` 形态与 v2 的双槽结构不兼容，**不做静默升级**——
+//   读到 v1 只做「尽力取值 + 标记 needsMigration」，文件本身原样保留，
+//   直到用户在设置页重新选择并点保存才落 v2。这样用户不会在重启后发现模型被莫名换掉。
+
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const { writeFileDurableWithMode } = require('./data/durableWrite');
+
+const CONFIG_VERSION = 2;
+const PATHS = ['rules', 'remote'];
+
+const DEFAULTS = Object.freeze({
+  version: CONFIG_VERSION,
+  enabled: true,
+  path: 'rules',
+  remote: {
+    providerId: '',
+    modelId: '',
+    baseUrl: '',
+    timeoutMs: 6000,
+  },
+  params: {
+    confidenceThreshold: 0.75,
+    clarifyBand: [0.55, 0.75],
+    maxClarify: 1,
+  },
+  cache: {
+    ttlSec: 86400,
+    maxEntries: 500,
+  },
+});
+
+function cloneDefaults() {
+  return JSON.parse(JSON.stringify(DEFAULTS));
+}
+
+/** 配置文件路径（每次现算，保证环境变量覆盖即时生效）。 */
+function decisionFilePath() {
+  const override = process.env.MJCODE_DECISION_FILE;
+  if (override && override.trim()) return override.trim();
+  return path.join(os.homedir(), '.mjcode', 'decision.json');
+}
+
+function clampNumber(value, min, max, fallback) {
+  const n = Number(value);
+  if (!Number.isFinite(n)) return fallback;
+  return Math.min(max, Math.max(min, n));
+}
+
+function str(value, max) {
+  if (typeof value !== 'string') return '';
+  return value.trim().slice(0, max);
+}
+
+// providerId 在 main 侧的真实形态是数字（localStore.nextId()），resolveSecret 也按 Number() 命中；
+// 这里必须原样保留数字，否则「设置页选中的服务商」会在写回后变成 '' —— 远程路由静默失效。
+function idValue(value, max) {
+  if (typeof value === 'number' && Number.isFinite(value)) return value;
+  return str(value, max);
+}
+
+function normalizeRemote(raw, errors) {
+  const out = { ...DEFAULTS.remote };
+  if (raw == null) return out;
+  if (typeof raw !== 'object' || Array.isArray(raw)) {
+    errors.push('remote_not_object');
+    return out;
+  }
+  out.providerId = idValue(raw.providerId, 128);
+  out.modelId = str(raw.modelId, 200);
+  const baseUrl = str(raw.baseUrl, 500);
+  if (baseUrl && !/^https?:\/\//i.test(baseUrl)) {
+    errors.push('remote_base_url_invalid');
+  } else {
+    out.baseUrl = baseUrl;
+  }
+  if (raw.timeoutMs != null && !Number.isFinite(Number(raw.timeoutMs))) errors.push('remote_timeout_invalid');
+  out.timeoutMs = Math.round(clampNumber(raw.timeoutMs, 1000, 30000, DEFAULTS.remote.timeoutMs));
+  return out;
+}
+
+function normalizeParams(raw, errors) {
+  const out = { ...DEFAULTS.params, clarifyBand: [...DEFAULTS.params.clarifyBand] };
+  if (raw == null) return out;
+  if (typeof raw !== 'object' || Array.isArray(raw)) {
+    errors.push('params_not_object');
+    return out;
+  }
+  if (raw.confidenceThreshold != null && !Number.isFinite(Number(raw.confidenceThreshold))) {
+    errors.push('params_threshold_invalid');
+  }
+  out.confidenceThreshold = Number(
+    clampNumber(raw.confidenceThreshold, 0, 1, DEFAULTS.params.confidenceThreshold).toFixed(2),
+  );
+  if (Array.isArray(raw.clarifyBand) && raw.clarifyBand.length === 2) {
+    const low = Number(raw.clarifyBand[0]);
+    const high = Number(raw.clarifyBand[1]);
+    if (Number.isFinite(low) && Number.isFinite(high) && low >= 0 && high <= 1 && low <= high) {
+      out.clarifyBand = [Number(low.toFixed(2)), Number(high.toFixed(2))];
+    } else {
+      errors.push('params_clarify_band_invalid');
+    }
+  } else if (raw.clarifyBand != null) {
+    errors.push('params_clarify_band_invalid');
+  }
+  if (raw.maxClarify != null && !Number.isFinite(Number(raw.maxClarify))) errors.push('params_max_clarify_invalid');
+  out.maxClarify = Math.round(clampNumber(raw.maxClarify, 0, 3, DEFAULTS.params.maxClarify));
+  return out;
+}
+
+function normalizeCache(raw, errors) {
+  const out = { ...DEFAULTS.cache };
+  if (raw == null) return out;
+  if (typeof raw !== 'object' || Array.isArray(raw)) {
+    errors.push('cache_not_object');
+    return out;
+  }
+  if (raw.ttlSec != null && !Number.isFinite(Number(raw.ttlSec))) errors.push('cache_ttl_invalid');
+  out.ttlSec = Math.round(clampNumber(raw.ttlSec, 0, 604800, DEFAULTS.cache.ttlSec));
+  if (raw.maxEntries != null && !Number.isFinite(Number(raw.maxEntries))) errors.push('cache_max_entries_invalid');
+  out.maxEntries = Math.round(clampNumber(raw.maxEntries, 1, 5000, DEFAULTS.cache.maxEntries));
+  return out;
+}
+
+/** v1 的最佳努力取值：只在「用户确实配过模型」时带出来，绝不编造。 */
+function readLegacyRemote(raw) {
+  const source = raw && (raw.generic || raw.model || raw.runtime);
+  if (!source || typeof source !== 'object') return null;
+  const providerId = idValue(source.providerId, 128);
+  const modelId = str(source.modelId || source.model, 200);
+  if (!providerId && !modelId) return null;
+  return {
+    providerId,
+    modelId,
+    baseUrl: str(source.baseUrl, 500),
+    timeoutMs: Math.round(clampNumber(source.timeoutMs, 1000, 30000, DEFAULTS.remote.timeoutMs)),
+  };
+}
+
+/**
+ * 归一化任意版本的原始配置。
+ * @param {object} raw
+ * @returns {{config: object, errors: string[], legacy: boolean, needsMigration: boolean}}
+ */
+function normalizeConfig(raw) {
+  const errors = [];
+  const config = cloneDefaults();
+  if (raw == null) return { config, errors, legacy: false, needsMigration: false };
+  if (typeof raw !== 'object' || Array.isArray(raw)) {
+    errors.push('root_not_object');
+    return { config, errors, legacy: false, needsMigration: false };
+  }
+
+  // v1：不做静默升级，只标记需要用户重新选择
+  if (raw.version === 1) {
+    config.enabled = raw.enabled !== false;
+    config.path = 'rules';
+    const legacyRemote = readLegacyRemote(raw);
+    if (legacyRemote) config.remote = legacyRemote;
+    if (legacyRemote && legacyRemote.providerId && legacyRemote.modelId) config.path = 'remote';
+    return { config, errors, legacy: true, needsMigration: true };
+  }
+
+  if (raw.version != null && raw.version !== CONFIG_VERSION) {
+    errors.push('version_unsupported');
+  }
+
+  if (raw.enabled != null && typeof raw.enabled !== 'boolean') errors.push('enabled_invalid');
+  config.enabled = raw.enabled !== false;
+
+  if (raw.path != null && !PATHS.includes(raw.path)) errors.push('path_invalid');
+  config.path = PATHS.includes(raw.path) ? raw.path : 'rules';
+
+  config.remote = normalizeRemote(raw.remote, errors);
+  config.params = normalizeParams(raw.params, errors);
+  config.cache = normalizeCache(raw.cache, errors);
+
+  return { config, errors, legacy: false, needsMigration: false };
+}
+
+/**
+ * 读取配置快照（同步；设置页打开时调用）。
+ * @returns {{config: object, errors: string[], legacy: boolean, needsMigration: boolean,
+ *            exists: boolean, filePath: string}}
+ */
+function readConfigSync() {
+  const filePath = decisionFilePath();
+  let raw = null;
+  let exists = false;
+  const errors = [];
+  try {
+    exists = fs.existsSync(filePath);
+    if (exists) raw = JSON.parse(fs.readFileSync(filePath, 'utf8'));
+  } catch (e) {
+    errors.push(`file_unreadable:${String(e && e.message || e).slice(0, 120)}`);
+    raw = null;
+  }
+  const normalized = normalizeConfig(raw);
+  return {
+    ...normalized,
+    errors: [...errors, ...normalized.errors],
+    exists,
+    filePath,
+  };
+}
+
+/**
+ * 写回配置（原子写 + 0o600）。校验失败时**不落盘**，把 errors 交给设置页展示。
+ * @param {object} input
+ * @returns {{ok: boolean, errors: string[], config?: object, filePath: string}}
+ */
+function writeConfigSync(input) {
+  const filePath = decisionFilePath();
+  const normalized = normalizeConfig({ ...input, version: CONFIG_VERSION });
+  if (normalized.errors.length > 0) {
+    return { ok: false, errors: normalized.errors, filePath };
+  }
+  const payload = `${JSON.stringify(normalized.config, null, 2)}\n`;
+  const res = writeFileDurableWithMode(filePath, payload, 0o600);
+  if (!res.ok) {
+    return { ok: false, errors: [`write_failed:${res.error || 'unknown'}`], filePath };
+  }
+  return { ok: true, errors: [], config: normalized.config, filePath };
+}
+
+module.exports = {
+  CONFIG_VERSION,
+  PATHS,
+  DEFAULTS,
+  decisionFilePath,
+  normalizeConfig,
+  readConfigSync,
+  writeConfigSync,
+};
diff --git a/desktop/main/decisionModels.js b/desktop/main/decisionModels.js
new file mode 100644
index 0000000..6289b3c
--- /dev/null
+++ b/desktop/main/decisionModels.js
@@ -0,0 +1,219 @@
+'use strict';
+// 本地决策模型下载器（需求 1，2026-10-23）
+//
+// 目标：把「本地决策模型」从文档里的选型落成可下载、可删除、可观测的真实能力。
+// 选型依据 `docs/MJCode-执行模式分层与决策路由-技术清单与实现方案-2026-10-22.md` §1.2-B：
+// vLLM Semantic Router 的 d3 系列（Apache-2.0，全系列无商用限制）——六档参数量真实核对过，
+// 不做「宣传名推算」：d3-edge 0.6B / d3-lite 0.85B / d3-nano 2.21B / d3-mini 4.54B /
+// d3-flash 8.39B / d3 26.09B。
+//
+// 三条实现纪律：
+//   ① 仓库与文件清单一律现查 Hugging Face API（不硬编码文件名）——模型卡改版时自动跟随；
+//   ② 下载必须走流式 + 原子落盘（.part → rename），中途失败不留半截文件被当成「已安装」；
+//   ③ 任何错误如实上报（HTTP 码 / 网络错误），不在 UI 上假装成功。
+const fs = require('fs');
+const fsp = require('fs/promises');
+const os = require('os');
+const path = require('path');
+const { Readable } = require('node:stream');
+const { pipeline } = require('node:stream/promises');
+
+const HF_API = 'https://huggingface.co/api/models';
+const HF_RESOLVE = 'https://huggingface.co';
+
+const CATALOG = [
+  { id: 'd3-edge', name: 'd3-edge', params: '0.6B', repo: 'vllm-sr/d3-edge', license: 'Apache-2.0', hint: '最快，适合逐次门控' },
+  { id: 'd3-lite', name: 'd3-lite', params: '0.85B', repo: 'vllm-sr/d3-lite', license: 'Apache-2.0', hint: '轻量默认候选' },
+  { id: 'd3-nano', name: 'd3-nano', params: '2.21B', repo: 'vllm-sr/d3-nano', license: 'Apache-2.0', hint: '精度与延迟平衡' },
+  { id: 'd3-mini', name: 'd3-mini', params: '4.54B', repo: 'vllm-sr/d3-mini', license: 'Apache-2.0', hint: '推荐档位' },
+  { id: 'd3-flash', name: 'd3-flash', params: '8.39B', repo: 'vllm-sr/d3-flash', license: 'Apache-2.0', hint: '接近旗舰精度' },
+  { id: 'd3', name: 'd3', params: '26.09B', repo: 'vllm-sr/d3', license: 'Apache-2.0', hint: '旗舰，仅高配机器' },
+];
+
+/** 下载中的任务（同一时刻只允许一个：模型动辄数 GB，并发只会互相拖慢） */
+let active = null;
+let progressSink = null;
+
+function modelsRoot() {
+  const override = process.env.MJCODE_DECISION_MODELS_DIR;
+  if (override && override.trim()) return override.trim();
+  return path.join(os.homedir(), '.mjcode', 'decision-models');
+}
+
+function modelDirOf(id) {
+  return path.join(modelsRoot(), String(id));
+}
+
+function metaOf(id) {
+  return CATALOG.find((m) => m.id === id) || null;
+}
+
+/** 设置进度回调（主进程广播到渲染层；测试可直接注入） */
+function setProgressSink(fn) {
+  progressSink = typeof fn === 'function' ? fn : null;
+}
+
+function emit(event) {
+  if (!progressSink) return;
+  try { progressSink(event); } catch { /* 广播失败不影响下载 */ }
+}
+
+function dirSizeSync(dir) {
+  let total = 0;
+  const stack = [dir];
+  while (stack.length) {
+    const cur = stack.pop();
+    let entries = [];
+    try { entries = fs.readdirSync(cur, { withFileTypes: true }); } catch { continue; }
+    for (const e of entries) {
+      const full = path.join(cur, e.name);
+      if (e.isDirectory()) stack.push(full);
+      else if (e.isFile()) {
+        try { total += fs.statSync(full).size; } catch { /* 忽略瞬时消失 */ }
+      }
+    }
+  }
+  return total;
+}
+
+/** 已安装 = 目录存在且含非 .part 的权重文件（避免把半截目录当成可用模型） */
+function isInstalledSync(id) {
+  const dir = modelDirOf(id);
+  let entries = [];
+  try { entries = fs.readdirSync(dir, { withFileTypes: true }); } catch { return false; }
+  return entries.some((e) => e.isFile() && !e.name.endsWith('.part'));
+}
+
+function list() {
+  return CATALOG.map((m) => {
+    const installed = isInstalledSync(m.id);
+    const dl = active && active.id === m.id ? active.state : null;
+    return {
+      ...m,
+      dir: modelDirOf(m.id),
+      installed,
+      sizeBytes: installed ? dirSizeSync(modelDirOf(m.id)) : 0,
+      download: dl,
+    };
+  });
+}
+
+async function fetchFileList(meta, signal) {
+  const res = await fetch(`${HF_API}/${meta.repo}?blobs=true`, {
+    signal,
+    headers: { 'User-Agent': 'MJWork-Desktop/decision-models', Accept: 'application/json' },
+  });
+  if (!res.ok) {
+    throw new Error(`仓库清单获取失败（HTTP ${res.status}）：${meta.repo}`);
+  }
+  const json = await res.json();
+  const siblings = Array.isArray(json.siblings) ? json.siblings : [];
+  const files = siblings
+    .map((s) => ({ name: String(s.rfilename || ''), size: Number(s.size) || 0 }))
+    .filter((f) => f.name && !f.name.startsWith('.'));
+  if (!files.length) throw new Error(`仓库里没有可下载文件：${meta.repo}`);
+  return files;
+}
+
+/**
+ * 下载一个模型（真实流式下载；返回后进度通过 progressSink 推送）。
+ * @param {string} id 目录 id（CATALOG 中的 id）
+ * @param {{licenseAccepted?: boolean}} opts
+ */
+async function download(id, opts = {}) {
+  const meta = metaOf(id);
+  if (!meta) throw new Error(`未知模型：${id}`);
+  if (opts.licenseAccepted !== true) throw new Error('LICENSE_REQUIRED：请先阅读并接受 Apache-2.0 许可证');
+  if (active) throw new Error(`正在下载 ${active.id}，请等待完成或取消`);
+
+  const controller = new AbortController();
+  const state = { id, status: 'downloading', file: '', received: 0, total: 0, files: 0, doneFiles: 0 };
+  active = { id, controller, state, cancelled: false };
+  const dir = modelDirOf(id);
+  await fsp.mkdir(dir, { recursive: true });
+  emit({ type: 'start', id, dir });
+
+  try {
+    const files = await fetchFileList(meta, controller.signal);
+    // 一次性写入（逐个赋值会各触发一次 require-atomic-updates）
+    Object.assign(state, { files: files.length, total: files.reduce((n, f) => n + (f.size || 0), 0) });
+    emit({ type: 'plan', id, files: files.length, total: state.total });
+
+    let received = 0;
+    for (const file of files) {
+      if (active.cancelled) throw Object.assign(new Error('DOWNLOAD_CANCELLED'), { code: 'CANCELLED' });
+      state.file = file.name;
+      emit({ type: 'file', id, file: file.name, index: state.doneFiles, files: files.length });
+      const dest = path.join(dir, file.name);
+      await fsp.mkdir(path.dirname(dest), { recursive: true });
+      const part = `${dest}.part`;
+      const res = await fetch(`${HF_RESOLVE}/${meta.repo}/resolve/main/${encodeURI(file.name)}`, {
+        signal: controller.signal,
+        headers: { 'User-Agent': 'MJWork-Desktop/decision-models' },
+      });
+      if (!res.ok || !res.body) throw new Error(`下载失败（HTTP ${res.status}）：${file.name}`);
+      const total = Number(res.headers.get('content-length')) || file.size || 0;
+      let fileReceived = 0;
+      const reader = Readable.fromWeb(res.body);
+      reader.on('data', (chunk) => {
+        fileReceived += chunk.length;
+        received += chunk.length;
+        state.received = received;
+        state.total = Math.max(state.total, received);
+        // 节流：每 256KB 报一次，避免把 IPC 打满
+        if (fileReceived % (256 * 1024) < chunk.length) {
+          emit({ type: 'progress', id, file: file.name, received, total: state.total, fileBytes: fileReceived, fileTotal: total });
+        }
+      });
+      await pipeline(reader, fs.createWriteStream(part));
+      await fsp.rename(part, dest);
+      state.doneFiles += 1;
+    }
+    state.status = 'done';
+    emit({ type: 'done', id, dir, total: received });
+    return { ok: true, id, dir, bytes: received };
+  } catch (e) {
+    // 一次性写入（逐个赋值会各触发一次 require-atomic-updates）
+    Object.assign(state, {
+      status: e && e.code === 'CANCELLED' ? 'cancelled' : 'error',
+      error: String((e && e.message) || e),
+    });
+    emit({ type: 'error', id, error: state.error });
+    throw e;
+  } finally {
+    // eslint-disable-next-line require-atomic-updates -- 同一时刻只允许一个下载（active 非空即拒绝），串行置空安全
+    active = null;
+  }
+}
+
+/** 取消当前下载（未完成文件保留 .part，下次覆盖） */
+function cancel() {
+  if (!active) return { ok: false, error: 'NO_ACTIVE_DOWNLOAD' };
+  active.cancelled = true;
+  try { active.controller.abort(); } catch { /* 已结束 */ }
+  return { ok: true, id: active.id };
+}
+
+async function remove(id) {
+  const meta = metaOf(id);
+  if (!meta) throw new Error(`未知模型：${id}`);
+  if (active && active.id === id) throw new Error('该模型正在下载，请先取消');
+  const dir = modelDirOf(id);
+  await fsp.rm(dir, { recursive: true, force: true });
+  emit({ type: 'removed', id, dir });
+  return { ok: true, id, dir };
+}
+
+module.exports = {
+  CATALOG,
+  HF_API,
+  modelsRoot,
+  modelDirOf,
+  list,
+  download,
+  cancel,
+  remove,
+  isInstalledSync,
+  setProgressSink,
+  activeId: () => (active ? active.id : ''),
+};
