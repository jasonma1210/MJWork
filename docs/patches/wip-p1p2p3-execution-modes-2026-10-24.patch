+// routeHint.mjs 的 TypeScript 类型声明（运行时实现见同名 .mjs）
+
+export type RouteMode = 'chat' | 'template' | 'auto' | 'team';
+export type PillMode = 'auto' | 'chat' | 'template';
+export type HintAction = 'execute' | 'suggest' | 'clarify';
+export type HintKind = 'suggest' | 'clarify';
+
+/** router:decide 信封里本模块关心的字段（其余字段原样透传，不在此声明） */
+export interface DecideEnvelope {
+  ok?: boolean;
+  decision?: {
+    mode?: string;
+    confidence?: number;
+    task_brief?: string;
+    reason?: string;
+    need_clarify?: boolean;
+    clarify_question?: string;
+  } | null;
+  policy?: { action?: string; reason?: string } | null;
+  source?: string;
+  degraded?: boolean;
+  errors?: string[];
+}
+
+export interface RouteHint {
+  kind: HintKind;
+  mode: RouteMode;
+  targetMode: PillMode;
+  action: HintAction;
+  confidence: number;
+  source: string;
+  reason: string;
+  question: string;
+  canAdopt: boolean;
+  differs: boolean;
+  brief: string;
+}
+
+export declare const ROUTE_MODES: readonly RouteMode[];
+export declare const PILL_MODES: readonly PillMode[];
+export declare const HINT_ACTIONS: readonly HintAction[];
+export declare const MIN_HINT_CHARS: number;
+
+export declare function normalizeHintMode(v: unknown): RouteMode | '';
+
+export declare function actionFromConfidence(
+  confidence: number,
+  params?: { confidenceThreshold?: number; clarifyBand?: number[] },
+): HintAction;
+
+export declare function buildRouteHint(result: DecideEnvelope | null | undefined, currentMode?: string): RouteHint | null;
+
+export declare function shouldProbe(text: unknown): boolean;
+
+export declare function confidencePercent(confidence: number): number;
