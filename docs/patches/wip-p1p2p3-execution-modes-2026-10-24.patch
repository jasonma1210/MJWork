+
+  const currentProvider = useMemo(
+    () => providers.find((p) => String(p.id) === String(cfg?.remote?.providerId)),
+    [providers, cfg?.remote?.providerId],
+  );
+
+  function patchRemote(key: keyof RemoteConfig, value: string | number) {
+    if (!cfg) return;
+    setCfg({ ...cfg, remote: { ...cfg.remote, [key]: value } });
+    setFlash('');
+  }
+
+  function patchParams(key: keyof ParamsConfig, value: number | number[]) {
+    if (!cfg) return;
+    setCfg({ ...cfg, params: { ...cfg.params, [key]: value } });
