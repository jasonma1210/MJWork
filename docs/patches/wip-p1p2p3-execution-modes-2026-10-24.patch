+// P1-5 / P1-7：决策路由 IPC、桥面、写通道守卫、审计与编排行为
+//
+// 分两层：
+//   ① 静态断言：六通道已注册 / preload 已暴露 / 写通道在守卫清单里 / 渲染层真实调用六个桥（防死桥）；
+//   ② 行为断言：createRouter 在六种输入下的 source 与降级语义（含缓存命中与远程非法输出）。
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import decideModule from '../main/router/decide.js';
+
+const { createRouter } = decideModule;
+
+const DESKTOP = path.dirname(path.dirname(fileURLToPath(import.meta.url)));
+const read = (rel) => fs.readFileSync(path.join(DESKTOP, rel), 'utf8');
+
+const CHANNELS = [
+  'router:config:get',
+  'router:config:set',
+  'router:status',
+  'router:decide',
+  'router:logs',
+  'router:remote:test',
+];
+const BRIDGES = [
+  'routerConfigGet',
+  'routerConfigSet',
+  'routerStatus',
+  'routerDecide',
+  'routerLogs',
+  'routerRemoteTest',
+];
+
+let pass = 0;
+let total = 0;
+function check(name, fn) {
+  total++;
+  try { fn(); console.log(`[PASS] ${name}`); pass++; }
+  catch (e) { console.error(`[FAIL] ${name} — ${e.message}`); process.exitCode = 1; }
+}
+async function checkAsync(name, fn) {
+  total++;
+  try { await fn(); console.log(`[PASS] ${name}`); pass++; }
+  catch (e) { console.error(`[FAIL] ${name} — ${e.message}`); process.exitCode = 1; }
+}
+
+// ── ① 静态断言 ──
+check('六条 router:* 通道全部在 main/ipc/router.js 注册', () => {
+  const src = read('main/ipc/router.js');
+  const missing = CHANNELS.filter((c) => !src.includes(`ipcMain.handle('${c}'`));
+  if (missing.length) throw new Error(`未注册：${missing.join(', ')}`);
+});
+
+check('main.js 已装配 initRouterIpc（单行注册）', () => {
+  const src = read('main/main.js');
+  if (!src.includes("require('./ipc/router').initRouterIpc(")) throw new Error('main.js 未注册 router IPC');
+});
+
+check('preload.js 暴露六个桥且与通道一一对应', () => {
+  const src = read('main/preload.js');
+  for (let i = 0; i < BRIDGES.length; i++) {
+    const bridge = BRIDGES[i];
+    const channel = CHANNELS[i];
+    if (!src.includes(`${bridge}: `)) throw new Error(`缺少桥方法 ${bridge}`);
+    if (!src.includes(`ipcRenderer.invoke('${channel}'`)) throw new Error(`桥 ${bridge} 未指向 ${channel}`);
+  }
+});
+
+check('router:config:set 是写通道并已登记进 GUARDED_CHANNELS', () => {
+  const src = read('main/ipc/router.js');
+  const at = src.indexOf("ipcMain.handle('router:config:set'");
+  if (at < 0) throw new Error('通道未注册');
+  const body = src.slice(at, at + 900);
+  if (!/guard\.assertObject\s*\(/.test(body)) throw new Error('handler 体内缺少 guard.assertObject');
+  const guardTest = read('test/ipc-write-guard-coverage.test.mjs');
+  if (!guardTest.includes("'router:config:set'")) throw new Error('未登记进 GUARDED_CHANNELS（守卫会被悄悄删掉）');
+});
+
+check('router:decide 对 text 做了边界校验', () => {
+  const src = read('main/ipc/router.js');
+  const at = src.indexOf("ipcMain.handle('router:decide'");
+  const body = src.slice(at, at + 700);
+  if (!/guard\.assertStrings\s*\(/.test(body)) throw new Error('text 缺少 assertStrings 边界校验');
+});
+
+check('decide.js 每次决策都落审计（P1-7 的 source / latency）', () => {
+  const src = read('main/router/decide.js');
+  if (!/audit\('router\.decide'/.test(src)) throw new Error('未写 router.decide 审计');
+  if (!/latency_ms: result\.latencyMs/.test(src)) throw new Error('审计缺 latency');
+  if (!/source: result\.source/.test(src)) throw new Error('审计缺 source');
+});
+
+check('渲染层 RouterTab 真实调用六个桥（防死桥）', () => {
+  const src = read('renderer/src/components/settings/RouterTab.tsx');
+  // 必须是字面量调用（`window.mjcode?.xxx` / 别名 `br.xxx`），不接受动态取名：
+  // bridge-parity 的静态扫描只认这种形态，动态取名会被判成死桥。
+  const uses = ['routerConfigGet', 'routerConfigSet', 'routerDecide', 'routerLogs', 'routerRemoteTest', 'routerStatus'];
+  const missing = uses.filter((u) => !new RegExp(`mjcode\\??\\.${u}\\b|\\bbr\\??\\.${u}\\b`).test(src));
+  if (missing.length) throw new Error(`未调用：${missing.join(', ')}`);
+});
+
+check('设置页已挂载 router Tab 且双语 key 完整', () => {
+  const modal = read('renderer/src/components/SettingsModal.jsx');
+  if (!modal.includes("id: 'router'")) throw new Error('NAV 缺少 router 项');
+  if (!modal.includes("{tab === 'router' && <RouterTab />}")) throw new Error('正文缺少 router 分支');
+  const zh = JSON.parse(read('renderer/src/i18n/locales/zh-CN/settings.json'));
+  const en = JSON.parse(read('renderer/src/i18n/locales/en-US/settings.json'));
+  const keys = ['tabRouter', 'routerTitle', 'routerEnabled', 'routerSave', 'routerSelfTestTitle', 'routerLogsTitle'];
+  for (const k of keys) {
+    if (!zh[k]) throw new Error(`zh-CN 缺 key ${k}`);
+    if (!en[k]) throw new Error(`en-US 缺 key ${k}`);
+  }
+});
+
+check('RouterTab 用到的全部 i18n key 在两端都存在', () => {
+  const src = read('renderer/src/components/settings/RouterTab.tsx');
+  const zh = JSON.parse(read('renderer/src/i18n/locales/zh-CN/settings.json'));
+  const en = JSON.parse(read('renderer/src/i18n/locales/en-US/settings.json'));
+  const keys = [...src.matchAll(/t\('settings\.([A-Za-z0-9_]+)'/g)].map((m) => m[1]);
+  const missing = [...new Set(keys)].filter((k) => !zh[k] || !en[k]);
+  if (missing.length) throw new Error(`缺少 key：${missing.join(', ')}`);
+});
+
+// ── ② 行为断言 ──
+const baseConfig = () => ({
+  enabled: true,
+  path: 'rules',
+  remote: { providerId: '', modelId: '', baseUrl: '', timeoutMs: 6000 },
+  params: { confidenceThreshold: 0.75, clarifyBand: [0.55, 0.75], maxClarify: 1 },
+  cache: { ttlSec: 3600, maxEntries: 100 },
+});
+
+function makeRouter({ config = baseConfig(), remoteChat = null } = {}) {
+  const audits = [];
+  const router = createRouter({
+    getConfig: () => config,
+    remoteChat,
+    audit: (...args) => audits.push(args),
+  });
+  return { router, audits, config };
+}
+
+await checkAsync('关闭路由 → source=disabled 且不调远程', async () => {
+  let called = 0;
+  const { router, audits } = makeRouter({
+    config: { ...baseConfig(), enabled: false },
+    remoteChat: async () => { called++; return '{}'; },
+  });
+  const res = await router.decide({ text: '调研三个竞品并汇总' });
+  if (res.source !== 'disabled') throw new Error(`source 应为 disabled，实际 ${res.source}`);
+  if (called !== 0) throw new Error('关闭后仍调用了远程');
+  if (audits.length !== 1) throw new Error('未写审计');
+});
+
+await checkAsync('手选模式 → source=l0 且 confidence=1', async () => {
+  const { router } = makeRouter();
+  const res = await router.decide({ text: '并行处理多个模块', explicitMode: 'chat' });
+  if (res.source !== 'l0') throw new Error(`source 应为 l0，实际 ${res.source}`);
+  if (res.decision.mode !== 'chat' || res.decision.confidence !== 1) throw new Error('L0 决策不正确');
+});
+
+await checkAsync('规则命中 → source=l1（「报数」走对话型旁路）', async () => {
+  const { router } = makeRouter();
+  const res = await router.decide({ text: '报数' });
+  if (res.source !== 'l1' || res.decision.mode !== 'chat') throw new Error('L1 未命中对话型目标');
+  if (res.policy.action !== 'execute') throw new Error('高置信度应为 execute');
+});
+
+await checkAsync('规则判不出且来源为 rules → source=fallback', async () => {
+  const { router } = makeRouter();
+  const res = await router.decide({ text: '帮我写一个快速排序' });
+  if (res.source !== 'fallback' || res.decision.mode !== 'chat') throw new Error('兜底不正确');
+  if (res.note !== 'no_rule_hit') throw new Error(`note 应为 no_rule_hit，实际 ${res.note}`);
+});
+
+await checkAsync('远程成功 → source=remote，第二次命中缓存', async () => {
+  let called = 0;
+  const { router } = makeRouter({
+    config: { ...baseConfig(), path: 'remote', remote: { providerId: 1, modelId: 'm', baseUrl: '', timeoutMs: 6000 } },
+    remoteChat: async () => {
+      called++;
+      return JSON.stringify({ mode: 'auto', confidence: 0.87, need_clarify: false, reason: '可拆' });
+    },
+  });
+  const first = await router.decide({ text: '帮我写一个快速排序' });
+  if (first.source !== 'remote' || first.decision.mode !== 'auto') throw new Error('远程决策未生效');
+  const second = await router.decide({ text: '帮我写一个快速排序', pageMode: 'chat', lastSummary: '' });
+  if (second.source !== 'cache') throw new Error(`第二次应命中缓存，实际 ${second.source}`);
+  if (called !== 1) throw new Error(`远程应只调一次，实际 ${called}`);
+});
+
+await checkAsync('远程输出非法 → 降级 chat 且记 router_invalid', async () => {
+  const { router } = makeRouter({
+    config: { ...baseConfig(), path: 'remote', remote: { providerId: 1, modelId: 'm', baseUrl: '', timeoutMs: 6000 } },
+    remoteChat: async () => '我不确定该怎么分',
+  });
+  const res = await router.decide({ text: '帮我写一个快速排序' });
+  if (res.source !== 'fallback') throw new Error('非法输出应降级');
+  if (!res.degraded || res.note !== 'router_invalid') throw new Error(`降级标记不正确：${res.note}`);
+  if (!res.errors.includes('json_invalid')) throw new Error('未保留 json_invalid');
+});
+
+await checkAsync('远程抛错 → 降级 chat 且 note 带失败原因', async () => {
+  const { router } = makeRouter({
+    config: { ...baseConfig(), path: 'remote', remote: { providerId: 1, modelId: 'm', baseUrl: '', timeoutMs: 6000 } },
+    remoteChat: async () => { throw new Error('API 500'); },
+  });
+  const res = await router.decide({ text: '帮我写一个快速排序' });
+  if (res.source !== 'fallback' || !res.degraded) throw new Error('远程故障未降级');
+  if (!res.note.startsWith('remote_error')) throw new Error(`note 不正确：${res.note}`);
+});
+
+await checkAsync('最近决策环形缓冲只保留输入前 120 字', async () => {
+  const { router } = makeRouter();
+  const long = `报数${'啊'.repeat(300)}`;
+  await router.decide({ text: long });
+  const [row] = router.recentDecisions(10);
+  if (!row) throw new Error('未记录');
+  if (row.textBrief.length !== 120) throw new Error(`摘要长度应为 120，实际 ${row.textBrief.length}`);
+  if (row.source !== 'l1') throw new Error('来源记录不正确');
+});
+
+await checkAsync('remote 未配置时即使 path=remote 也不出网', async () => {
+  let called = 0;
+  const { router } = makeRouter({
+    config: { ...baseConfig(), path: 'remote' },
+    remoteChat: async () => { called++; return '{}'; },
+  });
+  const res = await router.decide({ text: '帮我写一个快速排序' });
+  if (called !== 0) throw new Error('未配置模型仍调用了远程');
+  if (res.source !== 'fallback') throw new Error('应走兜底');
+});
+
+console.log(`\nrouter-ipc: ${pass}/${total} 通过`);
+process.exit(pass === total ? 0 : 1);
