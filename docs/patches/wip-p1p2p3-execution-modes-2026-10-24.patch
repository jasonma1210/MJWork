diff --git a/desktop/renderer/src/lib/dispatchTeamRun.ts b/desktop/renderer/src/lib/dispatchTeamRun.ts
new file mode 100644
index 0000000..f42b359
--- /dev/null
+++ b/desktop/renderer/src/lib/dispatchTeamRun.ts
@@ -0,0 +1,105 @@
+// P2（2026-10-23）：团队派活（军团）从 ChatArea 抽出的执行体。
+//
+// 为什么抽出来：ChatArea 已接近 800 行软档，而团队派活是「建目录 → 建会话 → 落用户消息 →
+// 调 teams:dispatch」的完整链路，与对话页渲染无关。抽到 lib 后 ChatArea 只保留
+// 「选中军团就派活、否则走 send」这一行分流判断（sendOrDispatch 仍是唯一分流点）。
+//
+// 行为与抽离前逐项一致：目录失败阻断、缺统筹由调用方预检 + 主进程 LEAD_MISSING 兜底、
+// 两条 teamsDebug 日志（渲染层事实与结果）。
+import { ensureRunSession, persistUserGoal } from './runSession';
+import { tGlobal } from '../i18n';
+
+export interface TeamRef {
+  id: string | number;
+  name?: string;
+  leadMissing?: boolean;
+}
+
+export interface TeamDispatchArgs {
+  team: TeamRef;
+  goal: string;
+  threadId?: string | number | null;
+  cwd?: string;
+  projectPath?: string;
+  projectPicked?: boolean;
+  selectedModel?: {
+    provider?: { id?: unknown; name?: unknown };
+    model?: { id?: unknown; model_id?: unknown };
+  } | null;
+  onAutoProject?: Parameters<typeof ensureRunSession>[0]['onAutoProject'];
+  onNewMessage?: () => void;
+  onThreadCreated?: (thread: unknown) => void;
+  /** 既有会话就地补用户气泡；新建会话由切换后的拉取结果覆盖（同一条，不重复） */
+  appendUserMessage?: ((goal: string) => void) | null;
+}
+
+export interface TeamDispatchResult {
+  ok: boolean;
+  code?: string;
+  error?: string;
+  tasks?: number;
+  threadId?: string;
+  runId?: string;
+}
+
+function errText(err: unknown): string {
+  return String((err as Error)?.message || err);
+}
+
+export async function dispatchTeamRun(args: TeamDispatchArgs): Promise<TeamDispatchResult> {
+  const goal = String(args.goal || '').trim();
+  if (!goal) return { ok: false, code: 'EMPTY_GOAL' };
+
+  const session = await ensureRunSession({
+    threadId: args.threadId,
+    cwd: args.cwd,
+    projectPath: args.projectPath,
+    projectPicked: args.projectPicked,
+    selectedModel: args.selectedModel,
+    goal,
+    onAutoProject: args.onAutoProject,
+    onNewMessage: args.onNewMessage,
+    onThreadCreated: args.onThreadCreated,
+  });
+  if (!session.ok || !session.threadId) {
+    return { ok: false, code: 'SESSION_FAILED', error: session.error };
+  }
+  const runThreadId = session.threadId;
+
+  const persisted = await persistUserGoal(runThreadId, goal);
+  if (!persisted.ok) return { ok: false, code: 'MESSAGE_FAILED', error: persisted.error, threadId: runThreadId };
+  args.appendUserMessage?.(goal);
+
+  // 调试日志：用户点「派活」的渲染层事实（与主进程 ipc/dispatch 日志同一时间线）
+  window.mjcode?.teamsDebugAppend?.({
+    action: 'team_dispatch_click',
+    threadId: runThreadId,
+    detail: { teamId: args.team.id, goalLength: goal.length, projectPath: session.cwd || session.projectPath || '' },
+  });
+
+  const r = (await window.mjcode?.teamsDispatch?.({
+    teamId: args.team.id,
+    goal,
+    threadId: runThreadId,
+    // 工作目录回落：全局团队不带 project_path，用本条任务实际解析出的工作目录兜底
+    projectPath: session.cwd || session.projectPath || '',
+  })) as
+    { ok?: boolean; code?: string; error?: string; tasks?: number; runId?: string } | undefined;
+
+  window.mjcode?.teamsDebugAppend?.({
+    action: 'team_dispatch_result',
+    threadId: runThreadId,
+    detail: {
+      ok: !!r?.ok,
+      code: r?.code || null,
+      tasks: r?.tasks || 0,
+      runId: r?.runId || null,
+      error: r?.error || null,
+    },
+  });
+
+  if (r?.ok) {
+    return { ok: true, tasks: Number(r.tasks) || 0, threadId: runThreadId, runId: r.runId };
+  }
+  return { ok: false, code: r?.code, error: r?.error || tGlobal('workflow.runFailed'), threadId: runThreadId };
+}
diff --git a/desktop/renderer/src/lib/dispatchTemplateRun.ts b/desktop/renderer/src/lib/dispatchTemplateRun.ts
new file mode 100644
index 0000000..6d54c1a
--- /dev/null
+++ b/desktop/renderer/src/lib/dispatchTemplateRun.ts
@@ -0,0 +1,247 @@
+// P2（2026-10-23）：模板运行与「先看拆解，再执行」的渲染层执行体。
+//
+// 三条路径共用一个前提（见 runSession.ts）：先有会话、先落用户消息，再建组——
+// 否则任务组 thread_id 为空，对话内卡片反查不到。
+//
+// 分工：
+//   previewAutoPlan      自动模式 dryRun 预览（tasks:plan({dryRun:true})，不落库、不发事件）
+//   previewTemplatePlan  模板模式预览（workflows:preview，与模板详情弹层同一份投影）
+//   startTemplateRun     按模板正式运行（workflows:run，主进程后台跑，立即回 groupId）
+//   startPresetPlanRun   按「预览过的那份任务清单」建组后执行（保证步骤与预览一致）
+import { ensureRunSession, persistUserGoal, type RunSessionArgs, type RunSessionResult } from './runSession';
+import { tGlobal } from '../i18n';
+
+export interface WorkflowPlanStep {
+  id: string;
+  title: string;
+  prompt: string;
+  dependsOn: string[];
+  critical?: boolean;
+}
+
+export interface WorkflowPlanBudget {
+  max_rounds?: number;
+  max_tokens?: number;
+  max_wall_ms?: number;
+}
+
+export interface WorkflowPlan {
+  mode: 'auto' | 'template';
+  goal: string;
+  templateId?: string;
+  templateName?: string;
+  levels: string[][];
+  steps: WorkflowPlanStep[];
+  budget?: WorkflowPlanBudget | null;
+  toolWhitelist?: string[];
+}
+
+export interface WorkflowPreviewResult {
+  ok: boolean;
+  plan?: WorkflowPlan;
+  error?: string;
+}
+
+export interface WorkflowRunResult {
+  ok: boolean;
+  threadId?: string;
+  groupId?: string;
+  templateName?: string;
+  tasks?: number;
+  error?: string;
+  code?: string;
+}
+
+interface RawTask {
+  id?: string;
+  title?: string;
+  prompt?: string;
+  dependsOn?: string[];
+  critical?: boolean;
+}
+
+interface RunBaseArgs {
+  goal: string;
+  threadId?: string | number | null;
+  cwd?: string;
+  projectPath?: string;
+  projectPicked?: boolean;
+  selectedModel?: RunSessionArgs['selectedModel'];
+  onAutoProject?: RunSessionArgs['onAutoProject'];
+  onNewMessage?: () => void;
+  onThreadCreated?: RunSessionArgs['onThreadCreated'];
+  appendUserMessage?: ((goal: string) => void) | null;
+}
+
+function normalizeSteps(list: RawTask[] | undefined): WorkflowPlanStep[] {
+  return (Array.isArray(list) ? list : []).map((x, i) => ({
+    id: String(x?.id || `t${i + 1}`),
+    title: String(x?.title || x?.id || ''),
+    prompt: String(x?.prompt || ''),
+    dependsOn: Array.isArray(x?.dependsOn) ? x.dependsOn.map(String) : [],
+    critical: !!x?.critical,
+  }));
+}
+
+/** 分层归一：主进程返回的是「层 → id 数组」，缺省时按任务顺序兜底一层。 */
+function normalizeLevels(levels: unknown, steps: WorkflowPlanStep[]): string[][] {
+  if (Array.isArray(levels) && levels.length > 0) {
+    return levels.map((l) => (Array.isArray(l) ? l.map(String) : []));
+  }
+  return [steps.map((s) => s.id)];
+}
+
+export async function previewAutoPlan(args: {
+  goal: string;
+  cwd?: string;
+  threadId?: string | number | null;
+}): Promise<WorkflowPreviewResult> {
+  const goal = String(args.goal || '').trim();
+  if (!goal) return { ok: false, error: tGlobal('workflow.previewFailed') };
+  const threadId = args.threadId == null ? '' : String(args.threadId).trim();
+  try {
+    const r = (await window.mjcode?.tasksPlan?.({
+      goal,
+      cwd: args.cwd || '',
+      ...(threadId ? { conversationId: threadId } : {}),
+      dryRun: true,
+    })) as { ok?: boolean; tasks?: RawTask[]; levels?: unknown; error?: string } | undefined;
+    if (!r?.ok) return { ok: false, error: String(r?.error || tGlobal('workflow.previewFailed')) };
+    const steps = normalizeSteps(r.tasks);
+    if (steps.length === 0) return { ok: false, error: tGlobal('workflow.planEmpty') };
+    return {
+      ok: true,
+      plan: { mode: 'auto', goal, steps, levels: normalizeLevels(r.levels, steps), budget: null },
+    };
+  } catch (err) {
+    return { ok: false, error: String((err as Error)?.message || err) };
+  }
+}
+
+export async function previewTemplatePlan(args: {
+  templateId?: string | null;
+  goal: string;
+}): Promise<WorkflowPreviewResult> {
+  const templateId = String(args.templateId || '').trim();
+  if (!templateId) return { ok: false, error: tGlobal('workflow.templateRequired') };
+  try {
+    const r = (await window.mjcode?.workflowsPreview?.(templateId)) as
+      | {
+          ok?: boolean;
+          template?: { name?: string; budget?: WorkflowPlanBudget | null; toolWhitelist?: string[] };
+          levels?: unknown;
+          steps?: RawTask[];
+          error?: string;
+        }
+      | undefined;
+    if (!r?.ok) return { ok: false, error: String(r?.error || tGlobal('workflow.previewFailed')) };
+    const steps = normalizeSteps(r.steps);
+    if (steps.length === 0) return { ok: false, error: tGlobal('workflow.planEmpty') };
+    return {
+      ok: true,
+      plan: {
+        mode: 'template',
+        goal: String(args.goal || '').trim(),
+        templateId,
+        templateName: String(r.template?.name || ''),
+        steps,
+        levels: normalizeLevels(r.levels, steps),
+        budget: r.template?.budget || null,
+        toolWhitelist: Array.isArray(r.template?.toolWhitelist) ? r.template.toolWhitelist : [],
+      },
+    };
+  } catch (err) {
+    return { ok: false, error: String((err as Error)?.message || err) };
+  }
+}
+
+async function prepareSession(args: RunBaseArgs): Promise<RunSessionResult> {
+  const session = await ensureRunSession({
+    threadId: args.threadId,
+    cwd: args.cwd,
+    projectPath: args.projectPath,
+    projectPicked: args.projectPicked,
+    selectedModel: args.selectedModel,
+    goal: args.goal,
+    onAutoProject: args.onAutoProject,
+    onNewMessage: args.onNewMessage,
+    onThreadCreated: args.onThreadCreated,
+  });
+  if (!session.ok || !session.threadId) return session;
+  const persisted = await persistUserGoal(session.threadId, args.goal);
+  if (!persisted.ok) return { ok: false, error: persisted.error };
+  args.appendUserMessage?.(args.goal);
+  return session;
+}
+
+export async function startTemplateRun(args: RunBaseArgs & { templateId?: string | null }): Promise<WorkflowRunResult> {
+  const templateId = String(args.templateId || '').trim();
+  if (!templateId) return { ok: false, code: 'TEMPLATE_REQUIRED', error: tGlobal('workflow.templateRequired') };
+  const session = await prepareSession(args);
+  if (!session.ok || !session.threadId) return { ok: false, code: 'SESSION_FAILED', error: session.error };
+  try {
+    const r = (await window.mjcode?.workflowsRun?.({
+      templateId,
+      goal: args.goal,
+      threadId: session.threadId,
+      cwd: session.cwd || '',
+      projectPath: session.projectPath || '',
+    })) as
+      { ok?: boolean; groupId?: string; templateName?: string; tasks?: number; error?: string; code?: string } | undefined;
+    if (!r?.ok) {
+      return {
+        ok: false,
+        threadId: session.threadId,
+        code: r?.code,
+        error: String(r?.error || tGlobal('workflow.runFailed')),
+      };
+    }
+    return {
+      ok: true,
+      threadId: session.threadId,
+      groupId: r.groupId,
+      templateName: String(r.templateName || ''),
+      tasks: Number(r.tasks) || 0,
+    };
+  } catch (err) {
+    return { ok: false, threadId: session.threadId, error: String((err as Error)?.message || err) };
+  }
+}
+
+export async function startPresetPlanRun(args: RunBaseArgs & { steps: WorkflowPlanStep[] }): Promise<WorkflowRunResult> {
+  if (!Array.isArray(args.steps) || args.steps.length === 0) {
+    return { ok: false, code: 'EMPTY_PLAN', error: tGlobal('workflow.planEmpty') };
+  }
+  const session = await prepareSession(args);
+  if (!session.ok || !session.threadId) return { ok: false, code: 'SESSION_FAILED', error: session.error };
+  try {
+    const r = (await window.mjcode?.tasksPlan?.({
+      goal: args.goal,
+      cwd: session.cwd || '',
+      conversationId: session.threadId,
+      // 用预览过的那份清单建组：不再走第二次 LLM 拆解，保证「看到的步骤」= 「执行的步骤」
+      presetTasks: args.steps.map((s) => ({
+        id: s.id,
+        title: s.title,
+        prompt: s.prompt,
+        dependsOn: s.dependsOn,
+        critical: !!s.critical,
+      })),
+    })) as { ok?: boolean; groupId?: string; tasks?: unknown[]; error?: string } | undefined;
+    if (!r?.ok || !r.groupId) {
+      return { ok: false, threadId: session.threadId, code: 'PLAN_FAILED', error: String(r?.error || tGlobal('workflow.runFailed')) };
+    }
+    // 组已建好：后台执行，调用方立即拿回（进度走 tasks:event，与工作流运行同型）
+    Promise.resolve(window.mjcode?.tasksExecute?.(r.groupId)).catch((err: unknown) => {
+      console.warn('[workflow] preset plan run failed:', (err as Error)?.message || err);
+    });
+    return {
+      ok: true,
+      threadId: session.threadId,
+      groupId: r.groupId,
+      tasks: Array.isArray(r.tasks) ? r.tasks.length : args.steps.length,
+    };
+  } catch (err) {
+    return { ok: false, threadId: session.threadId, error: String((err as Error)?.message || err) };
+  }
+}
diff --git a/desktop/renderer/src/lib/runSession.ts b/desktop/renderer/src/lib/runSession.ts
