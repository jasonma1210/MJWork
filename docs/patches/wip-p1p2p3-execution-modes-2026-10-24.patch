+      setSaving(false);
+    }
+  }
+
+  async function runRuleTest() {
+    setSampleBusy(true);
+    setSampleResult(null);
+    try {
+      const decide = window.mjcode?.routerDecide;
+      if (!decide) throw new Error(t('settings.routerChannelMissing'));
+      const res = await decide({ text: sample, pageMode: 'chat' }) as DecideResult;
+      setSampleResult(res);
+      await loadAll();
+    } catch (e) {
+      setSampleResult({ ok: false, error: (e as Error).message || String(e) });
+    } finally {
+      setSampleBusy(false);
+    }
+  }
+
+  async function runRemoteTest() {
+    if (!cfg) return;
+    setRemoteBusy(true);
+    setRemoteResult(null);
+    try {
+      const test = window.mjcode?.routerRemoteTest;
+      if (!test) throw new Error(t('settings.routerChannelMissing'));
+      const res = await test({
+        providerId: cfg.remote.providerId,
+        modelId: cfg.remote.modelId,
+        baseUrl: cfg.remote.baseUrl,
+        timeoutMs: cfg.remote.timeoutMs,
+      }) as RemoteTestResult;
+      setRemoteResult(res);
+    } catch (e) {
+      setRemoteResult({ ok: false, error: (e as Error).message || String(e) });
+    } finally {
+      setRemoteBusy(false);
+    }
+  }
+
+  if (!cfg) {
+    return (
+      <Section title={t('settings.routerTitle')}>
+        <p className="py-4 text-sm text-text2">{error || t('settings.routerLoading')}</p>
+      </Section>
+    );
+  }
+
+  const sourceLabel = (source?: string) => (source && SOURCE_KEYS[source] ? t(SOURCE_KEYS[source]) : (source || '-'));
+
+  return (
+    <div>
+      {meta?.needsMigration && (
+        <div className="mb-6 rounded-2xl border border-warning/40 bg-warning/10 px-5 py-4">
+          <div className="text-sm font-medium">{t('settings.routerLegacyTitle')}</div>
+          <p className="mt-1 text-xs text-text2">
+            {t('settings.routerLegacyDesc', { path: meta.filePath })}
+          </p>
+        </div>
+      )}
+
+      {status && (
+        <p className="mb-4 text-xs text-text2">
+          {t('settings.routerStatusLine', {
+            path: status.enabled
+              ? t(status.path === 'remote' ? 'settings.routerPathRemote' : 'settings.routerPathRules')
+              : t('settings.routerStatusOff'),
+            remote: status.remoteConfigured ? t('settings.routerRemoteReady') : t('settings.routerRemoteNotReady'),
+            cache: status.cacheEntries,
+            logs: status.recentCount,
+          })}
+        </p>
+      )}
+
+      <Section title={t('settings.routerBasicTitle')}>
+        <div className="flex items-center justify-between gap-4 py-4 border-b border-border">
+          <div className="min-w-0">
+            <div className="text-sm font-medium">{t('settings.routerEnabled')}</div>
+            <div className="text-xs text-text2 mt-1">{t('settings.routerEnabledDesc')}</div>
+          </div>
+          <Toggle
+            on={cfg.enabled}
+            label={t('settings.routerEnabled')}
+            onChange={() => { setCfg({ ...cfg, enabled: !cfg.enabled }); setFlash(''); }}
+          />
+        </div>
+
+        <div className="py-4 border-b border-border">
+          <div className="text-sm font-medium mb-2">{t('settings.routerPath')}</div>
+          <select
+            value={cfg.path}
+            onChange={(e) => { setCfg({ ...cfg, path: e.target.value as 'rules' | 'remote' }); setFlash(''); }}
+            className="w-full bg-input border border-border rounded-lg px-3 py-2 text-sm outline-none focus:border-accent"
+          >
+            <option value="rules">{t('settings.routerPathRules')}</option>
+            <option value="remote">{t('settings.routerPathRemote')}</option>
+          </select>
+          <p className="mt-2 text-xs text-text2">
+            {cfg.path === 'remote' ? t('settings.routerPathRemoteDesc') : t('settings.routerPathRulesDesc')}
+          </p>
+        </div>
+
+        {cfg.path === 'remote' && (
+          <>
+            <div className="py-4 border-b border-border">
