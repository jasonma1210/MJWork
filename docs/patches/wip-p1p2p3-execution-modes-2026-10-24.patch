+
+export type EngineMode = 'chat' | 'template' | 'auto' | 'team';
+
+export declare const ENGINE_MODES: readonly EngineMode[];
+
+export declare const DEFAULT_ENGINE_MODE: EngineMode;
+
+export declare const ENGINE_MODE_I18N_PREFIX: string;
+
+export declare function isEngineMode(v: unknown): boolean;
+
+export declare function normalizeEngineMode(v: unknown): EngineMode;
+
+export declare function assertEngineMode(v: unknown): EngineMode;
+
+export declare function createsGroup(mode: unknown): boolean;
