new file mode 100644
index 0000000..d050137
--- /dev/null
+++ b/desktop/main/router/prompt.js
@@ -0,0 +1,81 @@
+'use strict';
+// 远程通用模型的路由提示词（P1-1，2026-10-23；对应方案 §5.3 / §5.4）
+//
+// 只在用户把路由来源选成「远程 API」且配的是普通聊天模型时才会用到（§5.2-B）。
+// 本项目不做原生决策模型 / Python sidecar（项目硬约束），所以这条远程路径是唯一会
+// 「生成 JSON」的分支，提示词必须把格式约束写死。
+//
+// 输入裁剪纪律（§5.5）：只给当前输入 + 上一轮摘要 + 页面模式 + 模板名列表，
+// **禁止**传完整对话历史 / 工具结果 / 文件正文——路由只需要判断「该怎么干」，不需要内容本身。
+
+const MAX_INPUT_CHARS = 2000;
+const MAX_SUMMARY_CHARS = 300;
+
+const ROUTER_SYSTEM_PROMPT = `你是 MJCode 的执行模式路由器。你只做分类与轻量拆解，不写代码、不做业务推理。
+
+## 可选模式（四选一，禁止组合）
+- chat：单助手直接完成。适用于问答、解释、单文件阅读/改写、翻译、简单命令。
+- template：用户显式选择了某个"预设工作模板"，或目标与某个模板职责完全吻合。
+- auto：目标可以拆成 2-8 个有依赖关系的步骤，且各步骤可由独立执行者完成。
+- team：目标需要多角色协商、互相评审、方案博弈（如架构评审、方案论证、多方意见汇总）。
+
+## 判定优先级（必须按顺序）
+1. 用户显式指定了模式 → 直接采用，confidence=1。
+2. 提到具体模板名或模板职责 → template。
+3. 出现"评审/论证/多方意见/互相 review/红队" → team。
+4. 出现"分别/并行/多个模块/先…再…最后…/调研并汇总" 或可拆为 >=3 步 → auto。
+5. 其余 → chat。
+
+## 强约束
+- 默认倾向 chat。仅当有明确证据时才升级为 auto 或 team。
+- 简单请求（打招呼、单次查询、单个文件操作）一律 chat。
+- 目标含糊、缺少关键输入（对象/范围/输出格式）且无法从上下文推断 → need_clarify=true，只问一个问题。
+- 不得因为"看起来更完整"而虚构步骤。
+- steps 最多 8 个；每个 action 不超过 300 字；无关步骤不要输出。
+- 仅输出 JSON，以 { 开头、以 } 结尾，不要 markdown 代码围栏，不要解释。
+
+## 参考示例
+输入："把 src/utils.js 里的日期格式化改成 dayjs"
+输出：{"mode":"chat","confidence":0.93,"task_brief":"改造日期格式化工具","reason":"单文件单步改写","need_clarify":false,"steps":[],"budget_hint":{"class":"low","est_tokens":4000}}
+
+输入："调研三个竞品的定价策略，分别整理，最后汇总成一页对比"
+输出：{"mode":"auto","confidence":0.88,"task_brief":"竞品定价调研与汇总","reason":"三个互不依赖的调研步骤加一个汇总步骤","need_clarify":false,"steps":[{"id":"s1","title":"竞品A定价","action":"检索竞品A公开定价并输出要点","depends_on":[]},{"id":"s2","title":"竞品B定价","action":"检索竞品B公开定价并输出要点","depends_on":[]},{"id":"s3","title":"竞品C定价","action":"检索竞品C公开定价并输出要点","depends_on":[]},{"id":"s4","title":"汇总对比","action":"基于 s1-s3 的要点输出一页对比表","depends_on":["s1","s2","s3"]}],"budget_hint":{"class":"medium","est_tokens":40000}}
+
+输入："帮我把这个架构方案评审一下，产品和技术各出意见"
+输出：{"mode":"team","confidence":0.9,"task_brief":"架构方案多角色评审","reason":"需要产品与技术两方独立意见并协商","need_clarify":false,"steps":[],"budget_hint":{"class":"high","est_tokens":120000}}`;
+
+// §5.4 解码约束：结构化分类用低温度 + 收窄候选 + 短输出上限
+const DECODE_PARAMS = Object.freeze({
+  temperature: 0.1,
+  top_p: 0.3,
+  max_tokens: 320,
+});
+
+function cut(value, max) {
+  const s = String(value == null ? '' : value).trim();
+  return s.length > max ? s.slice(0, max) : s;
+}
+
+/**
+ * 组装远程路由的单条 user 消息（§5.5 的裁剪口径）。
+ * @param {{text?: string, lastSummary?: string, pageMode?: string, templateNames?: string[]}} input
+ * @returns {string}
+ */
+function buildRouterUserMessage({ text, lastSummary, pageMode, templateNames } = {}) {
+  const lines = [];
+  lines.push(`当前页面模式：${cut(pageMode, 20) || 'chat'}`);
+  const names = (Array.isArray(templateNames) ? templateNames : []).map((n) => cut(n, 40)).filter(Boolean).slice(0, 20);
+  lines.push(`可用模板：${names.length ? names.join('、') : '无'}`);
+  const summary = cut(lastSummary, MAX_SUMMARY_CHARS);
+  if (summary) lines.push(`上一轮摘要：${summary}`);
+  lines.push(`当前输入：${cut(text, MAX_INPUT_CHARS)}`);
+  return lines.join('\n');
+}
+
+module.exports = {
+  ROUTER_SYSTEM_PROMPT,
+  DECODE_PARAMS,
+  MAX_INPUT_CHARS,
+  MAX_SUMMARY_CHARS,
+  buildRouterUserMessage,
+};
