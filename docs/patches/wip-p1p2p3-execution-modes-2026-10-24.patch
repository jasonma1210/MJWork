new file mode 100644
index 0000000..07d80a9
--- /dev/null
+++ b/desktop/shared/engineMode.mjs
@@ -0,0 +1,72 @@
+// DS Bots / 执行模式分层（2026-10-22）：四种执行模式的**单一事实来源**。
+//
+// 双端同源：主进程（CJS，require 本文件——Electron 45 / Node 22 已原生支持 require(ESM)，
+// 且本模块无顶层 await）与 agent-core（ESM import）共用同一份判定，避免「渲染层按 chat 裁工具、
+// 引擎却按 auto 放行」这类两端漂移。
+// 判定口径（设计稿 §11 权限矩阵）：
+//   chat     直接回答：不建组、不编排、不调团队工具
+//   template 按模板：建组（固定 DAG），**不**允许编排原语（运行期模型不得再拆，否则模板失去可预期性），不调团队工具
+//   auto     自动拆解：建组，允许编排原语（一次），不调团队工具
+//   team     团队协作：建组，**禁止** orchestrate_task（拆解由主管统一承担），允许 team_* 协同工具
+//
+// 注意：这里只描述「模式语义」；具体工具名的差集在 agent-core/toolTiers.js（工具清单的
+// 唯一事实来源），本模块不重复列出工具名——两处各存一份迟早漂移。
+
+export const ENGINE_MODES = Object.freeze(['chat', 'template', 'auto', 'team']);
+
+// 缺省档：历史组迁移后一律读作 auto（设计稿 §12 P0-2 明确要求）。
+// 交互式会话未显式下发模式时也取 auto——与改造前的既有能力（对话内可自动拆解）逐字节一致。
+export const DEFAULT_ENGINE_MODE = 'auto';
+
+// 展示口径只存 i18n key，不存文案：渲染时经 t() 求值，切语言即时生效。
+export const ENGINE_MODE_I18N_PREFIX = 'engineMode';
+
+const MODE_SET = new Set(ENGINE_MODES);
+
+/** 是否合法模式（不做归一化） */
+export function isEngineMode(v) {
+  return MODE_SET.has(String(v));
+}
+
+/**
+ * 归一化：合法值原样返回；缺省（undefined/null/空串）或非法值回落 auto。
+ * 用于**读路径**（历史组、IPC 可选字段）——读路径不该因为一个坏值把整轮打断。
+ */
+export function normalizeEngineMode(v) {
+  const s = String(v == null ? '' : v).trim();
+  return MODE_SET.has(s) ? s : DEFAULT_ENGINE_MODE;
+}
+
+/**
+ * 校验：非法值直接抛错。用于**写路径**（createGroup 显式入参）——
+ * 静默回落会让「按模板」被当成「自动拆解」跑掉，用户拿到的产物与预期不符且无任何提示。
+ * 缺省（undefined/null/空串）返回 DEFAULT_ENGINE_MODE，不抛错。
+ */
+export function assertEngineMode(v) {
+  const s = String(v == null ? '' : v).trim();
+  if (!s) return DEFAULT_ENGINE_MODE;
+  if (!MODE_SET.has(s)) {
+    throw new Error(`非法执行模式：${s}（允许：${ENGINE_MODES.join(' / ')}）`);
+  }
+  return s;
+}
+
+/** 该模式是否建任务组（chat 是纯对话，不落组） */
+export function createsGroup(mode) {
+  return normalizeEngineMode(mode) !== 'chat';
+}
+
+/** 该模式是否允许编排原语（orchestrate_task）：仅 auto（template 的 DAG 来自模板，运行期不得再拆） */
+export function allowsOrchestration(mode) {
+  return normalizeEngineMode(mode) === 'auto';
+}
+
+/** 该模式是否允许团队协同工具（team_* 五件套）：仅 team */
+export function allowsTeamTools(mode) {
+  return normalizeEngineMode(mode) === 'team';
+}
+
+/** 模式徽标的 i18n key（未知值先归一化，绝不渲染裸 mode 字符串） */
+export function engineModeLabelKey(mode) {
+  return `${ENGINE_MODE_I18N_PREFIX}.${normalizeEngineMode(mode)}`;
+}
