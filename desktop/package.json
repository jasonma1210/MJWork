{
  "name": "mj-code-desktop",
  "version": "0.8.12-beta",
  "description": "MJ Nexus - local-first AI agent desktop workspace",
  "main": "main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:vite": "cd renderer && npm run dev",
    "build": "npm run build --prefix renderer && npm run bundle:ocr && electron-builder",
    "dist:dir": "npm run build --prefix renderer && npm run bundle:ocr && electron-builder --dir",
    "dist:mac": "npm run build --prefix renderer && npm run bundle:ocr && electron-builder --mac",
    "dist:win": "npm run build --prefix renderer && electron-builder --win",
    "dist:linux": "npm run build --prefix renderer && electron-builder --linux",
    "start": "electron .",
    "test": "node test/run-all.mjs",
    "test:sandbox:linux": "node -e \"if (process.platform !== 'linux') { console.error('Linux 沙箱真机验证必须在 Linux runner 执行，当前平台=' + process.platform); process.exit(2); }\" && node test/sandbox-crossplatform.test.js",
    "test:sandbox:macos": "node -e \"if (process.platform !== 'darwin') { console.error('macOS Seatbelt 真机验证必须在 macOS runner 执行，当前平台=' + process.platform); process.exit(2); }\" && MJCODE_REQUIRE_REAL_SANDBOX=1 node test/sandbox.test.js",
    "eval:check": "node eval/run-eval.mjs --check",
    "eval": "node eval/run-eval.mjs",
    "eval:hard": "node eval/run-eval.mjs --tasks eval/tasks-hard.json",
    "eval:compare": "node eval/run-compare.mjs",
    "eval:compare:hard": "node eval/run-compare.mjs --tasks eval/tasks-hard.json",
    "lint": "eslint main/ agent-core/ renderer/src/ chrome-extension/ --max-warnings=0",
    "lint:strict": "eslint main/ agent-core/ renderer/src/ chrome-extension/ --max-warnings=0",
    "format": "prettier --write \"main/**/*.js\" \"agent-core/**/*.js\" \"renderer/src/**/*.{js,jsx}\"",
    "format:check": "prettier --check \"main/**/*.js\" \"agent-core/**/*.js\" \"renderer/src/**/*.{js,jsx}\"",
    "typecheck": "npm run typecheck --prefix renderer",
    "setup:ocr": "node scripts/install-ocr.mjs",
    "bundle:ocr": "node scripts/bundle-ocr.mjs --force"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "electron": "45.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.6.2",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.mjcoder.desktop",
    "productName": "MJ Nexus",
    "publish": {
      "provider": "github",
      "owner": "jasonma1210",
      "repo": "MJWork",
      "releaseType": "release",
      "channel": "latest"
    },
    "generateUpdatesFilesForAllChannels": true,
    "files": [
      "main/**/*",
      "agent-core/**/*",
      "shared/**/*",
      "shared-ipc/**/*",
      "renderer/dist/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.d.mts",
      "!**/*.d.cts",
      "!**/*.md",
      "!**/LICENSE*",
      "!**/CHANGELOG*",
      "!**/AUTHORS*",
      "!**/NOTICE*",
      "!**/{test,tests,__tests__,examples,example,benchmark,coverage}/**",
      "!**/.playwright-mcp/**",
      "!**/node_modules/zod/src/**",
      "!**/node_modules/sql.js/dist/sql-asm*",
      "!**/node_modules/sql.js/dist/sql-wasm-debug*",
      "!**/node_modules/sql.js/dist/sql-wasm-inline*",
      "!**/node_modules/sql.js/dist/sql-wasm-browser*",
      "!**/node_modules/sql.js/dist/worker.*",
      "!**/node_modules/sql.js/dist/*.zip"
    ],
    "asarUnpack": [
      "**/node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "protocols": [
      {
        "name": "MJ Nexus IM OAuth",
        "schemes": [
          "mjcode"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "renderer/src/assets/logo.png",
      "artifactName": "MJNexus-${version}-${os}-${arch}.${ext}",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "build/ocr",
          "to": "ocr"
        }
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "renderer/src/assets/logo.png",
      "artifactName": "MJNexus-${version}-${os}-${arch}.${ext}",
      "verifyUpdateCodeSignature": false
    },
    "linux": {
      "target": "AppImage",
      "icon": "renderer/src/assets/logo.png",
      "artifactName": "MJNexus-${version}-${os}-${arch}.${ext}"
    },
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "../ecosystem",
        "to": "ecosystem"
      }
    ],
    "npmRebuild": false
  },
  "dependencies": {
    "docx": "^9.12.0",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "playwright-core": "^1.64.1",
    "pptxgenjs": "^4.0.1",
    "sql.js": "^1.13.0",
    "ws": "^8.22.0",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "author": {
    "name": "jasonma1210",
    "email": "jasonma1210@users.noreply.github.com"
  },
  "optionalDependencies": {
    "better-sqlite3": "11.10.0"
  }
}
